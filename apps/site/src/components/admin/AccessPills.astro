---
import Pill from './Pill.astro';
import type { PillTone } from './tones';
import { accessOf, shownRole, type Access } from '../../lib/auth/roles';
import type { PrincipalRole } from '../../lib/supabase/types';

// What a login can do, as pills. The one place a role becomes a label and a
// colour, so moving from one role to a set of privileges changes accessOf and
// this map, not every page that shows somebody's access. The viewer is
// required so a superuser is never shown to somebody who isn't one
// (shownRole).

interface Props {
  role: PrincipalRole;
  /** The role of whoever is looking at the page. */
  viewer: PrincipalRole;
  opensEmergencyContacts?: boolean;
}

const { role, viewer, opensEmergencyContacts = false } = Astro.props;

const tones: Record<Access, PillTone> = {
  registrar: 'amber',
  admin: 'blue',
  superuser: 'purple',
  emergency: 'red',
};
---

{accessOf(shownRole(role, viewer), opensEmergencyContacts).map((access) => <Pill tone={tones[access]}>{access.charAt(0).toUpperCase() + access.slice(1)}</Pill>)}
