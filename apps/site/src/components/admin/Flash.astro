---
// What the last form did, or why it didn't.

interface Props {
  error?: string | null;
  success?: string | null;
}

const { error, success } = Astro.props;
---

{error && (
  <div role="alert" class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded-md text-sm">{error}</div>
)}
{success && (
  <div role="status" class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded-md text-sm">{success}</div>
)}
