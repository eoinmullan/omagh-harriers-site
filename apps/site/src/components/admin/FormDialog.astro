---
// A form in a native <dialog>, a sheet from the bottom on a phone, opened by any button with
// data-open-dialog={id}. showModal gives focus trapping, Escape and the
// backdrop for free. A form that came back with a problem opens again on load
// with the reason, keeping what was typed. The page's own fields, hidden
// action input included, go in the slot.

interface Props {
  id: string;
  title: string;
  submitLabel: string;
  error?: string | null;
  /** True when this dialog's form is the one that came back with the error. */
  reopen?: boolean;
  danger?: boolean;
  wide?: boolean;
}

const { id, title, submitLabel, error, reopen = false, danger = false, wide = false } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  data-open-on-load={reopen && error ? '' : undefined}
  class:list={['sheet m-auto w-[calc(100%-2rem)] rounded-lg p-0 shadow-xl backdrop:bg-black/40', wide ? 'max-w-xl' : 'max-w-md']}
>
  <form method="POST" class="px-5 pt-4 pb-5 sm:p-6 space-y-4">
    <h2 id={`${id}-title`} class="text-lg font-semibold">{title}</h2>
    {reopen && error && (
      <p role="alert" class="p-3 bg-red-50 border border-red-200 text-red-700 rounded-md text-sm">{error}</p>
    )}
    <slot />
    <div class="sheet-actions flex justify-end gap-3 pt-2">
      <button type="button" data-close-dialog class="btn btn-secondary">Cancel</button>
      <button type="submit" class:list={['btn', danger ? 'btn-danger' : 'btn-primary']}>{submitLabel}</button>
    </div>
  </form>
</dialog>
