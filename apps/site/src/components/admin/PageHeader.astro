---
// The top of every admin list page: what this is, how many, and the one
// thing you'd most likely do here. On a desktop that's a button top right; on
// a phone it floats above the tab bar, in reach of a thumb.

interface Props {
  title: string;
  subtitle?: string;
  /** The page's one primary action: opens the dialog with this id. */
  primary?: { label: string; dialog: string };
}

const { title, subtitle, primary } = Astro.props;
---

<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3 mb-4 sm:mb-6">
  <div class="min-w-0">
    <h1 class="text-2xl sm:text-3xl font-bold">{title}</h1>
    {subtitle && <p class="text-sm sm:text-base text-gray-500 mt-1">{subtitle}</p>}
    <slot name="description" />
  </div>
  {(Astro.slots.has('actions') || primary) && (
    <div class="flex flex-wrap items-center gap-6">
      <slot name="actions" />
      {primary && (
        <button type="button" data-open-dialog={primary.dialog} class="hidden sm:inline-flex btn btn-primary">{primary.label}</button>
      )}
    </div>
  )}
</div>

{primary && (
  <button
    type="button"
    data-open-dialog={primary.dialog}
    class="sm:hidden fixed right-4 z-30 bottom-[calc(4.75rem+env(safe-area-inset-bottom))] inline-flex items-center gap-2 rounded-full bg-amber text-black font-semibold pl-4 pr-5 min-h-12 shadow-lg shadow-black/20 active:bg-yellow"
  >
    <span aria-hidden="true" class="text-2xl leading-none">+</span>
    {primary.label}
  </button>
)}
