---
import SegmentedNav from './SegmentedNav.astro';

// Moving between the two reports. One session's figures are on its own page
// under Sessions, and a day's are grouped there too, so neither is a report.

interface Props {
  current: 'attendance' | 'money';
}

const { current } = Astro.props;
---

<SegmentedNav
  label="Reports"
  items={[
    { label: 'Attendance by week', href: '/admin/reports/attendance', current: current === 'attendance' },
    { label: 'Money', href: '/admin/reports/money', current: current === 'money' },
  ]}
/>
