---
// Switching between views of one list (Upcoming / Past, Running / Retired) or
// between reports. Each option is a link, so a view is a URL.

interface Props {
  label: string;
  items: { label: string; href: string; current: boolean; count?: number }[];
}

const { label, items } = Astro.props;
---

<nav aria-label={label} class="inline-flex rounded-lg border border-gray-300 bg-white p-0.5 mb-4 text-sm">
  {items.map((item) => (
    <a
      href={item.href}
      aria-current={item.current ? 'page' : undefined}
      class:list={[
        'rounded-md px-3 py-1.5',
        item.current ? 'bg-gray-900 text-white font-medium' : 'text-gray-600 hover:text-gray-900',
      ]}
    >
      {item.label}
      {item.count !== undefined && (
        <span class:list={['ml-1 tabular-nums', item.current ? 'text-gray-300' : 'text-gray-400']}>{item.count}</span>
      )}
    </a>
  ))}
</nav>
