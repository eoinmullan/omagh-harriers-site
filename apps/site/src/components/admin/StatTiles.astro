---
// A row of headline figures at the top of a list page.

interface Props {
  columns?: 2 | 3 | 4;
}

const { columns = 3 } = Astro.props;

const grid = {
  2: 'grid-cols-2',
  3: 'grid-cols-3',
  4: 'grid-cols-2 sm:grid-cols-4',
}[columns];
---

<div class:list={['grid gap-2 sm:gap-3 mb-4 sm:mb-6', grid]}>
  <slot />
</div>
