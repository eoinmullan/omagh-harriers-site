---
// PROTOTYPE A — the chosen shape. One list, ordered by surname, filtered to the
// Usuals. Nothing here has an undo button: the checkbox and the cash cell each
// show their own state and are reversed by using them again.
---

<script is:inline>
  (function () {
    const root = document.getElementById('variant-root');
    if (!root || !window.proto) return;

    const { model, formatBalance, formatPounds, balanceFor, isIn, cashFor } = window.proto;

    let tab = 'usuals';
    let filter = null;
    let search = '';
    let sheetFor = null;
    let keypadFor = null;
    let keypadTitle = '';
    let keypadPence = 0;

    const QUICK_AMOUNTS = [200, 500, 1000, 2000];

    function cashLabel(pence) {
      return pence % 100 === 0 ? `£${pence / 100}` : formatPounds(pence);
    }

    // The line under a name says one thing and says it the same way every
    // time: what the household's pot holds right now. The tick takes £2 off
    // it, the cash cell puts money on, so both controls are legible here
    // without this line ever having to narrate them. Colour carries the
    // warning so the words never have to change.
    function balanceNote(person) {
      const balance = balanceFor(person);
      const tone =
        balance < 0
          ? 'text-red-400'
          : balance < model.session.pricePence
            ? 'text-amber'
            : 'text-neutral-400';
      return { text: `${formatBalance(balance)} · ${person.householdName}`, tone };
    }

    function householdOf(person) {
      return window.proto.peopleByHousehold(person.principalId);
    }

    function checkbox(checked) {
      return `
        <span class="w-9 h-9 rounded-lg border-2 flex items-center justify-center text-xl font-black ${
          checked ? 'bg-amber border-amber text-black' : 'border-neutral-600 text-transparent'
        }">✓</span>`;
    }

    function cashCell(pence, { dataset }) {
      return `
        <button ${dataset} class="w-[72px] shrink-0 border-l border-neutral-800 flex flex-col items-center justify-center leading-none active:bg-neutral-800 ${
          pence ? 'bg-amber/10' : ''
        }">
          ${
            pence
              ? `<span class="text-amber font-bold text-base">${cashLabel(pence)}</span>
                 <span class="block mt-1 text-[10px] uppercase tracking-wider text-neutral-500">added</span>`
              : '<span class="text-neutral-600 text-sm">+&nbsp;£</span>'
          }
        </button>`;
    }

    function personRow(person) {
      const here = isIn(person);
      const note = balanceNote(person);
      const paid = cashFor(person);
      return `
        <li class="flex items-stretch border-b border-neutral-800 ${here ? 'bg-emerald-950/60' : ''}">
          <button data-toggle="${person.id}" class="flex-1 min-w-0 text-left px-4 py-3 min-h-[76px] flex items-center gap-3 active:bg-neutral-800">
            ${checkbox(here)}
            <span class="min-w-0">
              <span class="block text-lg leading-tight truncate">
                <span class="font-bold uppercase tracking-wide">${person.surname}</span>,
                <span class="font-normal">${person.firstName}</span>
              </span>
              <span class="block text-sm truncate ${note.tone}">${note.text}</span>
            </span>
          </button>
          ${cashCell(paid, { dataset: `data-cash="${person.id}"` })}
        </li>`;
    }

    function guestRow(guest) {
      const entry = window.proto.guestEntry(guest);
      return `
        <li class="flex items-stretch border-b border-neutral-800 ${entry ? 'bg-emerald-950/60' : ''}">
          <button data-guest-toggle="${guest.id}" class="flex-1 min-w-0 text-left px-4 py-3 min-h-[76px] flex items-center gap-3 active:bg-neutral-800">
            ${checkbox(Boolean(entry))}
            <span class="min-w-0">
              <span class="block text-lg leading-tight truncate">
                <span class="font-bold uppercase tracking-wide">${guest.surname}</span>,
                <span class="font-normal">${guest.firstName}</span>
              </span>
              <span class="block text-sm truncate text-neutral-400">Guest — holds no credit</span>
            </span>
          </button>
          <div class="w-[72px] shrink-0 border-l border-neutral-800 flex flex-col items-center justify-center leading-none ${
            entry ? 'bg-amber/10' : ''
          }">
            ${
              entry
                ? `<span class="text-amber font-bold text-base">${cashLabel(entry.pence)}</span>
                   <span class="block mt-1 text-[10px] uppercase tracking-wider text-neutral-500">paid</span>`
                : ''
            }
          </div>
        </li>`;
    }

    function sheet(person, paid, isGuest) {
      const title = isGuest
        ? `${person.firstName} ${person.surname}`
        : `${person.householdName} household`;
      const who = isGuest
        ? 'Guest — pays on the night'
        : householdOf(person)
            .map((member) => member.firstName)
            .join(', ');
      return `
        <div class="fixed inset-0 z-40 flex items-end bg-black/70" data-backdrop>
          <div class="w-full max-w-[420px] mx-auto bg-neutral-900 rounded-t-2xl p-4 pb-8 border-t border-neutral-700">
            <p class="text-center text-neutral-400 text-sm">${paid ? 'Added tonight' : 'Cash from'}</p>
            <p class="text-center text-xl font-bold">${title}</p>
            <p class="text-center text-neutral-500 text-sm mb-1">${who}</p>
            ${
              paid
                ? `<p class="text-center text-amber text-3xl font-bold mb-4">${formatPounds(paid)}</p>`
                : '<p class="text-center text-neutral-500 text-sm mb-4">nothing yet</p>'
            }
            ${
              paid
                ? '<p class="text-center text-xs uppercase tracking-widest text-neutral-500 mb-2">change it to</p>'
                : ''
            }
            <div class="grid grid-cols-2 gap-3">
              ${QUICK_AMOUNTS.map(
                (pence) =>
                  `<button data-amount="${pence}" class="bg-amber text-black text-2xl font-bold rounded-xl py-5">${formatPounds(pence)}</button>`,
              ).join('')}
            </div>
            <button data-other class="w-full mt-3 py-5 rounded-xl border-2 border-amber text-amber text-lg font-bold">Other amount…</button>
            ${
              paid
                ? '<button data-clear class="w-full mt-3 py-5 rounded-xl border-2 border-red-500 text-red-400 text-lg font-semibold">Take it back — nothing handed over</button>'
                : ''
            }
            <button data-close class="w-full mt-3 py-4 text-neutral-400 text-lg">Cancel</button>
          </div>
        </div>`;
    }

    function keypad() {
      const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', 'clear', '0', 'back'];
      return `
        <div class="fixed inset-0 z-50 bg-black flex flex-col max-w-[420px] mx-auto">
          <div class="p-5 text-center border-b border-neutral-800">
            <p class="text-neutral-400 text-sm">${keypadTitle}</p>
            <p class="text-5xl font-bold text-amber mt-2">${formatPounds(keypadPence)}</p>
          </div>
          <div class="grid grid-cols-3 gap-px bg-neutral-800 flex-1">
            ${keys
              .map(
                (key) =>
                  `<button data-key="${key}" class="bg-black text-3xl font-semibold active:bg-neutral-800 ${
                    key === 'clear' || key === 'back' ? 'text-neutral-400 text-xl' : ''
                  }">${key === 'back' ? '⌫' : key === 'clear' ? 'clear' : key}</button>`,
              )
              .join('')}
          </div>
          <div class="p-3 grid grid-cols-2 gap-3">
            <button data-key-cancel class="py-5 rounded-xl border-2 border-neutral-700 text-neutral-300 text-lg">Cancel</button>
            <button data-key-confirm class="py-5 rounded-xl bg-amber text-black text-lg font-bold disabled:opacity-40" ${
              keypadPence ? '' : 'disabled'
            }>Take ${formatPounds(keypadPence)}</button>
          </div>
        </div>`;
    }

    // Both figures are also the way to see what is behind them. The number and
    // the names it counts are one control, so there is nothing to go looking
    // for when the tin does not match.
    function tile(key, figure, label, activeLabel) {
      const on = filter === key;
      return `
        <button data-filter="${key}" class="flex-1 py-2 ${on ? 'bg-amber text-black' : ''}">
          <p class="text-2xl font-bold ${on ? '' : key === 'paid' ? 'text-amber' : ''}">${figure}</p>
          <p class="text-[11px] uppercase tracking-wider ${on ? 'text-black/70' : 'text-neutral-500'}">
            ${on ? activeLabel : `${label} ▾`}
          </p>
        </button>`;
    }

    function searchBox() {
      return `
        <div class="px-2 pb-2">
          <input id="a-search" type="search" autocomplete="off" enterkeyhint="search"
            value="${search}" placeholder="Type any part of a name"
            class="w-full bg-neutral-900 rounded-xl px-4 py-4 text-lg outline-none focus:ring-2 focus:ring-amber placeholder-neutral-600" />
        </div>`;
    }

    function matchesFilter(person) {
      if (filter === 'here') return isIn(person);
      if (filter === 'paid') return cashFor(person) > 0;
      return true;
    }

    function normalise(value) {
      return value.toLowerCase().replace(/[\s'’`-]/g, '');
    }

    function matchesSearch(person) {
      const term = normalise(search);
      if (!term) return true;
      return (
        normalise(person.surname).includes(term) ||
        normalise(person.firstName).includes(term)
      );
    }

    // A filter answers for the whole night, not just for the list that happens
    // to be open — somebody found through All and signed in still belongs in
    // "who is here", or the number in the header would be describing a list
    // the registrar cannot see.
    function visiblePeople() {
      if (tab === 'all') {
        return model.everyone.filter(filter ? matchesFilter : matchesSearch).sort(bySurname);
      }
      const base = model.expected;
      if (!filter) return base;
      const extras = model.everyone.filter(
        (person) => matchesFilter(person) && !base.some((p) => p.id === person.id),
      );
      return [...base, ...extras].filter(matchesFilter).sort(bySurname);
    }

    function bySurname(a, b) {
      return a.surname.localeCompare(b.surname) || a.firstName.localeCompare(b.firstName);
    }

    function visibleGuests() {
      if (!filter) return model.guests;
      if (filter === 'here') return model.guests.filter(window.proto.guestEntry);
      return model.guests.filter((guest) => (window.proto.guestEntry(guest)?.pence ?? 0) > 0);
    }

    function render() {
      const people = visiblePeople();
      const list =
        tab === 'guests'
          ? visibleGuests().map(guestRow).join('')
          : people.map(personRow).join('');

      const tabs = [
        ['usuals', `Usuals ${model.expected.length}`],
        ['all', `All ${model.everyone.length}`],
        ['guests', `Guests ${model.guests.length}`],
      ];

      root.innerHTML = `
        <header class="sticky top-0 z-20 bg-black border-b border-neutral-800">
          <div class="flex items-baseline justify-between px-4 pt-3 pb-2">
            <h1 class="text-xl font-bold">${model.session.name}</h1>
            <p class="text-neutral-400 text-sm">${model.session.startsAt}</p>
          </div>
          <div class="flex divide-x divide-neutral-800 border-y border-neutral-800 text-center">
            ${tile('here', window.proto.headcount(), 'here', 'showing who is here')}
            ${tile('paid', formatPounds(window.proto.cashTotalPence()), 'money collected', 'showing who paid')}
          </div>
          <div class="flex gap-1 p-2 border-t border-neutral-800">
            ${tabs
              .map(
                ([key, label]) =>
                  `<button data-tab="${key}" class="flex-1 py-3 rounded-lg text-sm font-semibold ${
                    tab === key ? 'bg-neutral-100 text-black' : 'bg-neutral-900 text-neutral-300'
                  }">${label}</button>`,
              )
              .join('')}
          </div>
          ${tab === 'all' && !filter ? searchBox() : ''}
        </header>

        ${
          list === ''
            ? `<p class="px-4 py-10 text-center text-neutral-500">${emptyMessage()}</p>`
            : `<ul class="flex-1">${list}</ul>`
        }
        ${sheetFor ? sheet(sheetFor.who, sheetFor.paid, sheetFor.isGuest) : ''}
        ${keypadFor ? keypad() : ''}
      `;
      wire();
    }

    // 313 names is not a list, it is a scroll. The full tab asks for a letter
    // or a few characters before it shows anything, so what comes back is
    // always short enough to read standing up.
    function emptyMessage() {
      if (filter === 'paid') return 'Nobody has handed anything over yet.';
      if (filter === 'here') return 'Nobody is here yet.';
      if (tab === 'all') return `Nobody matching “${search.trim()}”.`;
      return 'Nobody is here yet.';
    }

    function findPerson(id) {
      return model.everyone.find((person) => person.id === id);
    }

    function findGuest(id) {
      return model.guests.find((guest) => guest.id === id);
    }

    function applyAmount(pence) {
      if (sheetFor?.isGuest) window.proto.setGuestCash(sheetFor.who, pence);
      else window.proto.setCash(sheetFor.who, pence);
      sheetFor = null;
      keypadFor = null;
      render();
    }

    function wire() {
      root.querySelectorAll('[data-tab]').forEach((button) =>
        button.addEventListener('click', () => {
          tab = button.dataset.tab;
          search = '';
          render();
        }),
      );
      root.querySelectorAll('[data-filter]').forEach((button) =>
        button.addEventListener('click', () => {
          filter = filter === button.dataset.filter ? null : button.dataset.filter;
          render();
        }),
      );
      root.querySelectorAll('[data-toggle]').forEach((button) =>
        button.addEventListener('click', () => {
          const person = findPerson(button.dataset.toggle);
          window.proto.setAttendance(person, !isIn(person));
        }),
      );
      root.querySelectorAll('[data-guest-toggle]').forEach((button) =>
        button.addEventListener('click', () => {
          const guest = findGuest(button.dataset.guestToggle);
          window.proto.setGuestAttendance(guest, !window.proto.guestEntry(guest));
        }),
      );
      root.querySelectorAll('[data-cash]').forEach((button) =>
        button.addEventListener('click', () => {
          const person = findPerson(button.dataset.cash);
          sheetFor = { who: person, paid: cashFor(person), isGuest: false };
          render();
        }),
      );
      root.querySelectorAll('[data-amount]').forEach((button) =>
        button.addEventListener('click', () => applyAmount(Number(button.dataset.amount))),
      );
      root.querySelector('[data-clear]')?.addEventListener('click', () => applyAmount(0));
      root.querySelector('[data-other]')?.addEventListener('click', () => {
        keypadFor = sheetFor.who;
        keypadTitle = sheetFor.isGuest
          ? `${sheetFor.who.firstName} ${sheetFor.who.surname}`
          : `${sheetFor.who.householdName} household`;
        keypadPence = sheetFor.paid;
        render();
      });
      root.querySelector('[data-close]')?.addEventListener('click', () => {
        sheetFor = null;
        render();
      });
      root.querySelectorAll('[data-key]').forEach((button) =>
        button.addEventListener('click', () => {
          const key = button.dataset.key;
          if (key === 'clear') keypadPence = 0;
          else if (key === 'back') keypadPence = Math.floor(keypadPence / 10);
          else keypadPence = Math.min(keypadPence * 10 + Number(key), 99999);
          render();
        }),
      );
      root.querySelector('[data-key-cancel]')?.addEventListener('click', () => {
        keypadFor = null;
        render();
      });
      root.querySelector('[data-key-confirm]')?.addEventListener('click', () =>
        applyAmount(keypadPence),
      );
      const searchInput = root.querySelector('#a-search');
      searchInput?.addEventListener('input', () => {
        search = searchInput.value;
        render();
        const restored = root.querySelector('#a-search');
        restored?.focus();
        restored?.setSelectionRange(search.length, search.length);
      });
    }

    window.proto.onChange(render);
    render();
  })();
</script>
