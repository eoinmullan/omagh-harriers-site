---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { formatBalance } from '../../lib/credits/money';

const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (!user) return Astro.redirect('/signin');

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);

const { data: principals } = await adminClient
  .from('principals')
  .select('id, email, display_name, is_active')
  .order('display_name');

const { data: balances } = await adminClient
  .from('principal_balances')
  .select('principal_id, balance_pence');

const balanceByPrincipal = new Map(
  (balances ?? []).map((row) => [row.principal_id, row.balance_pence]),
);

const households = (principals ?? []).map((principal) => ({
  ...principal,
  balancePence: balanceByPrincipal.get(principal.id) ?? 0,
}));

const clubFloatPence = households.reduce((total, h) => total + h.balancePence, 0);
const inCredit = households.filter((h) => h.balancePence > 0).length;
const overdrawn = households.filter((h) => h.balancePence < 0).length;
---

<Layout title="Training credit — Admin — Omagh Harriers AC">
  <PageContainer>
    <div class="mb-8">
      <p class="text-sm text-gray-500 mb-1">
        <a href="/members" class="hover:underline">Members' area</a> / Admin
      </p>
      <h1 class="text-3xl font-bold">Training credit</h1>
      <p class="text-gray-500 mt-1">{households.length} households</p>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4">
        <dt class="text-sm text-gray-500">Club float</dt>
        <dd class="text-2xl font-bold mt-0.5">{formatBalance(clubFloatPence)}</dd>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4">
        <dt class="text-sm text-gray-500">In credit</dt>
        <dd class="text-2xl font-bold mt-0.5">{inCredit}</dd>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4">
        <dt class="text-sm text-gray-500">Overdrawn</dt>
        <dd
          class:list={['text-2xl font-bold mt-0.5', overdrawn > 0 && 'text-red-600']}
        >
          {overdrawn}
        </dd>
      </div>
    </dl>

    <input
      id="household-filter"
      type="search"
      placeholder="Filter by name or email…"
      class="mb-4 w-full sm:w-80 border border-gray-300 rounded px-3 py-2 text-sm"
    />

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left">
            <th class="pb-3 font-semibold">Household</th>
            <th class="pb-3 font-semibold">Email</th>
            <th class="pb-3 font-semibold text-right">Balance</th>
            <th class="pb-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {
            households.map((household) => (
              <tr
                class={!household.is_active ? 'opacity-50' : ''}
                data-filter={`${household.display_name} ${household.email}`.toLowerCase()}
              >
                <td class="py-3 font-medium">{household.display_name}</td>
                <td class="py-3 text-gray-600">{household.email}</td>
                <td
                  class:list={[
                    'py-3 text-right font-medium',
                    household.balancePence < 0 && 'text-red-600',
                    household.balancePence === 0 && 'text-gray-400',
                  ]}
                >
                  {formatBalance(household.balancePence)}
                </td>
                <td class="py-3 text-right">
                  <a
                    href={`/admin/credits/${household.id}`}
                    class="text-xs underline hover:text-gray-600"
                  >
                    Record &rarr;
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </PageContainer>
</Layout>

<script>
  const input = document.getElementById('household-filter') as HTMLInputElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-filter]');

  input?.addEventListener('input', () => {
    const term = input.value.toLowerCase();
    rows.forEach((row) => {
      row.hidden = term !== '' && !row.dataset.filter?.includes(term);
    });
  });
</script>
