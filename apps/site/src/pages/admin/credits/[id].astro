---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createSupabaseAdminClientFromLocals } from '../../../lib/supabase/admin';
import { formatBalance, formatPounds } from '../../../lib/credits/money';
import { describeEntry, isCredit } from '../../../lib/credits/transactions';
import {
  DEFAULT_SESSION_PRICE_PENCE,
  planAdjustment,
  planCashTopUp,
  planSessionDebit,
  planTransfer,
  type LedgerWrite,
} from '../../../lib/credits/ledger';
import type { CreditTransactionType } from '../../../lib/supabase/types';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/credits');

const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (!user) return Astro.redirect('/signin');

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);

const { data: actingPrincipal } = await Astro.locals.supabase
  .from('principals')
  .select('id')
  .eq('auth_user_id', user.id)
  .maybeSingle();

if (!actingPrincipal) return Astro.redirect('/signin');

async function loadHousehold(principalId: string) {
  const { data: principal } = await adminClient
    .from('principals')
    .select('id, email, display_name, is_active')
    .eq('id', principalId)
    .maybeSingle();

  if (!principal) return undefined;

  const { data: balance } = await adminClient
    .from('principal_balances')
    .select('balance_pence')
    .eq('principal_id', principalId)
    .maybeSingle();

  return {
    ...principal,
    displayName: principal.display_name,
    balancePence: balance?.balance_pence ?? 0,
  };
}

// Surname first, so siblings sit together — the same ordering the registrar app
// will use at the track.
async function loadMembers(principalId: string) {
  const { data } = await adminClient
    .from('members')
    .select('id, first_name, surname')
    .eq('principal_id', principalId)
    .eq('is_active', true)
    .order('surname')
    .order('first_name');
  return data ?? [];
}

let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();
  const household = await loadHousehold(id);

  if (!household) {
    error = 'That household no longer exists.';
  } else {
    const request = {
      household,
      amount: field('amount'),
      note: field('note'),
      recordedBy: actingPrincipal.id,
      idempotencyKey: field('idempotency_key'),
    };

    let write: LedgerWrite | undefined;
    let confirmation = '';

    switch (field('action')) {
      case 'cash': {
        write = planCashTopUp(request);
        confirmation = 'Cash payment recorded.';
        break;
      }
      case 'session': {
        const memberId = field('member_id');
        const member = (await loadMembers(household.id)).find((m) => m.id === memberId);
        write =
          memberId && !member
            ? { problem: 'That member is not in this household.' }
            : planSessionDebit({ ...request, memberId: member?.id ?? null });
        confirmation = 'Session charge recorded.';
        break;
      }
      case 'adjust': {
        write = planAdjustment({ ...request, direction: field('direction') });
        confirmation = 'Adjustment recorded.';
        break;
      }
      case 'transfer': {
        const targetId = field('target_id');
        const target = targetId ? await loadHousehold(targetId) : undefined;
        write = planTransfer({ ...request, source: household, target });
        confirmation = target
          ? `Balance transferred to ${target.displayName}.`
          : 'Balance transferred.';
        break;
      }
    }

    if (!write) {
      error = 'Unknown action.';
    } else if ('problem' in write) {
      error = write.problem;
    } else {
      const { error: insertError } = await adminClient
        .from('credit_transactions')
        .insert(write.rows);

      if (!insertError) success = confirmation;
      else if (insertError.code === '23505') {
        error = 'That looks like it has already been recorded — nothing was written twice.';
      } else {
        console.error('[admin/credits] ledger insert failed:', insertError);
        error = insertError.message;
      }
    }
  }
}

const household = await loadHousehold(id);
if (!household) return Astro.redirect('/admin/credits');

const members = await loadMembers(id);

const { data: otherHouseholds } = await adminClient
  .from('principals')
  .select('id, email, display_name')
  .neq('id', id)
  .order('display_name');

const { data: rows } = await adminClient
  .from('credit_transactions')
  .select('id, type, amount_pence, notes, created_at, recorder:created_by(display_name), member:member_id(first_name, surname)')
  .eq('principal_id', id)
  .order('created_at', { ascending: false });

type LedgerRow = {
  id: string;
  type: CreditTransactionType;
  amount_pence: number;
  notes: string | null;
  created_at: string;
  recorder: { display_name: string } | null;
  member: { first_name: string; surname: string } | null;
};

const history = ((rows ?? []) as unknown as LedgerRow[]).map((row) => {
  const entry = {
    type: row.type,
    amountPence: row.amount_pence,
    notes: row.notes,
    recordedBy: row.recorder?.display_name ?? null,
    memberName: row.member ? `${row.member.first_name} ${row.member.surname}` : null,
  };
  return {
    id: row.id,
    description: describeEntry(entry),
    isCredit: isCredit(entry),
    notes: row.notes,
    at: new Date(row.created_at).toLocaleString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    }),
  };
});

// A fresh key per render. Resubmitting the same form — a refresh, a double
// click, the back button — sends the same key, which the unique index refuses.
const idempotencyKey = crypto.randomUUID();
---

<AdminLayout section="credit" title={`${household.displayName}`} breadcrumb={[{ label: 'Credit', href: '/admin/credits' }, { label: household.displayName }]}>

    {
      error && (
        <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">
          {error}
        </div>
      )
    }
    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    <div class="bg-gray-50 border border-gray-200 rounded-lg px-6 py-5 mb-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold">{household.displayName}</h1>
          <p class="text-gray-500 mt-1">{household.email}</p>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-500">Balance</p>
          <p
            class:list={[
              'text-3xl font-bold',
              household.balancePence < 0 ? 'text-red-600' : 'text-gray-900',
            ]}
          >
            {formatBalance(household.balancePence)}
          </p>
        </div>
      </div>
      {
        !household.is_active && (
          <p class="text-sm text-gray-500 mt-4">
            This household is inactive and cannot sign in. Its balance can still
            be transferred.
          </p>
        )
      }
    </div>

    <section class="mb-8">
      <h2 class="text-lg font-semibold mb-3">Record a cash payment</h2>
      <form method="POST" class="grid grid-cols-1 sm:grid-cols-[8rem_1fr_auto] gap-4">
        <input type="hidden" name="action" value="cash" />
        <input type="hidden" name="idempotency_key" value={`cash:${idempotencyKey}`} />
        <div>
          <label class="block text-sm font-medium mb-1" for="cash-amount">Amount</label>
          <input
            id="cash-amount"
            type="text"
            name="amount"
            inputmode="decimal"
            placeholder="10.00"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="cash-note">
            Note <span class="text-gray-400 font-normal">(optional)</span>
          </label>
          <input
            id="cash-note"
            type="text"
            name="note"
            placeholder="Paid at Monday track"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-end">
          <button
            type="submit"
            class="w-full bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
            >Record</button
          >
        </div>
      </form>
    </section>

    <section class="mb-8">
      <h2 class="text-lg font-semibold mb-3">Charge a training session</h2>
      <form
        method="POST"
        class="grid grid-cols-1 sm:grid-cols-[1fr_8rem_1fr_auto] gap-4"
      >
        <input type="hidden" name="action" value="session" />
        <input type="hidden" name="idempotency_key" value={`session:${idempotencyKey}`} />
        <div>
          <label class="block text-sm font-medium mb-1" for="session-member">
            Who trained
          </label>
          <select
            id="session-member"
            name="member_id"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          >
            <option value="">The household</option>
            {
              members.map((member) => (
                <option value={member.id}>
                  {member.surname}, {member.first_name}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="session-amount">Charge</label>
          <input
            id="session-amount"
            type="text"
            name="amount"
            inputmode="decimal"
            value={formatPounds(DEFAULT_SESSION_PRICE_PENCE)}
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="session-note">
            Session <span class="text-gray-400 font-normal">(optional)</span>
          </label>
          <input
            id="session-note"
            type="text"
            name="note"
            placeholder="Monday track"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-end">
          <button
            type="submit"
            class="w-full bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
            >Charge</button
          >
        </div>
      </form>
      <p class="text-xs text-gray-500 mt-2">
        Until the registrar app exists, this is how credit leaves an account. Naming
        who trained makes the member's own page read "training session for ..."
        instead of leaving them guessing.
      </p>
    </section>

    <details class="mb-8 border border-gray-200 rounded-lg">
      <summary class="px-5 py-3 font-medium cursor-pointer select-none">
        Adjust the balance
      </summary>
      <form
        method="POST"
        class="px-5 pb-5 pt-3 grid grid-cols-1 sm:grid-cols-[9rem_8rem_1fr_auto] gap-4"
      >
        <input type="hidden" name="action" value="adjust" />
        <input type="hidden" name="idempotency_key" value={`adjust:${idempotencyKey}`} />
        <div>
          <label class="block text-sm font-medium mb-1" for="adjust-direction">Direction</label>
          <select
            id="adjust-direction"
            name="direction"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          >
            <option value="add">Add credit</option>
            <option value="remove">Remove credit</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="adjust-amount">Amount</label>
          <input
            id="adjust-amount"
            type="text"
            name="amount"
            inputmode="decimal"
            placeholder="5.00"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="adjust-note">Note</label>
          <input
            id="adjust-note"
            type="text"
            name="note"
            placeholder="Why this adjustment is being made"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-end">
          <button
            type="submit"
            class="w-full bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
            >Adjust</button
          >
        </div>
      </form>
      <p class="px-5 pb-5 text-xs text-gray-500">
        The member sees the note as the reason on their own credit page, so write
        it for them.
      </p>
    </details>

    <details class="mb-10 border border-gray-200 rounded-lg">
      <summary class="px-5 py-3 font-medium cursor-pointer select-none">
        Transfer the balance to another household
      </summary>
      <form method="POST" class="px-5 pb-5 pt-3 space-y-4">
        <input type="hidden" name="action" value="transfer" />
        <input type="hidden" name="idempotency_key" value={`transfer:${idempotencyKey}`} />
        <div class="grid grid-cols-1 sm:grid-cols-[1fr_8rem] gap-4">
          <div>
            <label class="block text-sm font-medium mb-1" for="transfer-target">To</label>
            <select
              id="transfer-target"
              name="target_id"
              required
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
            >
              <option value="">Choose a household…</option>
              {
                otherHouseholds?.map((other) => (
                  <option value={other.id}>
                    {other.display_name} ({other.email})
                  </option>
                ))
              }
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1" for="transfer-amount">
              Amount
            </label>
            <input
              id="transfer-amount"
              type="text"
              name="amount"
              inputmode="decimal"
              placeholder={formatPounds(household.balancePence)}
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
            />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="transfer-note">Note</label>
          <input
            id="transfer-note"
            type="text"
            name="note"
            placeholder="Contact email changed in Klubfunder"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <button
          type="submit"
          class="bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
          >Transfer</button
        >
        <p class="text-xs text-gray-500">
          Leave the amount blank to move the whole balance. Both sides are written
          together, so neither can land on its own.
        </p>
      </form>
    </details>

    <section>
      <h2 class="text-lg font-semibold mb-4">
        Ledger ({history.length})
      </h2>

      {
        history.length > 0 ? (
          <ul class="divide-y divide-gray-200 border-t border-b border-gray-200">
            {history.map((line) => (
              <li class="py-3 flex items-baseline justify-between gap-4">
                <div>
                  <p class="font-medium">{line.description}</p>
                  <p class="text-xs text-gray-500 mt-0.5">
                    {line.at}
                    {line.notes ? ` · ${line.notes}` : ''}
                  </p>
                </div>
                <span
                  class:list={[
                    'text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap',
                    line.isCredit ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600',
                  ]}
                >
                  {line.isCredit ? 'Credit' : 'Debit'}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-500 text-sm">Nothing recorded for this household yet.</p>
        )
      }
      <p class="text-xs text-gray-400 mt-4">
        The ledger is append-only. A mistake is corrected with an adjustment, not
        by editing a line.
      </p>
    </section>
</AdminLayout>
