---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { planHousehold } from '../../lib/people';
import { loginFor } from '../../lib/auth/logins';
import { redirectAfterPost, takeFlash } from '../../lib/http/after-post';
import { formatBalance } from '../../lib/credits/money';
import { orThrow } from '../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../lib/auth/signed-in';
import { accessOf } from '../../lib/auth/roles';
import PageHeader from '../../components/admin/PageHeader.astro';
import Flash from '../../components/admin/Flash.astro';
import StatTiles from '../../components/admin/StatTiles.astro';
import StatTile from '../../components/admin/StatTile.astro';
import ListToolbar from '../../components/admin/ListToolbar.astro';
import ResourceTable from '../../components/admin/ResourceTable.astro';
import FormDialog from '../../components/admin/FormDialog.astro';
import Pill from '../../components/admin/Pill.astro';
import AccessPills from '../../components/admin/AccessPills.astro';

// The one list of households, balances included. Credit used to be a second
// section listing the same 220 rows with different columns, which made "has
// Jack Kelly's mum paid?" two screens instead of one.

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


let error: string | null = null;
let success: string | null = null;

const isSuperuser = actingPrincipal.role === 'superuser';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'add' && isSuperuser) {
    const plan = planHousehold({
      email: ((formData.get('email') as string) ?? '').toString(),
      displayName: ((formData.get('display_name') as string) ?? '').toString(),
    });

    if ('problem' in plan) {
      error = plan.problem;
    } else {
      const { email, display_name: displayName } = plan.row;

      // Checked before any login is touched. loginFor finds an existing login
      // for this address, and if that login belongs to a household already
      // here, the insert below would fail and the cleanup would delete it.
      const existing = orThrow(
        await adminClient.from('principals').select('id').eq('email', email).maybeSingle(),
      );

      if (existing) {
        error = `A household with ${email} already exists.`;
      } else {
        try {
          // A login left over from an earlier attempt that got halfway is
          // reused rather than refused. See lib/auth/logins.ts.
          const login = await loginFor(adminClient.auth.admin, email);
          const { error: insertError } = await adminClient
            .from('principals')
            .insert({ ...plan.row, auth_user_id: login.id });

          if (insertError) {
            // Only undo a login this request made. One that was found is left
            // for the next attempt to pick up.
            if (login.created) await adminClient.auth.admin.deleteUser(login.id);
            error = insertError.message;
          } else {
            success = `${displayName} (${email}) added.`;
          }
        } catch (e) {
          error = e instanceof Error ? e.message : String(e);
        }
      }
    }
  }
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const principals = orThrow(await adminClient
  .from('principals')
  .select('id, email, display_name, role, is_active')
  .order('display_name'));

const activeMembers = orThrow(await adminClient
  .from('members')
  .select('principal_id')
  .eq('is_active', true));

const balances = orThrow(await adminClient
  .from('principal_balances')
  .select('principal_id, balance_pence'));

const memberCountByPrincipal = new Map<string, number>();
for (const m of activeMembers ?? []) {
  memberCountByPrincipal.set(
    m.principal_id,
    (memberCountByPrincipal.get(m.principal_id) ?? 0) + 1,
  );
}

const balanceByPrincipal = new Map(
  (balances ?? []).map((row) => [row.principal_id, row.balance_pence]),
);

const households = (principals ?? []).map((principal) => ({
  ...principal,
  memberCount: memberCountByPrincipal.get(principal.id) ?? 0,
  balancePence: balanceByPrincipal.get(principal.id) ?? 0,
}));

const clubFloatPence = households.reduce((total, h) => total + h.balancePence, 0);
const overdrawn = households.filter((h) => h.balancePence < 0).length;
const inCredit = households.filter((h) => h.balancePence > 0).length;

const volunteers = households.filter((h) => accessOf(h.role).length > 0).length;

function tagsOf(h: (typeof households)[number]): string {
  return [
    h.balancePence < 0 && 'overdrawn',
    h.balancePence > 0 && 'in-credit',
    accessOf(h.role).length > 0 && 'volunteer',
  ]
    .filter(Boolean)
    .join(' ');
}
---

<AdminLayout section="households" title="Households">
  <PageHeader
    title="Households"
    subtitle={`${households.length} total · each one is a login, with its members and its training credit`}
    primary={isSuperuser ? { label: 'Add household', dialog: 'new-household' } : undefined}
  >
    <div slot="actions" class="flex items-baseline gap-2 sm:block sm:text-right">
      <p class="order-2 text-xs font-medium text-gray-500">Club float</p>
      <p class="order-1 text-2xl sm:text-3xl font-bold tabular-nums">{formatBalance(clubFloatPence)}</p>
      <p class="order-3 hidden sm:block text-xs text-gray-400">credit held for all households</p>
    </div>
  </PageHeader>

  <Flash success={success} error={isSuperuser ? null : error} />

  <!-- Overdrawn and In credit are filters as well as figures: most
       households sit at £0, so the question is usually "who isn't?". Each
       also sorts what it shows, owing most or most credit first. Otherwise
       the list is A to Z. -->
  <StatTiles columns={3}>
    <StatTile label="Overdrawn" value={overdrawn} tone="danger" filter="overdrawn" list="households" />
    <StatTile label="In credit" value={inCredit} filter="in-credit" list="households" />
    <StatTile label="Volunteers" value={volunteers} hint="admins and registrars" filter="volunteer" list="households" />
  </StatTiles>

  <ListToolbar list="households" placeholder="Search by name or email…" label="Search households by name or email" />

  <ResourceTable id="households" noMatches="No households match.">
    <thead>
      <tr>
        <th id="name-heading" aria-sort="ascending">Name</th>
        <th>Email</th>
        <th class="num">Members</th>
        <th id="balance-heading" aria-sort="none" class="num">Balance <span id="balance-arrow" aria-hidden="true"></span></th>
        <th>Status</th>
        <th><span class="sr-only">Open</span></th>
      </tr>
    </thead>
    <tbody>
      {households.map((h) => (
        <tr
          data-href={`/admin/households/${h.id}`}
          data-search={`${h.display_name} ${h.email}`.toLowerCase()}
          data-tags={tagsOf(h)}
          data-balance={h.balancePence}
          class:list={[!h.is_active && 'is-muted']}
        >
          <td class="cell-primary">
            <span class="inline-flex flex-wrap items-center gap-x-2 gap-y-0.5">
              <a href={`/admin/households/${h.id}`} class="row-link">{h.display_name}</a>
              <AccessPills role={h.role} viewer={actingPrincipal.role} />
            </span>
          </td>
          <td class="mobile-only cell-secondary">
            {!h.is_active && 'Inactive · '}{h.email} · {h.memberCount} {h.memberCount === 1 ? 'member' : 'members'}
          </td>
          <td class="text-gray-600">{h.email}</td>
          <td class="num">{h.memberCount}</td>
          <td
            class:list={[
              'num cell-trailing font-medium',
              h.balancePence < 0 && 'text-red-600',
              h.balancePence === 0 && 'text-gray-400',
            ]}
          >
            {formatBalance(h.balancePence)}
          </td>
          <td>{h.is_active ? <Pill tone="green">Active</Pill> : <Pill tone="gray">Inactive</Pill>}</td>
          <td class="row-chevron" aria-hidden="true"></td>
        </tr>
      ))}
    </tbody>
  </ResourceTable>
  {households.length === 0 && <p class="text-gray-500 text-sm py-8 text-center">No households found.</p>}

  {isSuperuser && (
    <FormDialog id="new-household" title="Add household" submitLabel="Add household" error={error} reopen>
      <div>
        <label class="field-label" for="household-email">Email</label>
        <input id="household-email" type="email" name="email" required class="field" />
      </div>
      <div>
        <label class="field-label" for="household-name">Display name</label>
        <input id="household-name" type="text" name="display_name" required class="field" />
      </div>
      <input type="hidden" name="action" value="add" />
    </FormDialog>
  )}
</AdminLayout>

<script>
  // Overdrawn lists who owes most first, and In credit who holds most first,
  // since those are the people the question is about. With neither on, the
  // list is back in the order the server sent it, A to Z. The filtering
  // itself is the admin area's shared list script, in AdminLayout.
  const table = document.getElementById('households');
  const body = table?.querySelector<HTMLTableSectionElement>('tbody');
  const nameOrder = Array.from(table?.querySelectorAll<HTMLTableRowElement>('tbody tr[data-balance]') ?? []);
  const arrow = document.getElementById('balance-arrow');

  const balanceOf = (row: HTMLTableRowElement) => Number(row.dataset.balance);

  function sortFor(filter: string | null) {
    const order = filter === 'overdrawn' ? 'poorest' : filter === 'in-credit' ? 'richest' : 'name';

    const sorted =
      order === 'name'
        ? nameOrder
        : nameOrder.slice().sort((a, b) => (order === 'poorest' ? balanceOf(a) - balanceOf(b) : balanceOf(b) - balanceOf(a)));
    sorted.forEach((row) => body?.appendChild(row));

    // The arrow is for the eye and hidden from screen readers; aria-sort is
    // what tells them how the table is ordered. Poorest first is ascending.
    if (arrow) arrow.textContent = order === 'poorest' ? '↑' : order === 'richest' ? '↓' : '';
    document.getElementById('name-heading')?.setAttribute('aria-sort', order === 'name' ? 'ascending' : 'none');
    document
      .getElementById('balance-heading')
      ?.setAttribute('aria-sort', order === 'poorest' ? 'ascending' : order === 'richest' ? 'descending' : 'none');
  }

  table?.addEventListener('list-filter', (event) => sortFor((event as CustomEvent<{ filter: string | null }>).detail.filter));
  // The shared script may have applied a ?filter= before this one ran.
  sortFor(document.querySelector<HTMLElement>('[data-list-for="households"][aria-pressed="true"]')?.dataset.listFilter ?? null);
</script>
