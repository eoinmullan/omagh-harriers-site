---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { formatBalance } from '../../lib/credits/money';

// The one list of households, balances included. Credit used to be a second
// section listing the same 220 rows with different columns, which made "has
// Jack Kelly's mum paid?" two screens instead of one.

const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (!user) return Astro.redirect('/signin');

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);

const { data: actingPrincipal } = await Astro.locals.supabase
  .from('principals')
  .select('role')
  .eq('auth_user_id', user.id)
  .maybeSingle();

if (!actingPrincipal) return Astro.redirect('/signin');

let error: string | null = null;
let success: string | null = null;

const isSuperuser = actingPrincipal.role === 'superuser';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'add' && isSuperuser) {
    const email = (formData.get('email') as string)?.trim().toLowerCase();
    const displayName = (formData.get('display_name') as string)?.trim();

    if (!email || !displayName) {
      error = 'Email and display name are required.';
    } else {
      const { data: authUser, error: authError } =
        await adminClient.auth.admin.createUser({
          email,
          email_confirm: true,
        });

      if (authError) {
        error = authError.message;
      } else {
        const { error: insertError } = await adminClient
          .from('principals')
          .insert({
            email,
            display_name: displayName,
            auth_user_id: authUser.user.id,
            source: 'manual',
            role: 'member',
          });

        if (insertError) {
          await adminClient.auth.admin.deleteUser(authUser.user.id);
          error = insertError.message;
        } else {
          success = `${displayName} (${email}) added.`;
        }
      }
    }
  }
}

const { data: principals } = await adminClient
  .from('principals')
  .select('id, email, display_name, role, is_active, source')
  .order('display_name');

const { data: activeMembers } = await adminClient
  .from('members')
  .select('principal_id')
  .eq('is_active', true);

const { data: balances } = await adminClient
  .from('principal_balances')
  .select('principal_id, balance_pence');

const memberCountByPrincipal = new Map<string, number>();
for (const m of activeMembers ?? []) {
  memberCountByPrincipal.set(
    m.principal_id,
    (memberCountByPrincipal.get(m.principal_id) ?? 0) + 1,
  );
}

const balanceByPrincipal = new Map(
  (balances ?? []).map((row) => [row.principal_id, row.balance_pence]),
);

const households = (principals ?? []).map((principal) => ({
  ...principal,
  memberCount: memberCountByPrincipal.get(principal.id) ?? 0,
  balancePence: balanceByPrincipal.get(principal.id) ?? 0,
}));

const clubFloatPence = households.reduce((total, h) => total + h.balancePence, 0);
const overdrawn = households.filter((h) => h.balancePence < 0).length;

const roleBadge: Record<string, string> = {
  superuser: 'bg-purple-100 text-purple-700',
  admin: 'bg-blue-100 text-blue-700',
  registrar: 'bg-amber-100 text-amber-700',
};
---

<AdminLayout section="households" title="Households">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold">Households</h1>
        <p class="text-gray-500 mt-1">
          {households.length} total
        </p>
      </div>
      <a href="/admin/members" class="text-sm underline hover:text-gray-600"
        >View members →</a
      >
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4">
        <dt class="text-sm text-gray-500">Club float</dt>
        <dd class="text-2xl font-bold mt-0.5">{formatBalance(clubFloatPence)}</dd>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4">
        <dt class="text-sm text-gray-500">Overdrawn</dt>
        <dd
          class:list={['text-2xl font-bold mt-0.5', overdrawn > 0 && 'text-red-600']}
        >
          {overdrawn}
        </dd>
      </div>
    </dl>

    {
      error && (
        <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">
          {error}
        </div>
      )
    }
    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    {isSuperuser && <details class="mb-8 border border-gray-200 rounded-lg">
      <summary class="px-5 py-3 font-medium cursor-pointer select-none"
        >Add a household</summary
      >
      <form
        method="POST"
        class="px-5 pb-5 pt-3 grid grid-cols-1 sm:grid-cols-3 gap-4"
      >
        <input type="hidden" name="action" value="add" />
        <div>
          <label class="block text-sm font-medium mb-1">Email</label>
          <input
            type="email"
            name="email"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Display name</label>
          <input
            type="text"
            name="display_name"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-end">
          <button
            type="submit"
            class="w-full bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
            >Add</button
          >
        </div>
      </form>
    </details>}

    <input
      id="principal-filter"
      type="search"
      placeholder="Filter by name or email…"
      class="mb-4 w-full sm:w-80 border border-gray-300 rounded px-3 py-2 text-sm"
    />

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left">
            <th class="pb-3 font-semibold">
              <button type="button" data-sort="name" class="font-semibold hover:underline"
                >Name</button
              >
            </th>
            <th class="pb-3 font-semibold">Email</th>
            <th class="pb-3 font-semibold">Role</th>
            <th class="pb-3 font-semibold">Members</th>
            <th class="pb-3 font-semibold text-right">
              <button type="button" data-sort="balance" class="font-semibold hover:underline"
                >Balance</button
              >
            </th>
            <th class="pb-3 font-semibold">Status</th>
            <th class="pb-3 font-semibold">Source</th>
            <th class="pb-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {
            households.map((h) => (
              <tr
                class={!h.is_active ? 'opacity-50' : ''}
                data-filter={`${h.display_name} ${h.email}`.toLowerCase()}
                data-balance={h.balancePence}
              >
                <td class="py-3 font-medium">{h.display_name}</td>
                <td class="py-3 text-gray-600">{h.email}</td>
                <td class="py-3">
                  <span
                    class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                      roleBadge[h.role] ?? 'bg-gray-100 text-gray-600'
                    }`}
                  >
                    {h.role}
                  </span>
                </td>
                <td class="py-3">{h.memberCount}</td>
                <td
                  class:list={[
                    'py-3 text-right font-medium',
                    h.balancePence < 0 && 'text-red-600',
                    h.balancePence === 0 && 'text-gray-400',
                  ]}
                >
                  {formatBalance(h.balancePence)}
                </td>
                <td class="py-3">
                  <span
                    class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                      h.is_active
                        ? 'bg-green-100 text-green-700'
                        : 'bg-gray-100 text-gray-500'
                    }`}
                  >
                    {h.is_active ? 'Active' : 'Inactive'}
                  </span>
                </td>
                <td class="py-3 text-gray-400 text-xs">{h.source}</td>
                <td class="py-3 text-right">
                  <a
                    href={`/admin/households/${h.id}`}
                    class="text-xs underline hover:text-gray-600"
                  >
                    View →
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {
        households.length === 0 && (
          <p class="text-gray-500 text-sm py-8 text-center">
            No households found.
          </p>
        )
      }
    </div>
</AdminLayout>

<script>
  const input = document.getElementById('principal-filter') as HTMLInputElement;
  const body = document.querySelector('tbody');
  const rows = Array.from(
    document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-filter]'),
  );

  input?.addEventListener('input', () => {
    const term = input.value.toLowerCase();
    rows.forEach((row) => {
      row.hidden = term !== '' && !row.dataset.filter?.includes(term);
    });
  });

  // Who owes money is the question the balance column exists to answer, so
  // sorting by it is one click: poorest first, then richest.
  const nameOrder = rows.slice();
  let ascending = true;

  document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((button) => {
    button.addEventListener('click', () => {
      const byBalance = button.dataset.sort === 'balance';
      ascending = byBalance ? !ascending : true;

      const sorted = byBalance
        ? nameOrder
            .slice()
            .sort(
              (a, b) =>
                (Number(a.dataset.balance) - Number(b.dataset.balance)) *
                (ascending ? 1 : -1),
            )
        : nameOrder;

      sorted.forEach((row) => body?.appendChild(row));
    });
  });
</script>
