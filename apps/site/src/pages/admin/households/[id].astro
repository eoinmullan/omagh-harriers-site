---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../../lib/supabase/admin';
import { planDisplayName } from '../../../lib/people';
import { redirectAfterPost, takeFlash } from '../../../lib/http/after-post';
import { assignableRoles, planRoleChange, ROLE_DESCRIPTIONS, shownRole } from '../../../lib/auth/roles';
import { formatBalance, formatPounds } from '../../../lib/credits/money';
import { householdHistory } from '../../../lib/credits/history';
import Statement from '../../../components/Statement.astro';
import {
  planAdjustment,
  planCashTopUp,
  planTransfer,
  type LedgerWrite,
} from '../../../lib/credits/ledger';
import type { CreditTransactionType } from '../../../lib/supabase/types';
import { orThrow } from '../../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../../lib/auth/signed-in';
import RecordHeader from '../../../components/admin/RecordHeader.astro';
import Figure from '../../../components/admin/Figure.astro';
import Flash from '../../../components/admin/Flash.astro';
import Pill from '../../../components/admin/Pill.astro';
import AccessPills from '../../../components/admin/AccessPills.astro';
import Section from '../../../components/admin/Section.astro';
import SummaryList from '../../../components/admin/SummaryList.astro';
import SummaryRow from '../../../components/admin/SummaryRow.astro';
import ResourceTable from '../../../components/admin/ResourceTable.astro';
import FormDialog from '../../../components/admin/FormDialog.astro';
import DangerZone from '../../../components/admin/DangerZone.astro';
import DangerAction from '../../../components/admin/DangerAction.astro';

// One page per household, because a household is one thing an admin holds in
// their head: a name, the people in it, a role and a balance. It used to be
// two, and "has Jack Kelly's mum paid?" found the money on one screen and the
// email to chase her on the other.

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/households');
const householdId = id;

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


const isSuperuser = actingPrincipal.role === 'superuser';
const offeredRoles = assignableRoles(actingPrincipal.role);

async function loadBalancePence(principalId: string): Promise<number> {
  const data = orThrow(await adminClient
    .from('principal_balances')
    .select('balance_pence')
    .eq('principal_id', principalId)
    .maybeSingle());

  return data?.balance_pence ?? 0;
}

// The ledger rules ask for a household's identity and what it holds, never the
// whole principal row — so this is what they get, for either side of a transfer.
async function loadLedgerHousehold(principalId: string) {
  const data = orThrow(await adminClient
    .from('principals')
    .select('id, display_name')
    .eq('id', principalId)
    .maybeSingle());

  if (!data) return undefined;

  return {
    id: data.id,
    displayName: data.display_name,
    balancePence: await loadBalancePence(principalId),
  };
}

// Surname first, so siblings sit together — the same ordering the registrar app
// uses at the track.
async function loadMembers(principalId: string) {
  const data = orThrow(await adminClient
    .from('members')
    .select('id, first_name, surname, date_of_birth, status, is_active, gender, trains_free')
    .eq('principal_id', principalId)
    .order('surname')
    .order('first_name'));

  return data ?? [];
}

type Outcome = { error: string } | { success: string };
type Field = (name: string) => string;

const IDENTITY_ACTIONS = ['update_name', 'set_role', 'deactivate', 'reactivate'];

async function changeIdentity(action: string, field: Field): Promise<Outcome> {
  if (!isSuperuser) {
    return { error: 'A name, access or account status can’t be changed from this login.' };
  }

  if (action === 'update_name') {
    const name = planDisplayName(field('display_name'));
    if ('problem' in name) return { error: name.problem };

    const { error } = await adminClient
      .from('principals')
      .update({ display_name: name.displayName })
      .eq('id', householdId);

    return error ? { error: error.message } : { success: 'Display name updated.' };
  }

  if (action === 'set_role') {
    const target = orThrow(await adminClient
      .from('principals')
      .select('role')
      .eq('id', householdId)
      .maybeSingle());

    const change = target
      ? planRoleChange({
          actingRole: actingPrincipal!.role,
          actingPrincipalId: actingPrincipal!.id,
          targetPrincipalId: householdId,
          currentRole: target.role,
          requestedRole: field('role'),
        })
      : { problem: 'That household no longer exists.' };

    if ('problem' in change) return { error: change.problem };

    const { error } = await adminClient
      .from('principals')
      .update({ role: change.role })
      .eq('id', householdId);

    return error ? { error: error.message } : { success: `Role updated to ${change.role}.` };
  }

  const becomingActive = action === 'reactivate';

  const target = orThrow(await adminClient
    .from('principals')
    .select('auth_user_id')
    .eq('id', householdId)
    .maybeSingle());

  if (target?.auth_user_id) {
    await adminClient.auth.admin.updateUserById(target.auth_user_id, {
      ban_duration: becomingActive ? 'none' : '876000h',
    });
  }

  const { error } = await adminClient
    .from('principals')
    .update({ is_active: becomingActive })
    .eq('id', householdId);

  if (error) return { error: error.message };
  return { success: becomingActive ? 'Household reactivated.' : 'Household deactivated.' };
}

async function recordLedgerEntry(action: string, field: Field): Promise<Outcome> {
  const household = await loadLedgerHousehold(householdId);
  if (!household) return { error: 'That household no longer exists.' };

  const request = {
    household,
    amount: field('amount'),
    note: field('note'),
    recordedBy: actingPrincipal!.id,
    idempotencyKey: field('idempotency_key'),
  };

  let write: LedgerWrite | undefined;
  let confirmation = '';

  switch (action) {
    case 'cash': {
      write = planCashTopUp(request);
      confirmation = 'Cash payment recorded.';
      break;
    }
    case 'adjust': {
      write = planAdjustment({ ...request, direction: field('direction') });
      confirmation = 'Adjustment recorded.';
      break;
    }
    case 'transfer': {
      const targetId = field('target_id');
      const target = targetId ? await loadLedgerHousehold(targetId) : undefined;
      write = planTransfer({ ...request, source: household, target });
      confirmation = target
        ? `Balance transferred to ${target.displayName}.`
        : 'Balance transferred.';
      break;
    }
  }

  if (!write) return { error: 'Unknown action.' };
  if ('problem' in write) return { error: write.problem };

  const { error: insertError } = await adminClient
    .from('credit_transactions')
    .insert(write.rows);

  if (!insertError) return { success: confirmation };

  if (insertError.code === '23505') {
    return {
      error: 'That looks like it has already been recorded — nothing was written twice.',
    };
  }

  console.error('[admin/households] ledger insert failed:', insertError);
  return { error: insertError.message };
}

let outcome: Outcome | undefined;
// So a failed form reopens the dialog it came from.
let postedAction = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const field: Field = (name) => ((formData.get(name) as string) ?? '').toString();
  const action = field('action');
  postedAction = action;

  outcome = IDENTITY_ACTIONS.includes(action)
    ? await changeIdentity(action, field)
    : await recordLedgerEntry(action, field);
}

const error = outcome && 'error' in outcome ? outcome.error : null;
let success = outcome && 'success' in outcome ? outcome.success : null;

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const principal = orThrow(await adminClient
  .from('principals')
  .select('*')
  .eq('id', householdId)
  .maybeSingle());

if (!principal) return Astro.redirect('/admin/households');

const balancePence = await loadBalancePence(householdId);
const members = await loadMembers(householdId);

const otherHouseholds = orThrow(await adminClient
  .from('principals')
  .select('id, email, display_name')
  .neq('id', householdId)
  .order('display_name'));

const rows = orThrow(await adminClient
  .from('credit_transactions')
  .select(
    'id, type, amount_pence, notes, created_at, recorder:principals!created_by(display_name), member:member_id(first_name, surname), session:session_id(starts_at, group:group_id(name)), counterparty:principals!counterparty_principal_id(display_name)',
  )
  .eq('principal_id', householdId)
  .order('created_at', { ascending: false }));

type LedgerRow = {
  id: string;
  type: CreditTransactionType;
  amount_pence: number;
  notes: string | null;
  created_at: string;
  recorder: { display_name: string } | null;
  member: { first_name: string; surname: string } | null;
  session: { starts_at: string; group: { name: string } | null } | null;
  counterparty: { display_name: string } | null;
};

// The same statement the household sees on its own credit page, with the
// other household on a transfer named, which a member's own page leaves out.
const history = householdHistory({
  ledger: ((rows ?? []) satisfies LedgerRow[]).map((row) => ({
    id: row.id,
    createdAt: row.created_at,
    memberId: null,
    entry: {
      type: row.type,
      amountPence: row.amount_pence,
      notes: row.notes,
      recordedBy: row.recorder?.display_name ?? null,
      memberName: row.member ? `${row.member.first_name} ${row.member.surname}` : null,
      sessionStartsAt: row.session?.starts_at ?? null,
      sessionSquad: row.session?.group?.name ?? null,
      counterpartyName: row.counterparty?.display_name ?? null,
    },
  })),
  freeSessions: [],
});

// A fresh key per render. Resubmitting the same form — a refresh, a double
// click, the back button — sends the same key, which the unique index refuses.
const idempotencyKey = crypto.randomUUID();

function formatDob(dob: string): string {
  return new Date(dob).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

// Which dialog a failed form came from, so it opens again with the reason.
const DIALOG_FOR_ACTION: Record<string, string> = {
  update_name: 'rename-household',
  set_role: 'change-access',
  cash: 'record-cash',
  adjust: 'adjust-balance',
  transfer: 'transfer-balance',
};
const reopenDialog = error ? DIALOG_FOR_ACTION[postedAction] : undefined;
---

<AdminLayout section="households" title={principal.display_name} breadcrumb={[{ label: 'Households', href: '/admin/households' }, { label: principal.display_name }]}>
  <Flash success={success} error={reopenDialog ? null : error} />

  <RecordHeader title={principal.display_name}>
    <Fragment slot="pills">
      <AccessPills role={principal.role} viewer={actingPrincipal.role} />
      {principal.is_active ? <Pill tone="green">Active</Pill> : <Pill tone="gray">Inactive</Pill>}
    </Fragment>
    <p>{principal.email}</p>
    <Fragment slot="actions">
      <button type="button" data-open-dialog="record-cash" class="btn btn-primary btn-sm">Record cash</button>
      <a href="#credit" class="btn btn-secondary btn-sm">Statement</a>
    </Fragment>
    <Fragment slot="figures">
      <Figure label="Members" value={members.filter((m) => m.is_active).length} />
      <Figure label="Balance" value={formatBalance(balancePence)} tone={balancePence < 0 ? 'danger' : 'default'} />
    </Fragment>
    {!principal.is_active && (
      <p slot="footer" class="text-sm text-gray-500 mt-4">
        This household is inactive and cannot sign in. Its balance can still be transferred.
      </p>
    )}
  </RecordHeader>

  <Section title="Details">
    <SummaryList>
      <SummaryRow label="Display name">
        <span class="font-medium">{principal.display_name}</span>
        {isSuperuser && (
          <button slot="action" type="button" data-open-dialog="rename-household" class="btn-link text-sm">Change</button>
        )}
      </SummaryRow>
      <SummaryRow label="Email">{principal.email}</SummaryRow>
      <SummaryRow label="Access">
        <span class="inline-flex flex-wrap items-center gap-2">
          <AccessPills role={principal.role} viewer={actingPrincipal.role} />
          <span class="text-gray-600">{ROLE_DESCRIPTIONS[shownRole(principal.role, actingPrincipal.role)]}</span>
        </span>
        {isSuperuser && (
          <button slot="action" type="button" data-open-dialog="change-access" class="btn-link text-sm">Change</button>
        )}
      </SummaryRow>
      <SummaryRow label="Source">{principal.source}</SummaryRow>
      <SummaryRow label="Terms accepted">
        {principal.terms_accepted_at ? new Date(principal.terms_accepted_at).toLocaleDateString('en-GB') : 'Not yet'}
      </SummaryRow>
      <SummaryRow label="Status">
        {principal.is_active ? 'Active: can sign in' : 'Inactive: cannot sign in'}
        {isSuperuser && !principal.is_active && (
          <form slot="action" method="POST">
            <input type="hidden" name="action" value="reactivate" />
            <button type="submit" class="btn btn-secondary btn-sm">Reactivate</button>
          </form>
        )}
      </SummaryRow>
    </SummaryList>
  </Section>

  <Section title="Members" count={members.length}>
    {members.length > 0 ? (
      <ResourceTable>
        <thead>
          <tr>
            <th>Name</th>
            <th>Date of birth</th>
            <th>Gender</th>
            <th>Status</th>
            <th><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          {members.map((m) => (
            <tr data-href={`/admin/members/${m.id}`} class:list={[!m.is_active && 'is-muted']}>
              <td class="cell-primary">
                <a href={`/admin/members/${m.id}`} class="row-link">{m.first_name} {m.surname}</a>
                {m.trains_free && <Pill tone="amber">Trains free</Pill>}
              </td>
              <td class="mobile-only cell-secondary">{formatDob(m.date_of_birth)}{m.gender && ` · ${m.gender}`}</td>
              <td class="mobile-only cell-trailing">{m.status !== 'paid' && <Pill tone="gray">Lapsed</Pill>}</td>
              <td class="text-gray-600">{formatDob(m.date_of_birth)}</td>
              <td class="text-gray-600">{m.gender ?? '—'}</td>
              <td>{m.status === 'paid' ? <Pill tone="green">Active</Pill> : <Pill tone="gray">Lapsed</Pill>}</td>
              <td class="row-chevron" aria-hidden="true"></td>
            </tr>
          ))}
        </tbody>
      </ResourceTable>
    ) : (
      <p class="text-gray-500 text-sm">No members linked to this household.</p>
    )}
  </Section>

  <!-- Training credit: the balance, what may be written to it, and the
       statement. No "charge a session": a session is charged when a registrar
       signs a runner in, and a missed night is put right from the registrar
       app's Past sessions, which records the attendance too. A charge made here
       would have no session behind it. Money outside that is an adjustment. -->
  <Section
    id="credit"
    title="Training credit"
    description={`${formatBalance(balancePence)} held. The balance is the sum of the statement below, never a stored figure.`}
  >
    <Fragment slot="actions">
      <button type="button" data-open-dialog="record-cash" class="btn btn-primary btn-sm">Record cash</button>
      <button type="button" data-open-dialog="adjust-balance" class="btn btn-secondary btn-sm">Adjust</button>
      <button type="button" data-open-dialog="transfer-balance" class="btn btn-secondary btn-sm">Transfer</button>
    </Fragment>

    {history.length > 0 ? (
      <Statement lines={history} />
    ) : (
      <p class="text-gray-500 text-sm">Nothing recorded for this household yet.</p>
    )}
    <p class="text-xs text-gray-400 mt-3">
      The ledger is append-only. A mistake is corrected with an adjustment, not by editing a line.
    </p>
  </Section>

  {isSuperuser && principal.is_active && (
    <DangerZone>
      <DangerAction
        title="Deactivate this household"
        description="They can no longer sign in. Their members, balance and history are kept, and it can be reactivated."
      >
        <form method="POST">
          <input type="hidden" name="action" value="deactivate" />
          <button
            type="submit"
            class="btn btn-danger"
            onclick="return confirm('Deactivate this household? They will no longer be able to sign in.')"
          >Deactivate</button>
        </form>
      </DangerAction>
    </DangerZone>
  )}

  <FormDialog id="record-cash" title="Record a cash payment" submitLabel="Record" error={error} reopen={reopenDialog === 'record-cash'}>
    <input type="hidden" name="action" value="cash" />
    <input type="hidden" name="idempotency_key" value={`cash:${idempotencyKey}`} />
    <div class="grid grid-cols-[8rem_1fr] gap-4">
      <div>
        <label class="field-label" for="cash-amount">Amount</label>
        <input id="cash-amount" type="text" name="amount" inputmode="decimal" placeholder="10.00" required class="field" />
      </div>
      <div>
        <label class="field-label" for="cash-note">Note <span class="text-gray-400 font-normal">(optional)</span></label>
        <input id="cash-note" type="text" name="note" placeholder="Paid at Monday track" class="field" />
      </div>
    </div>
  </FormDialog>

  <FormDialog id="adjust-balance" title="Adjust the balance" submitLabel="Adjust" error={error} reopen={reopenDialog === 'adjust-balance'}>
    <input type="hidden" name="action" value="adjust" />
    <input type="hidden" name="idempotency_key" value={`adjust:${idempotencyKey}`} />
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="field-label" for="adjust-direction">Direction</label>
        <select id="adjust-direction" name="direction" class="field">
          <option value="add">Add credit</option>
          <option value="remove">Remove credit</option>
        </select>
      </div>
      <div>
        <label class="field-label" for="adjust-amount">Amount</label>
        <input id="adjust-amount" type="text" name="amount" inputmode="decimal" placeholder="5.00" required class="field" />
      </div>
    </div>
    <div>
      <label class="field-label" for="adjust-note">Note</label>
      <input id="adjust-note" type="text" name="note" placeholder="Why this adjustment is being made" required class="field" />
      <p class="text-xs text-gray-500 mt-1">The member sees the note as the reason on their own credit page, so write it for them.</p>
    </div>
  </FormDialog>

  <FormDialog id="transfer-balance" title="Transfer the balance to another household" submitLabel="Transfer" error={error} reopen={reopenDialog === 'transfer-balance'} wide>
    <input type="hidden" name="action" value="transfer" />
    <input type="hidden" name="idempotency_key" value={`transfer:${idempotencyKey}`} />
    <div class="grid grid-cols-1 sm:grid-cols-[1fr_8rem] gap-4">
      <div>
        <label class="field-label" for="transfer-target">To</label>
        <select id="transfer-target" name="target_id" required class="field">
          <option value="">Choose a household…</option>
          {otherHouseholds?.map((other) => (
            <option value={other.id}>{other.display_name} ({other.email})</option>
          ))}
        </select>
      </div>
      <div>
        <label class="field-label" for="transfer-amount">Amount</label>
        <input id="transfer-amount" type="text" name="amount" inputmode="decimal" placeholder={formatPounds(balancePence)} class="field" />
      </div>
    </div>
    <div>
      <label class="field-label" for="transfer-note">Note</label>
      <input id="transfer-note" type="text" name="note" placeholder="Contact email changed in Klubfunder" required class="field" />
    </div>
    <p class="text-xs text-gray-500">
      Leave the amount blank to move the whole balance. Both sides are written together, so neither can land on its own.
    </p>
  </FormDialog>

  {isSuperuser && (
    <FormDialog id="rename-household" title="Change display name" submitLabel="Save" error={error} reopen={reopenDialog === 'rename-household'}>
      <input type="hidden" name="action" value="update_name" />
      <div>
        <label class="field-label" for="household-display-name">Display name</label>
        <input id="household-display-name" type="text" name="display_name" value={principal.display_name} required class="field" />
      </div>
    </FormDialog>
  )}

  {isSuperuser && (
    <FormDialog id="change-access" title="Change access" submitLabel="Save access" error={error} reopen={reopenDialog === 'change-access'} wide>
      <input type="hidden" name="action" value="set_role" />
      <fieldset class="space-y-2">
        <legend class="field-label">What can {principal.display_name} do?</legend>
        {offeredRoles.map((role) => (
          <label class="flex items-start gap-3 border border-gray-200 rounded-md px-3 py-2.5 cursor-pointer has-[:checked]:border-gray-900 has-[:checked]:bg-gray-50">
            <input type="radio" name="role" value={role} checked={principal.role === role} class="mt-1" />
            <span>
              <span class="block font-medium capitalize">{role}</span>
              <span class="block text-sm text-gray-500">{ROLE_DESCRIPTIONS[role]}</span>
            </span>
          </label>
        ))}
      </fieldset>
    </FormDialog>
  )}
</AdminLayout>
