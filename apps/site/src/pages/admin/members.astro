---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { planMember } from '../../lib/people';
import { redirectAfterPost, takeFlash } from '../../lib/http/after-post';
import { newFormId, submittedFormId } from '../../lib/http/form-id';
import { orThrow } from '../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../lib/auth/signed-in';

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


const isSuperuser = actingPrincipal.role === 'superuser';

let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();

  if (action === 'add' && isSuperuser) {
    const plan = planMember(
      {
        principalId: field('principal_id'),
        firstName: field('first_name'),
        surname: field('surname'),
        dateOfBirth: field('date_of_birth'),
        gender: field('gender'),
        associationNumber: field('athletic_association_number'),
      },
      new Date().toISOString().slice(0, 10),
    );

    if ('problem' in plan) {
      error = plan.problem;
    } else {
      // Inserted under the id the form was drawn with, ignoring a conflict, so
      // a double click or a resubmitted form adds the child once.
      const id = submittedFormId(formData.get('form_id'));
      const { error: e } = await adminClient
        .from('members')
        .upsert({ ...(id ? { id } : {}), ...plan.row }, { onConflict: 'id', ignoreDuplicates: true });
      if (e) error = e.message;
      else success = `${plan.row.first_name} ${plan.row.surname} added.`;
    }
  }
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const members = orThrow(await adminClient
  .from('members')
  .select('id, first_name, surname, date_of_birth, status, is_active, principal_id')
  .order('surname'));

const principals = orThrow(await adminClient
  .from('principals')
  .select('id, email, display_name')
  .eq('is_active', true)
  .order('display_name'));

const principalById = new Map(
  (principals ?? []).map((p) => [p.id, p]),
);

function formatDob(dob: string): string {
  return new Date(dob).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<AdminLayout section="members" title="Members">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold">Members</h1>
        <p class="text-gray-500 mt-1">{members?.length ?? 0} total</p>
      </div>
      <a href="/admin/households" class="text-sm underline hover:text-gray-600"
        >View households →</a
      >
    </div>

    {
      error && (
        <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">
          {error}
        </div>
      )
    }
    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    {isSuperuser && <details class="mb-8 border border-gray-200 rounded-lg">
      <summary class="px-5 py-3 font-medium cursor-pointer select-none"
        >Add member</summary
      >
      <form method="POST" class="px-5 pb-5 pt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <input type="hidden" name="action" value="add" />
        <input type="hidden" name="form_id" value={newFormId()} />
        <div class="sm:col-span-2">
          <label class="block text-sm font-medium mb-1">Household</label>
          <select
            name="principal_id"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          >
            <option value="">— Select household —</option>
            {
              principals?.map((p) => (
                <option value={p.id}>
                  {p.display_name} ({p.email})
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">First name</label>
          <input
            type="text"
            name="first_name"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Surname</label>
          <input
            type="text"
            name="surname"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Date of birth</label>
          <input
            type="date"
            name="date_of_birth"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1"
            >Gender <span class="text-gray-400 font-normal">(optional)</span></label
          >
          <select
            name="gender"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          >
            <option value="">—</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1"
            >Athletics NI number <span class="text-gray-400 font-normal"
              >(optional)</span
            ></label
          >
          <input
            type="text"
            name="athletic_association_number"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div class="sm:col-span-2 flex justify-end">
          <button
            type="submit"
            class="bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
            >Add member</button
          >
        </div>
      </form>
    </details>}

    <label for="member-filter" class="sr-only">Filter members by name or email</label>

    <input
      id="member-filter"
      type="search"
      placeholder="Filter by name or email…"
      class="mb-4 w-full sm:w-80 border border-gray-300 rounded px-3 py-2 text-sm"
    />

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left">
            <th class="pb-3 font-semibold">Name</th>
            <th class="pb-3 font-semibold">Date of birth</th>
            <th class="pb-3 font-semibold">Household</th>
            <th class="pb-3 font-semibold">Status</th>
            <th class="pb-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {
            members?.map((m) => {
              const p = principalById.get(m.principal_id);
              return (
                <tr
                  class={!m.is_active ? 'opacity-50' : ''}
                  data-filter={`${m.first_name} ${m.surname} ${p?.display_name ?? ''} ${p?.email ?? ''}`.toLowerCase()}
                >
                  <td class="py-3 font-medium">
                    {m.first_name} {m.surname}
                  </td>
                  <td class="py-3 text-gray-600">{formatDob(m.date_of_birth)}</td>
                  <td class="py-3 text-gray-600">
                    {p ? (
                      <a
                        href={`/admin/households/${m.principal_id}`}
                        class="hover:underline"
                      >
                        {p.display_name}
                      </a>
                    ) : (
                      <span class="text-gray-400">—</span>
                    )}
                  </td>
                  <td class="py-3">
                    <span
                      class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                        m.status === 'paid'
                          ? 'bg-green-100 text-green-700'
                          : 'bg-gray-100 text-gray-500'
                      }`}
                    >
                      {m.status === 'paid' ? 'Active' : 'Lapsed'}
                    </span>
                  </td>
                  <td class="py-3 text-right">
                    <a
                      href={`/admin/members/${m.id}`}
                      class="text-xs underline hover:text-gray-600"
                    >
                      {isSuperuser ? 'Edit →' : 'View →'}
                    </a>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
      {
        (!members || members.length === 0) && (
          <p class="text-gray-500 text-sm py-8 text-center">No members found.</p>
        )
      }
    </div>
</AdminLayout>

<script>
  const input = document.getElementById('member-filter') as HTMLInputElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-filter]');

  input?.addEventListener('input', () => {
    const term = input.value.toLowerCase();
    rows.forEach((row) => {
      row.hidden = term !== '' && !row.dataset.filter?.includes(term);
    });
  });
</script>
