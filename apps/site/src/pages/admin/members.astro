---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { ageOn, isJunior, planMember } from '../../lib/people';
import { redirectAfterPost, takeFlash } from '../../lib/http/after-post';
import { newFormId, submittedFormId } from '../../lib/http/form-id';
import { orThrow } from '../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../lib/auth/signed-in';
import { everyRow } from '../../lib/supabase/every-row';
import { membersInNoSquad } from '../../lib/training/groups';
import { RECENT_TRAINING_DAYS, recentTrainingSince } from '../../lib/training/history';
import PageHeader from '../../components/admin/PageHeader.astro';
import Flash from '../../components/admin/Flash.astro';
import StatTiles from '../../components/admin/StatTiles.astro';
import StatTile from '../../components/admin/StatTile.astro';
import ListToolbar from '../../components/admin/ListToolbar.astro';
import ResourceTable from '../../components/admin/ResourceTable.astro';
import FormDialog from '../../components/admin/FormDialog.astro';
import Pill from '../../components/admin/Pill.astro';

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


const isSuperuser = actingPrincipal.role === 'superuser';

let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();

  if (action === 'add' && isSuperuser) {
    const plan = planMember(
      {
        principalId: field('principal_id'),
        firstName: field('first_name'),
        surname: field('surname'),
        dateOfBirth: field('date_of_birth'),
        gender: field('gender'),
        associationNumber: field('athletic_association_number'),
      },
      new Date().toISOString().slice(0, 10),
    );

    if ('problem' in plan) {
      error = plan.problem;
    } else {
      // Inserted under the id the form was drawn with, ignoring a conflict, so
      // a double click or a resubmitted form adds the child once.
      const id = submittedFormId(formData.get('form_id'));
      const { error: e } = await adminClient
        .from('members')
        .upsert({ ...(id ? { id } : {}), ...plan.row }, { onConflict: 'id', ignoreDuplicates: true });
      if (e) error = e.message;
      else success = `${plan.row.first_name} ${plan.row.surname} added.`;
    }
  }
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const members = orThrow(await adminClient
  .from('members')
  .select('id, first_name, surname, date_of_birth, status, is_active, principal_id, trains_free')
  .order('surname'));

const principals = orThrow(await adminClient
  .from('principals')
  .select('id, email, display_name')
  .eq('is_active', true)
  .order('display_name'));

const principalById = new Map(
  (principals ?? []).map((p) => [p.id, p]),
);

function formatDob(dob: string): string {
  return new Date(dob).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

// What the figures across the top are made from: who is in which squad, and
// who has signed in lately. Both grow with the club, so both page.
const now = new Date();
const today = now.toISOString().slice(0, 10);

const membershipRows = await everyRow((from, to) =>
  adminClient
    .from('member_groups')
    .select('member_id, group_id, group:group_id(name, is_active)')
    .order('member_id')
    .order('group_id')
    .range(from, to),
);

type MembershipRow = { member_id: string; group_id: string; group: { name: string; is_active: boolean } | null };

const squadNamesByMember = new Map<string, string[]>();
const runningGroupIds = new Set<string>();
for (const row of membershipRows satisfies MembershipRow[]) {
  if (!row.group?.is_active) continue;
  runningGroupIds.add(row.group_id);
  squadNamesByMember.set(row.member_id, [...(squadNamesByMember.get(row.member_id) ?? []), row.group.name].sort());
}

const recentSessions = orThrow(await adminClient
  .from('training_sessions')
  .select('id')
  .eq('is_cancelled', false)
  .gte('starts_at', recentTrainingSince(now).toISOString())
  .lte('starts_at', now.toISOString()));
const recentSessionIds = (recentSessions ?? []).map((row) => row.id);
const recentAttendance = recentSessionIds.length
  ? await everyRow((from, to) =>
      adminClient
        .from('attendance')
        .select('id, member_id')
        .in('session_id', recentSessionIds)
        .not('member_id', 'is', null)
        .order('id')
        .range(from, to),
    )
  : [];
const trainedRecently = new Set(recentAttendance.map((row) => row.member_id!));

const active = (members ?? []).filter((m) => m.is_active);
const activeIds = new Set(active.map((m) => m.id));
const inNoSquad = membersInNoSquad({
  activeMemberIds: activeIds,
  memberships: membershipRows.map((row) => ({ memberId: row.member_id, groupId: row.group_id })),
  runningGroupIds,
});
const juniors = active.filter((m) => isJunior(m.date_of_birth, today));
const recentlyActive = active.filter((m) => trainedRecently.has(m.id));

// Only active members carry tags, so a filter never turns up somebody who has
// left the club, and each figure counts exactly what its filter shows.
function tagsOf(m: { id: string; date_of_birth: string; is_active: boolean }): string {
  if (!m.is_active) return '';
  return [
    isJunior(m.date_of_birth, today) ? 'junior' : 'adult',
    inNoSquad.has(m.id) && 'no-squad',
    trainedRecently.has(m.id) && 'trained-recently',
  ]
    .filter(Boolean)
    .join(' ');
}
---

<AdminLayout section="members" title="Members">
  <PageHeader
    title="Members"
    subtitle={`${members?.length ?? 0} total · the people who train, each in a household`}
    primary={isSuperuser ? { label: 'Add member', dialog: 'new-member' } : undefined}
  />

  <Flash success={success} />

  <!-- The first tile shows the whole list again; each of the others narrows it. A safeguarding tile (children
       with no form on file) belongs here once Phase 8 lands. -->
  <StatTiles columns={4}>
    <StatTile label="Active members" value={active.length} hint={`show everyone · ${(members?.length ?? 0) - active.length} inactive`} reset list="members" />
    <StatTile label="Juniors" value={juniors.length} hint={`under 18, of ${active.length} active`} filter="junior" list="members" />
    <StatTile label="In no squad" value={inNoSquad.size} hint="no registrar expects them" filter="no-squad" list="members" />
    <StatTile
      label="Trained recently"
      value={recentlyActive.length}
      hint={`signed in, last ${RECENT_TRAINING_DAYS / 7} weeks`}
      filter="trained-recently"
      list="members"
    />
  </StatTiles>

  <ListToolbar list="members" placeholder="Search by name or household…" label="Search members by name, household or email" />

  <ResourceTable id="members" noMatches="No members match.">
    <thead>
      <tr>
        <th>Name</th>
        <th>Date of birth</th>
        <th>Household</th>
        <th>Squads</th>
        <th>Status</th>
        <th><span class="sr-only">Open</span></th>
      </tr>
    </thead>
    <tbody>
      {members?.map((m) => {
        const p = principalById.get(m.principal_id);
        const squads = squadNamesByMember.get(m.id) ?? [];
        return (
          <tr
            data-href={`/admin/members/${m.id}`}
            data-search={`${m.first_name} ${m.surname} ${p?.display_name ?? ''} ${p?.email ?? ''} ${squads.join(' ')}`.toLowerCase()}
            data-tags={tagsOf(m)}
            class:list={[!m.is_active && 'is-muted']}
          >
            <td class="cell-primary">
              <a href={`/admin/members/${m.id}`} class="row-link">{m.first_name} {m.surname}</a>
              {m.trains_free && <Pill tone="amber">Trains free</Pill>}
            </td>
            <td class="mobile-only cell-secondary">
              Age {ageOn(m.date_of_birth, today)}{p && ` · ${p.display_name}`}{squads.length > 0 && ` · ${squads.join(', ')}`}
            </td>
            <td class="mobile-only cell-trailing">
              {m.status !== 'paid' && <Pill tone="gray">Lapsed</Pill>}
            </td>
            <td class="text-gray-600 whitespace-nowrap">
              {formatDob(m.date_of_birth)}
              <span class="text-gray-400"> · {ageOn(m.date_of_birth, today)}</span>
            </td>
            <td class="text-gray-600">{p ? p.display_name : <span class="text-gray-400">—</span>}</td>
            <td class="text-gray-600">{squads.length > 0 ? squads.join(', ') : <span class="text-gray-400">—</span>}</td>
            <td>{m.status === 'paid' ? <Pill tone="green">Active</Pill> : <Pill tone="gray">Lapsed</Pill>}</td>
            <td class="row-chevron" aria-hidden="true"></td>
          </tr>
        );
      })}
    </tbody>
  </ResourceTable>
  {(!members || members.length === 0) && <p class="text-gray-500 text-sm py-8 text-center">No members found.</p>}

  {isSuperuser && (
    <FormDialog id="new-member" title="Add member" submitLabel="Add member" error={error} reopen wide>
      <input type="hidden" name="action" value="add" />
      <input type="hidden" name="form_id" value={newFormId()} />
      <div>
        <label class="field-label" for="member-household">Household</label>
        <select id="member-household" name="principal_id" required class="field">
          <option value="">— Select household —</option>
          {principals?.map((p) => (
            <option value={p.id}>{p.display_name} ({p.email})</option>
          ))}
        </select>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="field-label" for="member-first-name">First name</label>
          <input id="member-first-name" type="text" name="first_name" required class="field" />
        </div>
        <div>
          <label class="field-label" for="member-surname">Surname</label>
          <input id="member-surname" type="text" name="surname" required class="field" />
        </div>
        <div>
          <label class="field-label" for="member-dob">Date of birth</label>
          <input id="member-dob" type="date" name="date_of_birth" required class="field" />
        </div>
        <div>
          <label class="field-label" for="member-gender">Gender <span class="text-gray-400 font-normal">(optional)</span></label>
          <select id="member-gender" name="gender" class="field">
            <option value="">—</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="member-ani">Athletics NI number <span class="text-gray-400 font-normal">(optional)</span></label>
          <input id="member-ani" type="text" name="athletic_association_number" class="field" />
        </div>
      </div>
    </FormDialog>
  )}
</AdminLayout>
