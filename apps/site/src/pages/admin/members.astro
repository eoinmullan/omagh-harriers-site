---
import Layout from '../../layouts/Layout.astro';
import { createSupabaseAdminClient } from '../../lib/supabase/admin';

const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (!user) return Astro.redirect('/signin');

const adminClient = createSupabaseAdminClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SECRET_KEY,
);

const { data: actingPrincipal } = await Astro.locals.supabase
  .from('principals')
  .select('role')
  .eq('auth_user_id', user.id)
  .maybeSingle();

if (!actingPrincipal) return Astro.redirect('/signin');

const isSuperuser = actingPrincipal.role === 'superuser';

let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'add' && isSuperuser) {
    const principalId = formData.get('principal_id') as string;
    const firstName = (formData.get('first_name') as string)?.trim();
    const surname = (formData.get('surname') as string)?.trim();
    const dob = formData.get('date_of_birth') as string;
    const gender = (formData.get('gender') as string) || null;
    const aan = (formData.get('athletic_association_number') as string)?.trim() || null;

    if (!principalId || !firstName || !surname || !dob) {
      error = 'Principal, first name, surname, and date of birth are required.';
    } else {
      const { error: e } = await adminClient.from('members').insert({
        principal_id: principalId,
        first_name: firstName,
        surname,
        date_of_birth: dob,
        gender,
        athletic_association_number: aan,
        source: 'manual',
        status: 'paid',
      });
      if (e) error = e.message;
      else success = `${firstName} ${surname} added.`;
    }
  }
}

const { data: members } = await adminClient
  .from('members')
  .select('id, first_name, surname, date_of_birth, status, is_active, source, principal_id')
  .order('surname');

const { data: principals } = await adminClient
  .from('principals')
  .select('id, email, display_name')
  .eq('is_active', true)
  .order('display_name');

const principalById = new Map(
  (principals ?? []).map((p) => [p.id, p]),
);

function formatDob(dob: string): string {
  return new Date(dob).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<Layout title="Members — Admin — Omagh Harriers AC">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <p class="text-sm text-gray-500 mb-1">
          <a href="/members" class="hover:underline">Members area</a> / Admin
        </p>
        <h1 class="text-3xl font-bold">Members</h1>
        <p class="text-gray-500 mt-1">{members?.length ?? 0} total</p>
      </div>
      <a href="/admin/principals" class="text-sm underline hover:text-gray-600"
        >View principals →</a
      >
    </div>

    {
      error && (
        <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">
          {error}
        </div>
      )
    }
    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    {isSuperuser && <details class="mb-8 border border-gray-200 rounded-lg">
      <summary class="px-5 py-3 font-medium cursor-pointer select-none"
        >Add member</summary
      >
      <form method="POST" class="px-5 pb-5 pt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <input type="hidden" name="action" value="add" />
        <div class="sm:col-span-2">
          <label class="block text-sm font-medium mb-1">Principal</label>
          <select
            name="principal_id"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          >
            <option value="">— Select principal —</option>
            {
              principals?.map((p) => (
                <option value={p.id}>
                  {p.display_name} ({p.email})
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">First name</label>
          <input
            type="text"
            name="first_name"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Surname</label>
          <input
            type="text"
            name="surname"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Date of birth</label>
          <input
            type="date"
            name="date_of_birth"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1"
            >Gender <span class="text-gray-400 font-normal">(optional)</span></label
          >
          <select
            name="gender"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          >
            <option value="">—</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1"
            >Athletics NI number <span class="text-gray-400 font-normal"
              >(optional)</span
            ></label
          >
          <input
            type="text"
            name="athletic_association_number"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div class="sm:col-span-2 flex justify-end">
          <button
            type="submit"
            class="bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
            >Add member</button
          >
        </div>
      </form>
    </details>}

    <input
      id="member-filter"
      type="search"
      placeholder="Filter by name or email…"
      class="mb-4 w-full sm:w-80 border border-gray-300 rounded px-3 py-2 text-sm"
    />

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left">
            <th class="pb-3 font-semibold">Name</th>
            <th class="pb-3 font-semibold">Date of birth</th>
            <th class="pb-3 font-semibold">Principal</th>
            <th class="pb-3 font-semibold">Status</th>
            <th class="pb-3 font-semibold">Source</th>
            <th class="pb-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {
            members?.map((m) => {
              const p = principalById.get(m.principal_id);
              return (
                <tr
                  class={!m.is_active ? 'opacity-50' : ''}
                  data-filter={`${m.first_name} ${m.surname} ${p?.display_name ?? ''} ${p?.email ?? ''}`.toLowerCase()}
                >
                  <td class="py-3 font-medium">
                    {m.first_name} {m.surname}
                  </td>
                  <td class="py-3 text-gray-600">{formatDob(m.date_of_birth)}</td>
                  <td class="py-3 text-gray-600">
                    {p ? (
                      <a
                        href={`/admin/principals/${m.principal_id}`}
                        class="hover:underline"
                      >
                        {p.display_name}
                      </a>
                    ) : (
                      <span class="text-gray-400">—</span>
                    )}
                  </td>
                  <td class="py-3">
                    <span
                      class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                        m.status === 'paid'
                          ? 'bg-green-100 text-green-700'
                          : 'bg-gray-100 text-gray-500'
                      }`}
                    >
                      {m.status === 'paid' ? 'Active' : 'Lapsed'}
                    </span>
                  </td>
                  <td class="py-3 text-gray-400 text-xs">{m.source}</td>
                  <td class="py-3 text-right">
                    <a
                      href={`/admin/members/${m.id}`}
                      class="text-xs underline hover:text-gray-600"
                    >
                      {isSuperuser ? 'Edit →' : 'View →'}
                    </a>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
      {
        (!members || members.length === 0) && (
          <p class="text-gray-500 text-sm py-8 text-center">No members found.</p>
        )
      }
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('member-filter') as HTMLInputElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-filter]');

  input?.addEventListener('input', () => {
    const term = input.value.toLowerCase();
    rows.forEach((row) => {
      row.hidden = term !== '' && !row.dataset.filter?.includes(term);
    });
  });
</script>
