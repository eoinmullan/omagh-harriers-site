---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../../lib/supabase/admin';
import { ageOn, FREE_TRAINING_REASON_MAX, planFreeTraining, planMemberEdit } from '../../../lib/people';
import { redirectAfterPost, takeFlash } from '../../../lib/http/after-post';
import { orThrow } from '../../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../../lib/auth/signed-in';
import { everyRow } from '../../../lib/supabase/every-row';
import { formatClubDateTime } from '../../../lib/training/club-time';
import { formatPounds } from '../../../lib/credits/money';
import { chargesBySignIn, recentAttendance } from '../../../lib/training/history';
import RecordHeader from '../../../components/admin/RecordHeader.astro';
import Figure from '../../../components/admin/Figure.astro';
import Flash from '../../../components/admin/Flash.astro';
import Pill from '../../../components/admin/Pill.astro';
import Section from '../../../components/admin/Section.astro';
import SummaryList from '../../../components/admin/SummaryList.astro';
import SummaryRow from '../../../components/admin/SummaryRow.astro';
import ResourceTable from '../../../components/admin/ResourceTable.astro';
import FormDialog from '../../../components/admin/FormDialog.astro';
import DangerZone from '../../../components/admin/DangerZone.astro';
import DangerAction from '../../../components/admin/DangerAction.astro';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/members');

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


const isSuperuser = actingPrincipal.role === 'superuser';

let error: string | null = null;
let success: string | null = null;
let failedAction: string | null = null;
let typedFreeTraining: { trainsFree: boolean; reason: string } | undefined;

// Free training is a money decision, like the ledger forms on a household,
// so any admin may make it. The rest of this page edits who the member is,
// which is a superuser's.
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();

  if (action === 'free_training') {
    typedFreeTraining = { trainsFree: field('trains_free') === 'yes', reason: field('trains_free_reason') };
    const plan = planFreeTraining({ trainsFree: field('trains_free'), reason: field('trains_free_reason') });
    if ('problem' in plan) {
      error = plan.problem;
    } else {
      const { error: e } = await adminClient.from('members').update(plan.update).eq('id', id);
      if (e) error = e.message;
      else success = plan.update.trains_free ? 'They now train free.' : 'They now pay for sessions.';
    }
  } else if (!isSuperuser) {
    error = 'Only a superuser can change that.';
  } else if (action === 'update') {
    const plan = planMemberEdit(
      {
        firstName: field('first_name'),
        surname: field('surname'),
        dateOfBirth: field('date_of_birth'),
        gender: field('gender'),
        associationNumber: field('athletic_association_number'),
        status: field('status'),
      },
      new Date().toISOString().slice(0, 10),
    );

    if ('problem' in plan) {
      error = plan.problem;
    } else {
      const { error: e } = await adminClient.from('members').update(plan.update).eq('id', id);
      if (e) error = e.message;
      else success = 'Member updated.';
    }
  } else if (action === 'deactivate') {
    const { error: e } = await adminClient
      .from('members')
      .update({ is_active: false, status: 'lapsed' })
      .eq('id', id);
    if (e) error = e.message;
    else success = 'Member deactivated.';
  } else if (action === 'reactivate') {
    const { error: e } = await adminClient
      .from('members')
      .update({ is_active: true, status: 'paid' })
      .eq('id', id);
    if (e) error = e.message;
    else success = 'Member reactivated.';
  }
  if (error) failedAction = action;
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const member = orThrow(await adminClient
  .from('members')
  .select('*')
  .eq('id', id)
  .maybeSingle());

if (!member) return Astro.redirect('/admin/members');

const principal = orThrow(await adminClient
  .from('principals')
  .select('id, email, display_name')
  .eq('id', member.principal_id)
  .maybeSingle());

// The nights this member was signed in. One member's history is small, but it
// grows every week for as long as they train, so it pages like any read that
// grows with the club's history.
const attendanceRows = await everyRow((from, to) =>
  adminClient
    .from('attendance')
    .select('id, session:session_id(id, starts_at, price_pence, group:group_id(name))')
    .eq('member_id', member.id)
    .order('id')
    .range(from, to),
);

const sessionDebits = await everyRow((from, to) =>
  adminClient
    .from('credit_transactions')
    .select('idempotency_key, amount_pence')
    .eq('member_id', member.id)
    .eq('type', 'session')
    .order('id')
    .range(from, to),
);
const charges = chargesBySignIn(sessionDebits);

const squadRows = orThrow(await adminClient
  .from('member_groups')
  .select('group:group_id(id, name, is_active)')
  .eq('member_id', member.id));

const squads = ((squadRows ?? []) as { group: { id: string; name: string; is_active: boolean } | null }[])
  .flatMap((row) => (row.group ? [row.group] : []))
  .sort((a, b) => a.name.localeCompare(b.name, 'en-GB'));

const today = new Date().toISOString().slice(0, 10);

function formatDob(dob: string): string {
  return new Date(dob).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

type AttendanceWithSession = {
  id: string;
  session: { id: string; starts_at: string; price_pence: number; group: { name: string } | null } | null;
};

// A refused form opens again with what was chosen, not what's stored.
const freeTrainingForm = typedFreeTraining ?? {
  trainsFree: member.trains_free,
  reason: member.trains_free_reason ?? '',
};

const history = recentAttendance(
  (attendanceRows satisfies AttendanceWithSession[]).flatMap((row) =>
    row.session
      ? [{
          sessionId: row.session.id,
          startsAt: row.session.starts_at,
          squad: row.session.group?.name ?? 'Session',
          chargedPence: charges.get(row.id) ?? 0,
        }]
      : [],
  ),
);
---

<AdminLayout section="members" title={`${member.first_name} ${member.surname}`} breadcrumb={[{ label: 'Members', href: '/admin/members' }, { label: `${member.first_name} ${member.surname}` }]}>
  <Flash success={success} error={failedAction === 'update' || failedAction === 'free_training' ? null : error} />

  <RecordHeader title={`${member.first_name} ${member.surname}`}>
    <Fragment slot="pills">
      {member.status === 'paid' ? <Pill tone="green">Active</Pill> : <Pill tone="gray">Lapsed</Pill>}
      {!member.is_active && <Pill tone="gray">Inactive</Pill>}
      {member.trains_free && <Pill tone="amber">Trains free</Pill>}
    </Fragment>
    {principal && (
      <p>
        Household: <a href={`/admin/households/${principal.id}`} class="underline hover:text-gray-700">{principal.display_name}</a>
        <span class="text-gray-400"> · {principal.email}</span>
      </p>
    )}
    <Fragment slot="figures">
      <Figure label="Age" value={ageOn(member.date_of_birth, today)} />
      <Figure
        label="Sessions"
        value={history.total}
        hint={history.shown[0] ? `last ${formatClubDateTime(history.shown[0].startsAt)}` : 'not trained yet'}
      />
    </Fragment>
  </RecordHeader>

  <Section title="Details">
    {isSuperuser && (
      <button slot="actions" type="button" data-open-dialog="edit-member" class="btn btn-secondary btn-sm">Edit details</button>
    )}
    <SummaryList>
      <SummaryRow label="Date of birth">{formatDob(member.date_of_birth)}</SummaryRow>
      <SummaryRow label="Gender">{member.gender ?? <span class="text-gray-400">Not given</span>}</SummaryRow>
      <SummaryRow label="Athletics NI number">
        {member.athletic_association_number ?? <span class="text-gray-400">None</span>}
      </SummaryRow>
      <SummaryRow label="Household">
        {principal ? (
          <a href={`/admin/households/${principal.id}`} class="underline hover:text-gray-700">{principal.display_name}</a>
        ) : (
          '—'
        )}
        {principal && (
          <a slot="action" href={`/admin/households/${principal.id}#credit`} class="btn-link text-sm">Statement</a>
        )}
      </SummaryRow>
      <SummaryRow label="Sessions">
        {member.trains_free ? (
          <>Trains free <span class="text-gray-500">· {member.trains_free_reason}</span></>
        ) : (
          "Paid from the household's credit"
        )}
        <button slot="action" type="button" data-open-dialog="free-training" class="btn-link text-sm">Change</button>
      </SummaryRow>
      <SummaryRow label="Source">{member.source}</SummaryRow>
      <SummaryRow label="Status">
        {member.is_active ? (member.status === 'paid' ? 'Active (paid)' : 'Lapsed') : 'Inactive'}
        {isSuperuser && !member.is_active && (
          <form slot="action" method="POST">
            <input type="hidden" name="action" value="reactivate" />
            <button type="submit" class="btn btn-secondary btn-sm">Reactivate</button>
          </form>
        )}
      </SummaryRow>
    </SummaryList>
  </Section>

  <Section title="Squads" count={squads.length} description="The registrar app expects them at these squads' sessions.">
    {squads.length > 0 ? (
      <ResourceTable>
        <thead>
          <tr>
            <th>Squad</th>
            <th>Status</th>
            <th><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          {squads.map((squad) => (
            <tr data-href={`/admin/squads/${squad.id}`}>
              <td class="cell-primary"><a href={`/admin/squads/${squad.id}`} class="row-link">{squad.name}</a></td>
              <td class="cell-trailing">{squad.is_active ? <Pill tone="green">Active</Pill> : <Pill tone="gray">Retired</Pill>}</td>
              <td class="row-chevron" aria-hidden="true"></td>
            </tr>
          ))}
        </tbody>
      </ResourceTable>
    ) : (
      <p class="text-sm text-gray-500">
        In no squad. Add them from a squad's own page in <a href="/admin/squads" class="underline">Squads</a>.
      </p>
    )}
  </Section>

  <Section title="Training history" count={history.total}>
    {history.total === 0 ? (
      <p class="text-sm text-gray-500">Not signed in at any session yet.</p>
    ) : (
      <>
        <ResourceTable>
          <thead>
            <tr>
              <th>Session</th>
              <th>When</th>
              <th class="num">Charged</th>
              <th><span class="sr-only">Open</span></th>
            </tr>
          </thead>
          <tbody>
            {history.shown.map((session) => (
              <tr data-href={`/admin/sessions/${session.sessionId}`}>
                <td class="cell-primary"><a href={`/admin/sessions/${session.sessionId}`} class="row-link">{session.squad}</a></td>
                <td class="cell-secondary text-gray-600 whitespace-nowrap">{formatClubDateTime(session.startsAt)}</td>
                <td class="num cell-trailing">{session.chargedPence === 0 ? 'Free' : formatPounds(session.chargedPence)}</td>
                <td class="row-chevron" aria-hidden="true"></td>
              </tr>
            ))}
          </tbody>
        </ResourceTable>
        {history.total > history.shown.length && (
          <p class="text-xs text-gray-500 mt-2">The {history.shown.length} most recent of {history.total} sessions.</p>
        )}
      </>
    )}
  </Section>

  {isSuperuser && member.is_active && (
    <DangerZone>
      <DangerAction
        title="Deactivate this member"
        description="They drop off the registrar app and are marked lapsed. Their history is kept, and they can be reactivated."
      >
        <form method="POST">
          <input type="hidden" name="action" value="deactivate" />
          <button type="submit" class="btn btn-danger" onclick="return confirm('Deactivate this member?')">Deactivate</button>
        </form>
      </DangerAction>
    </DangerZone>
  )}

  <FormDialog
    id="free-training"
    title="Sessions"
    submitLabel="Save"
    error={error}
    reopen={failedAction === 'free_training'}
  >
    <input type="hidden" name="action" value="free_training" />
    <fieldset class="space-y-1">
      <legend class="sr-only">How their sessions are paid</legend>
      <label class="flex items-center gap-3 min-h-11">
        <input type="radio" name="trains_free" value="no" checked={!freeTrainingForm.trainsFree} class="h-5 w-5" />
        <span>Paid from the household's credit</span>
      </label>
      <label class="flex items-center gap-3 min-h-11">
        <input type="radio" name="trains_free" value="yes" checked={freeTrainingForm.trainsFree} class="h-5 w-5" />
        <span>Trains free</span>
      </label>
    </fieldset>
    <div>
      <label class="field-label" for="trains-free-reason">Why they train free</label>
      <input
        id="trains-free-reason"
        type="text"
        name="trains_free_reason"
        value={freeTrainingForm.reason}
        maxlength={FREE_TRAINING_REASON_MAX}
        placeholder="Coach, Life member…"
        class="field"
      />
      <p class="text-xs text-gray-500 mt-1">
        Their sign-ins are recorded and nothing is taken. Sessions already signed into keep what they cost.
      </p>
    </div>
  </FormDialog>

  {isSuperuser && (
    <FormDialog id="edit-member" title="Edit details" submitLabel="Save changes" error={error} reopen={failedAction === 'update'} wide>
      <input type="hidden" name="action" value="update" />
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="field-label" for="edit-first-name">First name</label>
          <input id="edit-first-name" type="text" name="first_name" value={member.first_name} required class="field" />
        </div>
        <div>
          <label class="field-label" for="edit-surname">Surname</label>
          <input id="edit-surname" type="text" name="surname" value={member.surname} required class="field" />
        </div>
        <div>
          <label class="field-label" for="edit-dob">Date of birth</label>
          <input id="edit-dob" type="date" name="date_of_birth" value={member.date_of_birth} required class="field" />
        </div>
        <div>
          <label class="field-label" for="edit-gender">Gender</label>
          <select id="edit-gender" name="gender" class="field">
            <option value="" selected={!member.gender}>—</option>
            <option value="Male" selected={member.gender === 'Male'}>Male</option>
            <option value="Female" selected={member.gender === 'Female'}>Female</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="edit-ani">Athletics NI number</label>
          <input id="edit-ani" type="text" name="athletic_association_number" value={member.athletic_association_number ?? ''} class="field" />
        </div>
        <div>
          <label class="field-label" for="edit-status">Status</label>
          <select id="edit-status" name="status" class="field">
            <option value="paid" selected={member.status === 'paid'}>Active (paid)</option>
            <option value="lapsed" selected={member.status === 'lapsed'}>Lapsed</option>
          </select>
        </div>
      </div>
    </FormDialog>
  )}
</AdminLayout>
