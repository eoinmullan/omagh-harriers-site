---
import Layout from '../../../layouts/Layout.astro';
import { createSupabaseAdminClient } from '../../../lib/supabase/admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/members');

const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (!user) return Astro.redirect('/signin');

const adminClient = createSupabaseAdminClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SECRET_KEY,
);

const { data: actingPrincipal } = await Astro.locals.supabase
  .from('principals')
  .select('role')
  .eq('auth_user_id', user.id)
  .maybeSingle();

if (!actingPrincipal) return Astro.redirect('/signin');

const isSuperuser = actingPrincipal.role === 'superuser';

let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST' && isSuperuser) {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'update') {
    const firstName = (formData.get('first_name') as string)?.trim();
    const surname = (formData.get('surname') as string)?.trim();
    const dob = formData.get('date_of_birth') as string;
    const gender = (formData.get('gender') as string) || null;
    const aan = (formData.get('athletic_association_number') as string)?.trim() || null;
    const status = formData.get('status') as 'paid' | 'lapsed';

    if (!firstName || !surname || !dob) {
      error = 'First name, surname, and date of birth are required.';
    } else {
      const { error: e } = await adminClient
        .from('members')
        .update({ first_name: firstName, surname, date_of_birth: dob, gender, athletic_association_number: aan, status })
        .eq('id', id);
      if (e) error = e.message;
      else success = 'Member updated.';
    }
  } else if (action === 'deactivate') {
    const { error: e } = await adminClient
      .from('members')
      .update({ is_active: false, status: 'lapsed' })
      .eq('id', id);
    if (e) error = e.message;
    else success = 'Member deactivated.';
  } else if (action === 'reactivate') {
    const { error: e } = await adminClient
      .from('members')
      .update({ is_active: true, status: 'paid' })
      .eq('id', id);
    if (e) error = e.message;
    else success = 'Member reactivated.';
  }
}

const { data: member } = await adminClient
  .from('members')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!member) return Astro.redirect('/admin/members');

const { data: principal } = await adminClient
  .from('principals')
  .select('id, email, display_name')
  .eq('id', member.principal_id)
  .maybeSingle();
---

<Layout title={`${member.first_name} ${member.surname} — Admin — Omagh Harriers AC`}>
  <div class="max-w-2xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-6">
      <a href="/members" class="hover:underline">Members area</a> /
      <a href="/admin/members" class="hover:underline">Members</a> /
      {member.first_name}
      {member.surname}
    </p>

    {
      error && (
        <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">
          {error}
        </div>
      )
    }
    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    <div class="bg-gray-50 border border-gray-200 rounded-lg px-6 py-5 mb-8">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-2xl font-bold">
            {member.first_name}
            {member.surname}
          </h1>
          {
            principal && (
              <p class="text-gray-500 mt-1">
                Principal:{' '}
                <a
                  href={`/admin/principals/${principal.id}`}
                  class="hover:underline"
                >
                  {principal.display_name} ({principal.email})
                </a>
              </p>
            )
          }
        </div>
        <div class="flex gap-2">
          <span
            class={`text-xs font-medium px-2 py-1 rounded-full ${
              member.status === 'paid'
                ? 'bg-green-100 text-green-700'
                : 'bg-gray-100 text-gray-500'
            }`}
          >
            {member.status === 'paid' ? 'Active' : 'Lapsed'}
          </span>
          {
            !member.is_active && (
              <span class="text-xs font-medium px-2 py-1 rounded-full bg-gray-100 text-gray-500">
                Inactive
              </span>
            )
          }
        </div>
      </div>
      <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
        <div>
          <dt class="text-gray-500">Source</dt>
          <dd>{member.source}</dd>
        </div>
        {
          member.athletic_association_number && (
            <div>
              <dt class="text-gray-500">Athletics NI number</dt>
              <dd>{member.athletic_association_number}</dd>
            </div>
          )
        }
      </dl>
    </div>

    {isSuperuser && (
      <>
        <!-- Edit form -->
        <section class="mb-8">
          <h2 class="text-lg font-semibold mb-4">Edit details</h2>
          <form method="POST" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <input type="hidden" name="action" value="update" />
            <div>
              <label class="block text-sm font-medium mb-1">First name</label>
              <input
                type="text"
                name="first_name"
                value={member.first_name}
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Surname</label>
              <input
                type="text"
                name="surname"
                value={member.surname}
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Date of birth</label>
              <input
                type="date"
                name="date_of_birth"
                value={member.date_of_birth}
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Gender</label>
              <select
                name="gender"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              >
                <option value="" selected={!member.gender}>—</option>
                <option value="Male" selected={member.gender === 'Male'}>Male</option>
                <option value="Female" selected={member.gender === 'Female'}>Female</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Athletics NI number</label>
              <input
                type="text"
                name="athletic_association_number"
                value={member.athletic_association_number ?? ''}
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Status</label>
              <select
                name="status"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              >
                <option value="paid" selected={member.status === 'paid'}>Active (paid)</option>
                <option value="lapsed" selected={member.status === 'lapsed'}>Lapsed</option>
              </select>
            </div>
            <div class="sm:col-span-2 flex justify-end">
              <button
                type="submit"
                class="bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
                >Save changes</button
              >
            </div>
          </form>
        </section>

        <!-- Deactivate / Reactivate -->
        <section>
          <h2 class="text-lg font-semibold mb-3">Account status</h2>
          {
            member.is_active ? (
              <form method="POST">
                <input type="hidden" name="action" value="deactivate" />
                <button
                  type="submit"
                  class="border border-red-300 text-red-600 rounded px-4 py-2 text-sm hover:bg-red-50 transition-colors"
                  onclick="return confirm('Deactivate this member?')"
                >
                  Deactivate
                </button>
              </form>
            ) : (
              <form method="POST">
                <input type="hidden" name="action" value="reactivate" />
                <button
                  type="submit"
                  class="border border-green-300 text-green-700 rounded px-4 py-2 text-sm hover:bg-green-50 transition-colors"
                >
                  Reactivate
                </button>
              </form>
            )
          }
        </section>
      </>
    )}
  </div>
</Layout>
