---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../../lib/supabase/admin';
import { planMemberEdit } from '../../../lib/people';
import { redirectAfterPost, takeFlash } from '../../../lib/http/after-post';
import { orThrow } from '../../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../../lib/auth/signed-in';
import { everyRow } from '../../../lib/supabase/every-row';
import { formatClubDateTime } from '../../../lib/training/club-time';
import { formatPounds } from '../../../lib/credits/money';
import { recentAttendance } from '../../../lib/training/history';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/members');

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


const isSuperuser = actingPrincipal.role === 'superuser';

let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST' && isSuperuser) {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();

  if (action === 'update') {
    const plan = planMemberEdit(
      {
        firstName: field('first_name'),
        surname: field('surname'),
        dateOfBirth: field('date_of_birth'),
        gender: field('gender'),
        associationNumber: field('athletic_association_number'),
        status: field('status'),
      },
      new Date().toISOString().slice(0, 10),
    );

    if ('problem' in plan) {
      error = plan.problem;
    } else {
      const { error: e } = await adminClient.from('members').update(plan.update).eq('id', id);
      if (e) error = e.message;
      else success = 'Member updated.';
    }
  } else if (action === 'deactivate') {
    const { error: e } = await adminClient
      .from('members')
      .update({ is_active: false, status: 'lapsed' })
      .eq('id', id);
    if (e) error = e.message;
    else success = 'Member deactivated.';
  } else if (action === 'reactivate') {
    const { error: e } = await adminClient
      .from('members')
      .update({ is_active: true, status: 'paid' })
      .eq('id', id);
    if (e) error = e.message;
    else success = 'Member reactivated.';
  }
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const member = orThrow(await adminClient
  .from('members')
  .select('*')
  .eq('id', id)
  .maybeSingle());

if (!member) return Astro.redirect('/admin/members');

const principal = orThrow(await adminClient
  .from('principals')
  .select('id, email, display_name')
  .eq('id', member.principal_id)
  .maybeSingle());

// The nights this member was signed in. One member's history is small, but it
// grows every week for as long as they train, so it pages like any read that
// grows with the club's history.
const attendanceRows = await everyRow((from, to) =>
  adminClient
    .from('attendance')
    .select('id, session:session_id(id, starts_at, price_pence, group:group_id(name))')
    .eq('member_id', member.id)
    .order('id')
    .range(from, to),
);

type AttendanceWithSession = {
  id: string;
  session: { id: string; starts_at: string; price_pence: number; group: { name: string } | null } | null;
};

const history = recentAttendance(
  (attendanceRows satisfies AttendanceWithSession[]).flatMap((row) =>
    row.session
      ? [{
          sessionId: row.session.id,
          startsAt: row.session.starts_at,
          squad: row.session.group?.name ?? 'Session',
          pricePence: row.session.price_pence,
        }]
      : [],
  ),
);
---

<AdminLayout section="members" title={`${member.first_name} ${member.surname}`} breadcrumb={[{ label: 'Members', href: '/admin/members' }, { label: `${member.first_name} ${member.surname}` }]}>

    {
      error && (
        <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">
          {error}
        </div>
      )
    }
    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    <div class="bg-gray-50 border border-gray-200 rounded-lg px-6 py-5 mb-8">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-2xl font-bold">
            {member.first_name}
            {member.surname}
          </h1>
          {
            principal && (
              <p class="text-gray-500 mt-1">
                Household:{' '}
                <a
                  href={`/admin/households/${principal.id}`}
                  class="hover:underline"
                >
                  {principal.display_name} ({principal.email})
                </a>
              </p>
            )
          }
        </div>
        <div class="flex gap-2">
          <span
            class={`text-xs font-medium px-2 py-1 rounded-full ${
              member.status === 'paid'
                ? 'bg-green-100 text-green-700'
                : 'bg-gray-100 text-gray-500'
            }`}
          >
            {member.status === 'paid' ? 'Active' : 'Lapsed'}
          </span>
          {
            !member.is_active && (
              <span class="text-xs font-medium px-2 py-1 rounded-full bg-gray-100 text-gray-500">
                Inactive
              </span>
            )
          }
        </div>
      </div>
      <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
        <div>
          <dt class="text-gray-500">Source</dt>
          <dd>{member.source}</dd>
        </div>
        {
          member.athletic_association_number && (
            <div>
              <dt class="text-gray-500">Athletics NI number</dt>
              <dd>{member.athletic_association_number}</dd>
            </div>
          )
        }
      </dl>
    </div>

    <section class="mb-8">
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-lg font-semibold">Training history</h2>
        {principal && (
          <a href={`/admin/households/${principal.id}#credit`} class="text-sm underline hover:text-gray-600"
            >Household statement →</a
          >
        )}
      </div>
      {history.total === 0 ? (
        <p class="text-sm text-gray-500">Not signed in at any session yet.</p>
      ) : (
        <>
          <ul class="divide-y divide-gray-100 border-y border-gray-100 text-sm">
            {history.shown.map((session) => (
              <li class="flex items-center justify-between py-2.5">
                <a href={`/admin/sessions/${session.sessionId}`} class="hover:underline">
                  <span class="font-medium">{session.squad}</span>
                  <span class="text-gray-500"> · {formatClubDateTime(session.startsAt)}</span>
                </a>
                <span class="text-gray-600 tabular-nums">
                  {session.pricePence === 0 ? 'Free' : formatPounds(session.pricePence)}
                </span>
              </li>
            ))}
          </ul>
          {history.total > history.shown.length && (
            <p class="text-xs text-gray-500 mt-2">
              The {history.shown.length} most recent of {history.total} sessions.
            </p>
          )}
        </>
      )}
    </section>

    {isSuperuser && (
      <>
        <!-- Edit form -->
        <section class="mb-8">
          <h2 class="text-lg font-semibold mb-4">Edit details</h2>
          <form method="POST" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <input type="hidden" name="action" value="update" />
            <div>
              <label class="block text-sm font-medium mb-1">First name</label>
              <input
                type="text"
                name="first_name"
                value={member.first_name}
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Surname</label>
              <input
                type="text"
                name="surname"
                value={member.surname}
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Date of birth</label>
              <input
                type="date"
                name="date_of_birth"
                value={member.date_of_birth}
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Gender</label>
              <select
                name="gender"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              >
                <option value="" selected={!member.gender}>—</option>
                <option value="Male" selected={member.gender === 'Male'}>Male</option>
                <option value="Female" selected={member.gender === 'Female'}>Female</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Athletics NI number</label>
              <input
                type="text"
                name="athletic_association_number"
                value={member.athletic_association_number ?? ''}
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Status</label>
              <select
                name="status"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              >
                <option value="paid" selected={member.status === 'paid'}>Active (paid)</option>
                <option value="lapsed" selected={member.status === 'lapsed'}>Lapsed</option>
              </select>
            </div>
            <div class="sm:col-span-2 flex justify-end">
              <button
                type="submit"
                class="bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
                >Save changes</button
              >
            </div>
          </form>
        </section>

        <!-- Deactivate / Reactivate -->
        <section>
          <h2 class="text-lg font-semibold mb-3">Account status</h2>
          {
            member.is_active ? (
              <form method="POST">
                <input type="hidden" name="action" value="deactivate" />
                <button
                  type="submit"
                  class="border border-red-300 text-red-600 rounded px-4 py-2 text-sm hover:bg-red-50 transition-colors"
                  onclick="return confirm('Deactivate this member?')"
                >
                  Deactivate
                </button>
              </form>
            ) : (
              <form method="POST">
                <input type="hidden" name="action" value="reactivate" />
                <button
                  type="submit"
                  class="border border-green-300 text-green-700 rounded px-4 py-2 text-sm hover:bg-green-50 transition-colors"
                >
                  Reactivate
                </button>
              </form>
            )
          }
        </section>
      </>
    )}
</AdminLayout>
