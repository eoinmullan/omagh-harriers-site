---
import Layout from '../../layouts/Layout.astro';
import { createSupabaseAdminClient } from '../../lib/supabase/admin';

const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (!user) return Astro.redirect('/signin');

const adminClient = createSupabaseAdminClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SECRET_KEY,
);

const { data: actingPrincipal } = await Astro.locals.supabase
  .from('principals')
  .select('role')
  .eq('auth_user_id', user.id)
  .maybeSingle();

if (!actingPrincipal) return Astro.redirect('/signin');

let error: string | null = null;
let success: string | null = null;

const isSuperuser = actingPrincipal.role === 'superuser';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'add' && isSuperuser) {
    const email = (formData.get('email') as string)?.trim().toLowerCase();
    const displayName = (formData.get('display_name') as string)?.trim();

    if (!email || !displayName) {
      error = 'Email and display name are required.';
    } else {
      const { data: authUser, error: authError } =
        await adminClient.auth.admin.createUser({
          email,
          email_confirm: true,
        });

      if (authError) {
        error = authError.message;
      } else {
        const { error: insertError } = await adminClient
          .from('principals')
          .insert({
            email,
            display_name: displayName,
            auth_user_id: authUser.user.id,
            source: 'manual',
            role: 'member',
          });

        if (insertError) {
          await adminClient.auth.admin.deleteUser(authUser.user.id);
          error = insertError.message;
        } else {
          success = `${displayName} (${email}) added.`;
        }
      }
    }
  }
}

const { data: principals } = await adminClient
  .from('principals')
  .select('id, email, display_name, role, is_active, source')
  .order('display_name');

const { data: activeMembers } = await adminClient
  .from('members')
  .select('principal_id')
  .eq('is_active', true);

const memberCountByPrincipal = new Map<string, number>();
for (const m of activeMembers ?? []) {
  memberCountByPrincipal.set(
    m.principal_id,
    (memberCountByPrincipal.get(m.principal_id) ?? 0) + 1,
  );
}
---

<Layout title="Principals — Admin — Omagh Harriers AC">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <p class="text-sm text-gray-500 mb-1">
          <a href="/members" class="hover:underline">Members' area</a> / Admin
        </p>
        <h1 class="text-3xl font-bold">Principals</h1>
        <p class="text-gray-500 mt-1">
          {principals?.length ?? 0} total
        </p>
      </div>
      <a href="/admin/members" class="text-sm underline hover:text-gray-600"
        >View members →</a
      >
    </div>

    {
      error && (
        <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">
          {error}
        </div>
      )
    }
    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    {isSuperuser && <details class="mb-8 border border-gray-200 rounded-lg">
      <summary class="px-5 py-3 font-medium cursor-pointer select-none"
        >Add principal</summary
      >
      <form
        method="POST"
        class="px-5 pb-5 pt-3 grid grid-cols-1 sm:grid-cols-3 gap-4"
      >
        <input type="hidden" name="action" value="add" />
        <div>
          <label class="block text-sm font-medium mb-1">Email</label>
          <input
            type="email"
            name="email"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Display name</label>
          <input
            type="text"
            name="display_name"
            required
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-end">
          <button
            type="submit"
            class="w-full bg-black text-white rounded px-4 py-2 text-sm hover:bg-gray-800 transition-colors"
            >Add</button
          >
        </div>
      </form>
    </details>}

    <input
      id="principal-filter"
      type="search"
      placeholder="Filter by name or email…"
      class="mb-4 w-full sm:w-80 border border-gray-300 rounded px-3 py-2 text-sm"
    />

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left">
            <th class="pb-3 font-semibold">Name</th>
            <th class="pb-3 font-semibold">Email</th>
            <th class="pb-3 font-semibold">Role</th>
            <th class="pb-3 font-semibold">Members</th>
            <th class="pb-3 font-semibold">Status</th>
            <th class="pb-3 font-semibold">Source</th>
            <th class="pb-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {
            principals?.map((p) => (
              <tr
                class={!p.is_active ? 'opacity-50' : ''}
                data-filter={`${p.display_name} ${p.email}`.toLowerCase()}
              >
                <td class="py-3 font-medium">{p.display_name}</td>
                <td class="py-3 text-gray-600">{p.email}</td>
                <td class="py-3">
                  <span
                    class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                      p.role === 'superuser'
                        ? 'bg-purple-100 text-purple-700'
                        : p.role === 'admin'
                          ? 'bg-blue-100 text-blue-700'
                          : 'bg-gray-100 text-gray-600'
                    }`}
                  >
                    {p.role}
                  </span>
                </td>
                <td class="py-3">
                  {memberCountByPrincipal.get(p.id) ?? 0}
                </td>
                <td class="py-3">
                  <span
                    class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                      p.is_active
                        ? 'bg-green-100 text-green-700'
                        : 'bg-gray-100 text-gray-500'
                    }`}
                  >
                    {p.is_active ? 'Active' : 'Inactive'}
                  </span>
                </td>
                <td class="py-3 text-gray-400 text-xs">{p.source}</td>
                <td class="py-3 text-right">
                  <a
                    href={`/admin/principals/${p.id}`}
                    class="text-xs underline hover:text-gray-600"
                  >
                    View →
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {
        (!principals || principals.length === 0) && (
          <p class="text-gray-500 text-sm py-8 text-center">
            No principals found.
          </p>
        )
      }
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('principal-filter') as HTMLInputElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-filter]');

  input?.addEventListener('input', () => {
    const term = input.value.toLowerCase();
    rows.forEach((row) => {
      row.hidden = term !== '' && !row.dataset.filter?.includes(term);
    });
  });
</script>
