---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { redirectAfterPost, takeFlash } from '../../lib/http/after-post';
import { newFormId, submittedFormId } from '../../lib/http/form-id';
import { everyRow } from '../../lib/supabase/every-row';
import { DEFAULT_SESSION_PRICE_PENCE } from '../../lib/credits/ledger';
import { formatPounds } from '../../lib/credits/money';
import { clubDayKey, formatClubDateTime, formatClubNight, formatClubTime } from '../../lib/training/club-time';
import {
  byClubDay,
  DEFAULT_SESSION_START_TIME,
  pastWindow,
  planNewSession,
  partitionByStart,
  sessionStartTimes,
  startFromDayAndTime,
  type SessionGroup,
} from '../../lib/training/sessions';
import { formatClubDate } from '../../lib/training/club-time';
import { orThrow } from '../../lib/supabase/or-throw';
import PageHeader from '../../components/admin/PageHeader.astro';
import Flash from '../../components/admin/Flash.astro';
import StatTiles from '../../components/admin/StatTiles.astro';
import StatTile from '../../components/admin/StatTile.astro';
import ResourceTable from '../../components/admin/ResourceTable.astro';
import FormDialog from '../../components/admin/FormDialog.astro';
import Pill from '../../components/admin/Pill.astro';
import { whoIsSignedIn } from '../../lib/auth/signed-in';
import {
  averageTurnout,
  countHeads,
  rollUpSessions,
  summariseSessionCash,
  type SessionAttendanceRow,
  type SessionLedgerRow,
} from '../../lib/training/session-cash';

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


async function loadGroups(): Promise<SessionGroup[]> {
  const data = orThrow(await adminClient.from('groups').select('id, name, is_active').order('name'));
  return (data ?? []).map((row) => ({
    id: row.id,
    name: row.name,
    isActive: row.is_active,
  }));
}

let error: string | null = null;
let success: string | null = null;
// What the dialog shows: today at six at the usual price for a fresh form,
// what was sent for one that came back with a problem. The price is a real
// value rather than a placeholder, so what's on screen is what's saved.
const draft = {
  groupId: '',
  day: clubDayKey(new Date()),
  time: DEFAULT_SESSION_START_TIME,
  note: '',
  price: formatPounds(DEFAULT_SESSION_PRICE_PENCE),
};

// The session a successful form created, so its day's phones can be told.
let changedSession: { id?: string; startsAt: string } | undefined;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();

  Object.assign(draft, {
    groupId: field('group_id'),
    day: field('day'),
    time: field('time'),
    note: field('note'),
    price: field('price'),
  });

  const plan = planNewSession({
    groupId: field('group_id'),
    startsAt: startFromDayAndTime(field('day'), field('time')),
    note: field('note'),
    price: field('price'),
    groups: await loadGroups(),
    createdBy: actingPrincipal.id,
  });

  if ('problem' in plan) {
    error = plan.problem;
  } else {
    // Inserted under the id the form was drawn with, ignoring a conflict, so
    // a double click or a resubmitted form makes one session, not two.
    const id = submittedFormId(formData.get('form_id'));
    const { error: insertError } = await adminClient
      .from('training_sessions')
      .upsert({ ...plan.insert, ...(id ? { id } : {}) }, { onConflict: 'id', ignoreDuplicates: true });

    if (insertError) {
      console.error('[admin/sessions] session insert failed:', insertError);
      error = insertError.message;
    } else {
      const group = (await loadGroups()).find((candidate) => candidate.id === plan.insert.group_id);
      success = `${group?.name ?? 'Session'} created for ${formatClubDateTime(plan.insert.starts_at)}.`;
      changedSession = { id, startsAt: plan.insert.starts_at };
    }
  }
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient, changedSession);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const groups = await loadGroups();
const runningGroups = groups.filter((group) => group.isActive);

// Upcoming sessions are always shown; the past is shown twelve weeks at a
// time (pastWindow), so this page does the same work however long the club
// has kept records. The counts tell the admin how much is outside the window.
const pastRange = pastWindow({ until: Astro.url.searchParams.get('until') });
const nowIso = new Date().toISOString();
const windowEndIso = pastRange.to.toISOString();
// A window's edges are UTC midnights. Labelling a day from its midday keeps the
// date the same in Omagh time, summer or winter. Labelling the instant before
// midnight showed the next day during British Summer Time.
const middayOf = (date: Date) => `${date.toISOString().slice(0, 10)}T12:00:00Z`;
const SESSION_COLUMNS = 'id, starts_at, note, price_pence, is_cancelled, group:group_id(name)';

const [upcomingRows, pastRows, pastTotal, earlierTotal] = await Promise.all([
  adminClient.from('training_sessions').select(SESSION_COLUMNS).gte('starts_at', nowIso),
  adminClient
    .from('training_sessions')
    .select(SESSION_COLUMNS)
    .gte('starts_at', pastRange.from.toISOString())
    .lt('starts_at', windowEndIso < nowIso ? windowEndIso : nowIso),
  adminClient.from('training_sessions').select('id', { count: 'exact', head: true }).lt('starts_at', nowIso),
  adminClient
    .from('training_sessions')
    .select('id', { count: 'exact', head: true })
    .lt('starts_at', pastRange.from.toISOString()),
]);

const sessionRows = [...(orThrow(upcomingRows) ?? []), ...(orThrow(pastRows) ?? [])];
orThrow(pastTotal);
orThrow(earlierTotal);
const pastCount = pastTotal.count ?? 0;
const earlierCount = earlierTotal.count ?? 0;

type SessionListRow = {
  id: string;
  starts_at: string;
  note: string | null;
  price_pence: number;
  is_cancelled: boolean;
  group: { name: string } | null;
};

const sessions = ((sessionRows ?? []) satisfies SessionListRow[]).map((row) => ({
  ...row,
  startsAt: row.starts_at,
}));

const { upcoming, past } = partitionByStart(sessions);

// Headcount and cash for the past sessions on screen, which is the view the
// committee actually reads. The money rule stays in session-cash.ts, which is
// tested and must agree with the registrar's cash.ts, so the rows come here
// rather than the sum being worked out in SQL. Only this window's sessions,
// so the `.in()` list holds at most twelve weeks of ids. `everyRow` still
// pages, because twelve weeks of a busy club can pass 1000 rows.
const pastIds = past.map((session) => session.id);
const [attendanceRows, ledgerRows] = pastIds.length
  ? await Promise.all([
      everyRow((from, to) =>
        adminClient
          .from('attendance')
          .select('id, session_id, member_id, guest_id, amount_paid_pence, recorded_by')
          .in('session_id', pastIds)
          .order('id')
          .range(from, to),
      ),
      everyRow((from, to) =>
        adminClient
          .from('credit_transactions')
          .select('id, session_id, type, amount_pence, created_by')
          .in('session_id', pastIds)
          .order('id')
          .range(from, to),
      ),
    ])
  : [[], []];

const attendanceBySession = new Map<string, SessionAttendanceRow[]>();
for (const row of attendanceRows) {
  attendanceBySession.set(row.session_id, [
    ...(attendanceBySession.get(row.session_id) ?? []),
    {
      memberId: row.member_id,
      guestId: row.guest_id,
      amountPaidPence: row.amount_paid_pence,
      recordedBy: row.recorded_by,
    },
  ]);
}

const ledgerBySession = new Map<string, SessionLedgerRow[]>();
for (const row of ledgerRows) {
  if (!row.session_id) continue;
  ledgerBySession.set(row.session_id, [
    ...(ledgerBySession.get(row.session_id) ?? []),
    { type: row.type, amountPence: row.amount_pence, recordedBy: row.created_by },
  ]);
}

const pastWithFigures = past.map((session) => {
  const attendance = attendanceBySession.get(session.id) ?? [];
  return {
    ...session,
    heads: countHeads(attendance),
    cash: summariseSessionCash({
      ledger: ledgerBySession.get(session.id) ?? [],
      attendance,
    }),
  };
});


// The figures across the top are for the sessions that ran in the window on
// screen, so they always agree with the Past list beneath them.
const ran = pastWithFigures.filter((session) => !session.is_cancelled);
const windowTotals = rollUpSessions(ran);
const turnout = averageTurnout(ran);
const upcomingOn = upcoming.filter((session) => !session.is_cancelled);
const windowLabel = pastRange.isRecent
  ? 'last 12 weeks'
  : `${formatClubDate(middayOf(pastRange.from))} to ${formatClubDate(middayOf(new Date(pastRange.to.getTime() - 24 * 60 * 60 * 1000)))}`;

// One list at a time, chosen with the Coming up and Sessions run tiles.
// Coming up opens first while there's anything in it; an earlier window
// (?until=) is always about the past.
const requested = Astro.url.searchParams.get('show');
const showPast = requested === 'past' || (requested !== 'upcoming' && (upcoming.length === 0 || !pastRange.isRecent));
const untilParam = pastRange.isRecent ? '' : `&until=${Astro.url.searchParams.get('until')}`;

---

<AdminLayout section="sessions" title="Sessions">
  <PageHeader
    title="Training sessions"
    subtitle={`${upcomingOn.length} coming up · ${pastCount} run`}
    primary={runningGroups.length > 0 ? { label: 'New session', dialog: 'new-session' } : undefined}
  />

  <Flash success={success} />

  {runningGroups.length === 0 && (
    <div class="mb-6 border border-dashed border-gray-300 rounded-lg px-6 py-6">
      <p class="font-medium">Add a squad first</p>
      <p class="text-sm text-gray-600 mt-1">
        Every session belongs to a squad, and the registrar's list of who to expect comes from it.{' '}
        <a href="/admin/squads" class="underline">Add the squads that train this week →</a>
      </p>
    </div>
  )}

  <StatTiles columns={4}>
    <StatTile
      label="Coming up"
      value={upcomingOn.length}
      hint={upcomingOn[0] ? `next ${formatClubDate(upcomingOn[0].startsAt)}` : 'nothing scheduled'}
      view={{ href: '/admin/sessions?show=upcoming', current: !showPast }}
    />
    <StatTile
      label="Sessions run"
      value={ran.length}
      hint={windowLabel}
      view={{ href: `/admin/sessions?show=past${untilParam}`, current: showPast }}
    />
    <StatTile label="Average turnout" value={turnout ?? '—'} hint={`${windowTotals.heads.total} sign-ins, ${windowLabel}`} />
    <StatTile label="Money collected" value={formatPounds(windowTotals.cash.totalPence)} hint={windowLabel} />
  </StatTiles>

  <h2 class="text-lg font-semibold mb-3">
    {showPast ? (pastRange.isRecent ? 'Run in the last 12 weeks' : `Run ${windowLabel}`) : 'Coming up'}
  </h2>

  {!showPast && (
    upcoming.length > 0 ? (
      <ResourceTable>
        <thead>
          <tr>
            <th>Date</th>
            <th>Session</th>
            <th class="num">Price</th>
            <th>Status</th>
            <th><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          {upcoming.map((session) => (
            <tr data-href={`/admin/sessions/${session.id}`} class:list={[session.is_cancelled && 'is-muted']}>
              <td class="mobile-only cell-primary">
                <a href={`/admin/sessions/${session.id}`} class:list={['row-link', session.is_cancelled && 'line-through']}>
                  {session.group?.name}
                </a>
              </td>
              <td class="mobile-only cell-secondary">
                {formatClubNight(session.startsAt)} · {formatClubTime(session.startsAt)}{session.note && ` · ${session.note}`}
              </td>
              <td class="mobile-only cell-trailing text-sm">
                {session.is_cancelled ? <Pill tone="gray">Cancelled</Pill> : session.price_pence === 0 ? 'Free' : formatPounds(session.price_pence)}
              </td>
              <td class="whitespace-nowrap text-gray-600">{formatClubDate(session.startsAt)}</td>
              <td>
                <a href={`/admin/sessions/${session.id}`} class:list={['row-link', session.is_cancelled && 'line-through']}>
                  {session.group?.name}
                </a>
                <p class="text-xs text-gray-500">
                  {formatClubTime(session.startsAt)}{session.note && ` · ${session.note}`}
                </p>
              </td>
              <td class="num">{session.price_pence === 0 ? 'Free' : formatPounds(session.price_pence)}</td>
              <td>{session.is_cancelled ? <Pill tone="gray">Cancelled</Pill> : <Pill tone="blue">Scheduled</Pill>}</td>
              <td class="row-chevron" aria-hidden="true"></td>
            </tr>
          ))}
        </tbody>
      </ResourceTable>
    ) : (
      <div class="border border-dashed border-gray-300 rounded-lg px-6 py-10 text-center">
        <p class="font-medium">Nothing scheduled</p>
        <p class="text-sm text-gray-500 mt-1">A registrar can also start a session from the app on the night.</p>
        {runningGroups.length > 0 && (
          <button type="button" data-open-dialog="new-session" class="btn btn-primary mt-4">New session</button>
        )}
      </div>
    )
  )}

  {showPast && (
    <>
      {!pastRange.isRecent && (
        <p class="mb-3 text-sm"><a href="/admin/sessions?show=past" class="underline hover:text-gray-600">Back to the most recent</a></p>
      )}
      {pastWithFigures.length > 0 ? (
        <ResourceTable>
          <thead>
            <tr>
              <th>Date</th>
              <th>Session</th>
              <th class="num">Attended</th>
              <th class="num">Money collected</th>
              <th>Status</th>
              <th><span class="sr-only">Open</span></th>
            </tr>
          </thead>
          {/* One row per session, newest first, each with its own date, like
              every other list. A day is how the committee asks about a night,
              so a day that ran more than one session ends with a total row,
              added up by the same rule as each session's own figures. */}
          <tbody>
            {byClubDay(pastWithFigures).map(({ sessions: onTheDay }) => {
              const ranThatDay = onTheDay.filter((session) => !session.is_cancelled);
              const dayTotal = ranThatDay.length > 1 ? rollUpSessions(ranThatDay) : undefined;
              return (
                <>
                  {onTheDay.map((session) => (
                    <tr data-href={`/admin/sessions/${session.id}`} class:list={[session.is_cancelled && 'is-muted']}>
                      <td class="mobile-only cell-primary">
                        <a href={`/admin/sessions/${session.id}`} class:list={['row-link', session.is_cancelled && 'line-through']}>
                          {session.group?.name}
                        </a>
                      </td>
                      <td class="mobile-only cell-secondary">
                        {formatClubNight(session.startsAt)} · {formatClubTime(session.startsAt)} · {session.heads.total} attended
                        {session.heads.guests > 0 && ` (${session.heads.guests} guest${session.heads.guests === 1 ? '' : 's'})`}
                      </td>
                      <td class="mobile-only cell-trailing">
                        {session.is_cancelled ? <Pill tone="gray">Cancelled</Pill> : <span class="font-medium tabular-nums">{formatPounds(session.cash.totalPence)}</span>}
                      </td>
                      <td class="whitespace-nowrap text-gray-600">{formatClubDate(session.startsAt)}</td>
                      <td>
                        <a href={`/admin/sessions/${session.id}`} class:list={['row-link', session.is_cancelled && 'line-through']}>
                          {session.group?.name}
                        </a>
                        <p class="text-xs text-gray-500">
                          {formatClubTime(session.startsAt)}{session.note && ` · ${session.note}`}
                        </p>
                      </td>
                      <td class="num">
                        {session.heads.total}
                        {session.heads.guests > 0 && (
                          <span class="text-xs text-gray-500">
                            {' '}({session.heads.guests} guest{session.heads.guests === 1 ? '' : 's'})
                          </span>
                        )}
                      </td>
                      <td class="num">{formatPounds(session.cash.totalPence)}</td>
                      <td>{session.is_cancelled ? <Pill tone="gray">Cancelled</Pill> : <Pill tone="green">Ran</Pill>}</td>
                      <td class="row-chevron" aria-hidden="true"></td>
                    </tr>
                  ))}
                  {dayTotal && (
                    <tr class="subtotal">
                      <td class="mobile-only cell-primary">Day total</td>
                      <td class="mobile-only cell-secondary">
                        {formatClubNight(onTheDay[0].startsAt)} · {dayTotal.heads.total} attended
                      </td>
                      <td class="mobile-only cell-trailing tabular-nums">{formatPounds(dayTotal.cash.totalPence)}</td>
                      <td class="whitespace-nowrap text-gray-600">{formatClubDate(onTheDay[0].startsAt)}</td>
                      <td>Day total</td>
                      <td class="num">{dayTotal.heads.total}</td>
                      <td class="num">{formatPounds(dayTotal.cash.totalPence)}</td>
                      <td colspan="2"></td>
                    </tr>
                  )}
                </>
              );
            })}
          </tbody>
        </ResourceTable>
      ) : (
        <p class="text-gray-500 text-sm">
          {pastCount === 0 ? 'No session has run yet.' : 'No sessions ran in these twelve weeks.'}
        </p>
      )}
      {earlierCount > 0 && (
        <p class="mt-4">
          <a href={`/admin/sessions?show=past&until=${pastRange.earlierUntil}`} class="text-sm underline hover:text-gray-600">
            The twelve weeks before ({earlierCount} older session{earlierCount === 1 ? '' : 's'} in all) →
          </a>
        </p>
      )}
      <p class="text-xs text-gray-400 mt-4">
        Money collected is the cash taken at the session, less anything handed back, plus what its guests paid. Session
        charges are left out — they move credit out of a household's pot rather than money into the tin.
      </p>
    </>
  )}

  {runningGroups.length > 0 && (
    <FormDialog id="new-session" title="New session" submitLabel="Create session" error={error} reopen>
      <input type="hidden" name="form_id" value={newFormId()} />
      <div>
        <label class="field-label" for="session-group">Squad</label>
        <select id="session-group" name="group_id" required class="field">
          <option value="">Choose a squad…</option>
          {runningGroups.map((group) => (
            <option value={group.id} selected={group.id === draft.groupId}>{group.name}</option>
          ))}
        </select>
      </div>
      <div class="grid grid-cols-[1fr_7rem] gap-4">
        <div>
          <label class="field-label" for="session-day">Date</label>
          <input id="session-day" type="date" name="day" required value={draft.day} class="field" />
        </div>
        <div>
          <label class="field-label" for="session-time">Time</label>
          <select id="session-time" name="time" required class="field">
            {sessionStartTimes().map((time) => (
              <option value={time} selected={time === draft.time}>{time}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="grid grid-cols-[1fr_7rem] gap-4">
        <div>
          <label class="field-label" for="session-note">Note <span class="text-gray-400 font-normal">(optional)</span></label>
          <input id="session-note" type="text" name="note" value={draft.note} class="field" />
        </div>
        <div>
          <label class="field-label" for="session-price">Price</label>
          <input id="session-price" type="text" name="price" inputmode="decimal" value={draft.price} class="field" />
        </div>
      </div>
    </FormDialog>
  )}
</AdminLayout>
