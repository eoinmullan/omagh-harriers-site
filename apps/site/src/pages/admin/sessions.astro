---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { redirectAfterPost, takeFlash } from '../../lib/http/after-post';
import { newFormId, submittedFormId } from '../../lib/http/form-id';
import { everyRow } from '../../lib/supabase/every-row';
import { DEFAULT_SESSION_PRICE_PENCE } from '../../lib/credits/ledger';
import { formatPounds } from '../../lib/credits/money';
import { clubDayKey, formatClubDateTime } from '../../lib/training/club-time';
import {
  DEFAULT_SESSION_START_TIME,
  pastWindow,
  planNewSession,
  partitionByStart,
  sessionStartTimes,
  startFromDayAndTime,
  type SessionGroup,
} from '../../lib/training/sessions';
import { formatClubDate } from '../../lib/training/club-time';
import { orThrow } from '../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../lib/auth/signed-in';
import {
  countHeads,
  summariseSessionCash,
  type SessionAttendanceRow,
  type SessionLedgerRow,
} from '../../lib/training/session-cash';

const { principal: actingPrincipal } = whoIsSignedIn(Astro.locals);

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


async function loadGroups(): Promise<SessionGroup[]> {
  const data = orThrow(await adminClient.from('groups').select('id, name, is_active').order('name'));
  return (data ?? []).map((row) => ({
    id: row.id,
    name: row.name,
    isActive: row.is_active,
  }));
}

let error: string | null = null;
let success: string | null = null;
// What the dialog shows: today at six for a fresh form, what was sent for one
// that came back with a problem.
const draft = { groupId: '', day: clubDayKey(new Date()), time: DEFAULT_SESSION_START_TIME, note: '', price: '' };

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();

  Object.assign(draft, {
    groupId: field('group_id'),
    day: field('day'),
    time: field('time'),
    note: field('note'),
    price: field('price'),
  });

  const plan = planNewSession({
    groupId: field('group_id'),
    startsAt: startFromDayAndTime(field('day'), field('time')),
    note: field('note'),
    price: field('price'),
    groups: await loadGroups(),
    createdBy: actingPrincipal.id,
  });

  if ('problem' in plan) {
    error = plan.problem;
  } else {
    // Inserted under the id the form was drawn with, ignoring a conflict, so
    // a double click or a resubmitted form makes one session, not two.
    const id = submittedFormId(formData.get('form_id'));
    const { error: insertError } = await adminClient
      .from('training_sessions')
      .upsert({ ...plan.insert, ...(id ? { id } : {}) }, { onConflict: 'id', ignoreDuplicates: true });

    if (insertError) {
      console.error('[admin/sessions] session insert failed:', insertError);
      error = insertError.message;
    } else {
      const group = (await loadGroups()).find((candidate) => candidate.id === plan.insert.group_id);
      success = `${group?.name ?? 'Session'} created for ${formatClubDateTime(plan.insert.starts_at)}.`;
    }
  }
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) return redirectAfterPost(Astro, success);
success = takeFlash(Astro.cookies);

const groups = await loadGroups();
const runningGroups = groups.filter((group) => group.isActive);

// Upcoming sessions are always shown; the past is shown twelve weeks at a
// time (pastWindow), so this page does the same work however long the club
// has kept records. The counts tell the admin how much is outside the window.
const pastRange = pastWindow({ until: Astro.url.searchParams.get('until') });
const nowIso = new Date().toISOString();
const windowEndIso = pastRange.to.toISOString();
// A window's edges are UTC midnights. Labelling a day from its midday keeps the
// date the same in Omagh time, summer or winter. Labelling the instant before
// midnight showed the next day during British Summer Time.
const middayOf = (date: Date) => `${date.toISOString().slice(0, 10)}T12:00:00Z`;
const SESSION_COLUMNS = 'id, starts_at, note, price_pence, is_cancelled, group:group_id(name)';

const [upcomingRows, pastRows, pastTotal, earlierTotal] = await Promise.all([
  adminClient.from('training_sessions').select(SESSION_COLUMNS).gte('starts_at', nowIso),
  adminClient
    .from('training_sessions')
    .select(SESSION_COLUMNS)
    .gte('starts_at', pastRange.from.toISOString())
    .lt('starts_at', windowEndIso < nowIso ? windowEndIso : nowIso),
  adminClient.from('training_sessions').select('id', { count: 'exact', head: true }).lt('starts_at', nowIso),
  adminClient
    .from('training_sessions')
    .select('id', { count: 'exact', head: true })
    .lt('starts_at', pastRange.from.toISOString()),
]);

const sessionRows = [...(orThrow(upcomingRows) ?? []), ...(orThrow(pastRows) ?? [])];
orThrow(pastTotal);
orThrow(earlierTotal);
const pastCount = pastTotal.count ?? 0;
const earlierCount = earlierTotal.count ?? 0;

type SessionListRow = {
  id: string;
  starts_at: string;
  note: string | null;
  price_pence: number;
  is_cancelled: boolean;
  group: { name: string } | null;
};

const sessions = ((sessionRows ?? []) satisfies SessionListRow[]).map((row) => ({
  ...row,
  startsAt: row.starts_at,
}));

const { upcoming, past } = partitionByStart(sessions);

// Headcount and cash for the past sessions on screen, which is the view the
// committee actually reads. The money rule stays in session-cash.ts, which is
// tested and must agree with the registrar's cash.ts, so the rows come here
// rather than the sum being worked out in SQL. Only this window's sessions,
// so the `.in()` list holds at most twelve weeks of ids. `everyRow` still
// pages, because twelve weeks of a busy club can pass 1000 rows.
const pastIds = past.map((session) => session.id);
const [attendanceRows, ledgerRows] = pastIds.length
  ? await Promise.all([
      everyRow((from, to) =>
        adminClient
          .from('attendance')
          .select('id, session_id, member_id, guest_id, amount_paid_pence, recorded_by')
          .in('session_id', pastIds)
          .order('id')
          .range(from, to),
      ),
      everyRow((from, to) =>
        adminClient
          .from('credit_transactions')
          .select('id, session_id, type, amount_pence, created_by')
          .in('session_id', pastIds)
          .order('id')
          .range(from, to),
      ),
    ])
  : [[], []];

const attendanceBySession = new Map<string, SessionAttendanceRow[]>();
for (const row of attendanceRows) {
  attendanceBySession.set(row.session_id, [
    ...(attendanceBySession.get(row.session_id) ?? []),
    {
      memberId: row.member_id,
      guestId: row.guest_id,
      amountPaidPence: row.amount_paid_pence,
      recordedBy: row.recorded_by,
    },
  ]);
}

const ledgerBySession = new Map<string, SessionLedgerRow[]>();
for (const row of ledgerRows) {
  if (!row.session_id) continue;
  ledgerBySession.set(row.session_id, [
    ...(ledgerBySession.get(row.session_id) ?? []),
    { type: row.type, amountPence: row.amount_pence, recordedBy: row.created_by },
  ]);
}

const pastWithFigures = past.map((session) => {
  const attendance = attendanceBySession.get(session.id) ?? [];
  return {
    ...session,
    heads: countHeads(attendance),
    cash: summariseSessionCash({
      ledger: ledgerBySession.get(session.id) ?? [],
      attendance,
    }),
  };
});

const usualPrice = formatPounds(DEFAULT_SESSION_PRICE_PENCE);
---

<AdminLayout section="sessions" title="Sessions">
    <div class="flex items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold">Training sessions</h1>
        <p class="text-gray-500 mt-1">
          {upcoming.length} coming up · {pastCount} run
        </p>
      </div>
      <div class="flex items-center gap-4">
        <a href="/admin/squads" class="text-sm underline hover:text-gray-600">Manage squads →</a>
        {runningGroups.length > 0 && (
          <button
            type="button"
            data-open-dialog="new-session"
            class="bg-black text-white rounded px-4 py-2 text-sm font-medium hover:bg-gray-800 transition-colors"
            >New session</button
          >
        )}
      </div>
    </div>

    {
      success && (
        <div class="mb-6 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-sm">
          {success}
        </div>
      )
    }

    {
      runningGroups.length === 0 ? (
        <div class="mb-10 border border-gray-200 rounded-lg px-5 py-4">
          <h2 class="text-lg font-semibold mb-1">Add a squad first</h2>
          <p class="text-sm text-gray-600">
            Every session belongs to a squad, and the registrar's list of who to
            expect comes from it.{' '}
            <a href="/admin/squads" class="underline">Add the squads that train this week →</a>
          </p>
        </div>
      ) : (
        <dialog
          id="new-session"
          aria-labelledby="new-session-title"
          data-open-on-load={error ? '' : undefined}
          class="w-full max-w-md rounded-lg p-0 shadow-xl backdrop:bg-black/40"
        >
          <form method="POST" class="p-6 space-y-4">
            <h2 id="new-session-title" class="text-lg font-semibold">New session</h2>
            {error && (
              <p class="p-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm">{error}</p>
            )}
            <input type="hidden" name="form_id" value={newFormId()} />
            <div>
              <label class="block text-sm font-medium mb-1" for="session-group">Squad</label>
              <select
                id="session-group"
                name="group_id"
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
              >
                <option value="">Choose a squad…</option>
                {runningGroups.map((group) => (
                  <option value={group.id} selected={group.id === draft.groupId}>{group.name}</option>
                ))}
              </select>
            </div>
            <div class="grid grid-cols-[1fr_7rem] gap-4">
              <div>
                <label class="block text-sm font-medium mb-1" for="session-day">Date</label>
                <input
                  id="session-day"
                  type="date"
                  name="day"
                  required
                  value={draft.day}
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-1" for="session-time">Time</label>
                <select
                  id="session-time"
                  name="time"
                  required
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                >
                  {sessionStartTimes().map((time) => (
                    <option value={time} selected={time === draft.time}>{time}</option>
                  ))}
                </select>
              </div>
            </div>
            <div class="grid grid-cols-[1fr_7rem] gap-4">
              <div>
                <label class="block text-sm font-medium mb-1" for="session-note">
                  Note <span class="text-gray-400 font-normal">(optional)</span>
                </label>
                <input
                  id="session-note"
                  type="text"
                  name="note"
                  value={draft.note}
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-1" for="session-price">Price</label>
                <input
                  id="session-price"
                  type="text"
                  name="price"
                  inputmode="decimal"
                  placeholder={usualPrice}
                  value={draft.price}
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                />
              </div>
            </div>
            <div class="flex justify-end gap-3 pt-2">
              <button
                type="button"
                data-close-dialog
                class="rounded px-4 py-2 text-sm border border-gray-300 hover:bg-gray-50"
                >Cancel</button
              >
              <button
                type="submit"
                class="bg-black text-white rounded px-4 py-2 text-sm font-medium hover:bg-gray-800 transition-colors"
                >Create session</button
              >
            </div>
          </form>
        </dialog>
      )
    }

    <section class="mb-10">
      <h2 class="text-lg font-semibold mb-4">Coming up ({upcoming.length})</h2>

      {
        upcoming.length > 0 ? (
          <ul class="divide-y divide-gray-100 border-t border-b border-gray-200">
            {upcoming.map((session) => (
              <li class="py-3 flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <p class:list={['font-medium', session.is_cancelled && 'line-through']}>
                    {session.group?.name}
                  </p>
                  <p class="text-sm text-gray-500">
                    {formatClubDateTime(session.startsAt)} · {formatPounds(session.price_pence)}
                  </p>
                  {session.note && <p class="text-sm text-gray-600 mt-0.5">{session.note}</p>}
                </div>
                <div class="flex items-center gap-3">
                  {session.is_cancelled && (
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">
                      Cancelled
                    </span>
                  )}
                  <a
                    href={`/admin/sessions/${session.id}`}
                    class="text-xs underline hover:text-gray-600"
                  >
                    Open →
                  </a>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-500 text-sm">Nothing scheduled yet.</p>
        )
      }
    </section>

    <section>
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
        <h2 class="text-lg font-semibold">
          {pastRange.isRecent
            ? `Run in the last 12 weeks (${past.length})`
            : `Run ${formatClubDate(middayOf(pastRange.from))} to ${formatClubDate(middayOf(new Date(pastRange.to.getTime() - 24 * 60 * 60 * 1000)))} (${past.length})`}
        </h2>
        {!pastRange.isRecent && (
          <a href="/admin/sessions" class="text-sm underline hover:text-gray-600">Back to the most recent</a>
        )}
      </div>

      {
        pastWithFigures.length > 0 ? (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-200 text-left">
                  <th class="pb-3 font-semibold">Session</th>
                  <th class="pb-3 font-semibold text-right">Here</th>
                  <th class="pb-3 font-semibold text-right">Money collected</th>
                  <th class="pb-3" />
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {pastWithFigures.map((session) => (
                  <tr class={session.is_cancelled ? 'opacity-50' : ''}>
                    <td class="py-3">
                      <p class:list={['font-medium', session.is_cancelled && 'line-through']}>
                        {session.group?.name}
                      </p>
                      <p class="text-xs text-gray-500">{formatClubDateTime(session.startsAt)}</p>
                      {session.note && <p class="text-xs text-gray-600">{session.note}</p>}
                    </td>
                    <td class="py-3 text-right">
                      {session.heads.total}
                      {session.heads.guests > 0 && (
                        <span class="text-xs text-gray-500">
                          {' '}
                          ({session.heads.guests} guest{session.heads.guests === 1 ? '' : 's'})
                        </span>
                      )}
                    </td>
                    <td class="py-3 text-right">{formatPounds(session.cash.totalPence)}</td>
                    <td class="py-3 text-right">
                      <a
                        href={`/admin/sessions/${session.id}`}
                        class="text-xs underline hover:text-gray-600"
                      >
                        Open →
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-gray-500 text-sm">
            {pastCount === 0 ? 'No session has run yet.' : 'No sessions ran in these twelve weeks.'}
          </p>
        )
      }
      {
        earlierCount > 0 && (
          <p class="mt-4">
            <a href={`/admin/sessions?until=${pastRange.earlierUntil}`} class="text-sm underline hover:text-gray-600">
              The twelve weeks before ({earlierCount} older session{earlierCount === 1 ? '' : 's'} in all) →
            </a>
          </p>
        )
      }
      <p class="text-xs text-gray-400 mt-4">
        Money collected is the cash taken at the session, less anything handed
        back, plus what its guests paid. Session charges are left out — they move
        credit out of a household's pot rather than money into the tin.
      </p>
    </section>
</AdminLayout>

<script>
  // A native <dialog>: showModal gives focus trapping, Escape and the backdrop
  // for free. A form that came back with a problem opens it again on load.
  for (const opener of document.querySelectorAll<HTMLElement>('[data-open-dialog]')) {
    const dialog = document.getElementById(opener.dataset.openDialog ?? '') as HTMLDialogElement | null;
    opener.addEventListener('click', () => dialog?.showModal());
  }
  for (const closer of document.querySelectorAll<HTMLElement>('[data-close-dialog]')) {
    closer.addEventListener('click', () => closer.closest('dialog')?.close());
  }
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[data-open-on-load]')) {
    dialog.showModal();
  }
</script>
