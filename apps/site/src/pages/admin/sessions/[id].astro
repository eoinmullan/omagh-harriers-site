---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../../lib/supabase/admin';
import { redirectAfterPost, takeFlash } from '../../../lib/http/after-post';
import { formatBalance, formatPounds } from '../../../lib/credits/money';
import { formatClubDateTime } from '../../../lib/training/club-time';
import { orThrow } from '../../../lib/supabase/or-throw';
import RecordHeader from '../../../components/admin/RecordHeader.astro';
import Figure from '../../../components/admin/Figure.astro';
import Flash from '../../../components/admin/Flash.astro';
import Pill from '../../../components/admin/Pill.astro';
import Section from '../../../components/admin/Section.astro';
import SummaryList from '../../../components/admin/SummaryList.astro';
import SummaryRow from '../../../components/admin/SummaryRow.astro';
import ResourceTable from '../../../components/admin/ResourceTable.astro';
import FormDialog from '../../../components/admin/FormDialog.astro';
import DangerZone from '../../../components/admin/DangerZone.astro';
import DangerAction from '../../../components/admin/DangerAction.astro';
import {
  planCancellation,
  planReinstatement,
  planSessionEdit,
  type SessionChange,
} from '../../../lib/training/sessions';
import {
  countHeads,
  summariseSessionCash,
  type SessionAttendanceRow,
  type SessionLedgerRow,
} from '../../../lib/training/session-cash';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/sessions');

// The middleware has already checked who this is; see lib/auth/signed-in.ts.

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);


async function loadSession(sessionId: string) {
  const data = orThrow(await adminClient
    .from('training_sessions')
    .select('id, starts_at, note, price_pence, is_cancelled, group:group_id(id, name)')
    .eq('id', sessionId)
    .maybeSingle());

  if (!data) return undefined;

  const row: {
    id: string;
    starts_at: string;
    note: string | null;
    price_pence: number;
    is_cancelled: boolean;
    group: { id: string; name: string } | null;
  } = data;

  return {
    ...row,
    pricePence: row.price_pence,
    isCancelled: row.is_cancelled,
  };
}

async function countAttendance(sessionId: string): Promise<number> {
  const { count } = await adminClient
    .from('attendance')
    .select('id', { count: 'exact', head: true })
    .eq('session_id', sessionId);
  return count ?? 0;
}

let error: string | null = null;
let success: string | null = null;
let failedAction: string | null = null;

// This session, so its own day's phones are told whatever day it falls on.
let changedSession: { id?: string; startsAt: string } | undefined;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const field = (name: string) => ((formData.get(name) as string) ?? '').toString();
  const session = await loadSession(id);
  const postedAction = field('action');

  if (!session) {
    error = 'That session no longer exists.';
  } else {
    changedSession = { id: session.id, startsAt: session.starts_at };
    let plan: SessionChange | undefined;
    let confirmation = '';

    switch (field('action')) {
      case 'edit': {
        plan = planSessionEdit({
          session,
          note: field('note'),
          price: field('price'),
          attendanceCount: await countAttendance(id),
        });
        confirmation = 'Session updated.';
        break;
      }
      case 'cancel': {
        plan = planCancellation(session);
        confirmation = 'Cancelled. Its attendance and the charges against it are untouched.';
        break;
      }
      case 'reinstate': {
        plan = planReinstatement(session);
        confirmation = 'That session is back on.';
        break;
      }
    }

    if (!plan) {
      error = 'Unknown action.';
    } else if ('problem' in plan) {
      error = plan.problem;
    } else {
      const { error: updateError } = await adminClient
        .from('training_sessions')
        .update(plan.update)
        .eq('id', id);

      if (updateError) {
        console.error('[admin/sessions] session update failed:', updateError);
        error = updateError.message;
      } else {
        success = confirmation;
      }
    }
  }
  if (error) failedAction = postedAction;
}

// Succeeded: send the browser back here as a GET, so a reload can't
// submit the form again. A failure renders below, keeping what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient, changedSession);
  return redirectAfterPost(Astro, success);
}
success = takeFlash(Astro.cookies);

const session = await loadSession(id);
if (!session) return Astro.redirect('/admin/sessions');

const attendanceRows = orThrow(await adminClient
  .from('attendance')
  .select(
    'id, member_id, guest_id, amount_paid_pence, created_at, member:member_id(first_name, surname, principal:principal_id(display_name)), guest:guest_id(first_name, surname), recorder:recorded_by(display_name)',
  )
  .eq('session_id', id));

type AttendanceDetailRow = {
  id: string;
  member_id: string | null;
  guest_id: string | null;
  amount_paid_pence: number | null;
  created_at: string;
  member: {
    first_name: string;
    surname: string;
    principal: { display_name: string } | null;
  } | null;
  guest: { first_name: string; surname: string } | null;
  recorder: { display_name: string } | null;
};

const attendanceDetail = (attendanceRows ?? []) satisfies AttendanceDetailRow[];

const ledgerRows = orThrow(await adminClient
  .from('credit_transactions')
  .select(
    'id, type, amount_pence, member_id, notes, created_at, principal:principals!principal_id(display_name), recorder:principals!created_by(display_name)',
  )
  .eq('session_id', id)
  .order('created_at'));

type SessionLedgerDetailRow = {
  id: string;
  type: SessionLedgerRow['type'];
  amount_pence: number;
  member_id: string | null;
  notes: string | null;
  created_at: string;
  principal: { display_name: string } | null;
  recorder: { display_name: string } | null;
};

const ledgerDetail = (ledgerRows ?? []) satisfies SessionLedgerDetailRow[];

const attendanceForSummary: SessionAttendanceRow[] = attendanceDetail.map((row) => ({
  memberId: row.member_id,
  guestId: row.guest_id,
  amountPaidPence: row.amount_paid_pence,
  recordedBy: row.recorder?.display_name ?? null,
}));

const cash = summariseSessionCash({
  ledger: ledgerDetail.map((row) => ({
    type: row.type,
    amountPence: row.amount_pence,
    recordedBy: row.recorder?.display_name ?? null,
  })),
  attendance: attendanceForSummary,
});

const heads = countHeads(attendanceForSummary);

// A member's charge is found through (member_id, session_id), which is the
// join that stands in for the foreign key the schema deliberately does without.
const chargeByMember = new Map<string, number>();
for (const row of ledgerDetail) {
  if (row.type === 'session' && row.member_id) {
    chargeByMember.set(row.member_id, (chargeByMember.get(row.member_id) ?? 0) + row.amount_pence);
  }
}

const signedIn = attendanceDetail
  .map((row) => ({
    id: row.id,
    memberId: row.member_id,
    name: row.member
      ? `${row.member.surname}, ${row.member.first_name}`
      : row.guest
        ? `${row.guest.surname}, ${row.guest.first_name}`
        : 'Unknown',
    household: row.member?.principal?.display_name ?? null,
    isGuest: Boolean(row.guest_id),
    paidPence: row.amount_paid_pence,
    chargedPence: row.member_id ? chargeByMember.get(row.member_id) ?? null : null,
    recordedBy: row.recorder?.display_name ?? 'Unattributed',
    at: formatClubDateTime(row.created_at),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'en-GB'));

const money = ledgerDetail
  .filter((row) => row.type === 'top_up_cash' || row.type === 'refund')
  .map((row) => ({
    id: row.id,
    household: row.principal?.display_name ?? 'Unknown household',
    amountPence: row.amount_pence,
    notes: row.notes,
    recordedBy: row.recorder?.display_name ?? 'Unattributed',
    at: formatClubDateTime(row.created_at),
  }));

const hasAttendance = attendanceDetail.length > 0;
const hasStarted = session.starts_at <= new Date().toISOString();
---

<AdminLayout section="sessions" title={session.group?.name ?? 'Session'} breadcrumb={[{ label: 'Sessions', href: '/admin/sessions' }, { label: session.group?.name ?? 'Session' }]}>
  <Flash success={success} error={failedAction === 'edit' ? null : error} />

  <RecordHeader title={session.group?.name ?? 'Session'} struck={session.isCancelled}>
    <Fragment slot="pills">
      {session.isCancelled ? (
        <Pill tone="gray">Cancelled</Pill>
      ) : hasStarted ? (
        <Pill tone="green">Ran</Pill>
      ) : (
        <Pill tone="blue">Scheduled</Pill>
      )}
    </Fragment>
    <p>{formatClubDateTime(session.starts_at)}</p>
    {session.note && <p class="text-gray-700">{session.note}</p>}
    <Fragment slot="actions">
      <a href={`/admin/sessions/${id}/sheet`} class="btn btn-secondary btn-sm">Printable sign-in sheet</a>
      <span class="text-xs text-gray-500">for the night a phone dies, or no phone turns up at all</span>
    </Fragment>
    <Fragment slot="figures">
      <Figure
        label="Attended"
        value={heads.total}
        hint={`${heads.members} member${heads.members === 1 ? '' : 's'} · ${heads.guests} guest${heads.guests === 1 ? '' : 's'}`}
      />
      <Figure
        label="Money collected"
        value={formatBalance(cash.totalPence)}
        hint={session.pricePence === 0 ? 'a free session' : `at ${formatPounds(session.pricePence)} a session`}
      />
    </Fragment>
    {session.isCancelled && (
      <p slot="footer" class="text-sm text-gray-500 mt-4">
        This session is cancelled. Nothing recorded against it has been removed.
      </p>
    )}
  </RecordHeader>

  <Section title="Details">
    <SummaryList>
      <SummaryRow label="Squad">
        <span class="font-medium">{session.group?.name}</span>
      </SummaryRow>
      <SummaryRow label="Starts">{formatClubDateTime(session.starts_at)}</SummaryRow>
      <SummaryRow label="Price">
        {session.pricePence === 0 ? 'Free' : formatPounds(session.pricePence)}
        {!hasAttendance && (
          <button slot="action" type="button" data-open-dialog="edit-session" class="btn-link text-sm">Change</button>
        )}
      </SummaryRow>
      <SummaryRow label="Note">
        {session.note ?? <span class="text-gray-400">None</span>}
        <button slot="action" type="button" data-open-dialog="edit-session" class="btn-link text-sm">Change</button>
      </SummaryRow>
      <SummaryRow label="Status">
        {session.isCancelled ? 'Cancelled' : hasStarted ? 'Ran' : 'Scheduled'}
        {session.isCancelled && (
          <form slot="action" method="POST">
            <input type="hidden" name="action" value="reinstate" />
            <button type="submit" class="btn btn-secondary btn-sm">Put it back on</button>
          </form>
        )}
      </SummaryRow>
    </SummaryList>
    <p class="text-xs text-gray-500 mt-2">
      {hasAttendance
        ? `The price is settled: ${heads.total} ${heads.total === 1 ? 'runner has' : 'runners have'} signed in at ${formatPounds(session.pricePence)}, and the ledger records what they were charged. Cancel this session and create another if the price was wrong.`
        : 'The squad and the start time are fixed once a session exists — cancel it and create another if either was wrong.'}
    </p>
  </Section>

  {cash.byRecorder.length > 1 && (
    <Section
      title="Who took it"
      description="Two phones were open on this session. This is the figure each of them should be able to account for."
    >
      <ResourceTable>
        <thead>
          <tr>
            <th>Recorded by</th>
            <th class="num">Money collected</th>
          </tr>
        </thead>
        <tbody>
          {cash.byRecorder.map((recorder) => (
            <tr>
              <td class="cell-primary">{recorder.recordedBy}</td>
              <td class="num cell-trailing font-medium">{formatBalance(recorder.totalPence)}</td>
            </tr>
          ))}
        </tbody>
      </ResourceTable>
    </Section>
  )}

  <Section title="Who was here" count={signedIn.length}>
    {signedIn.length > 0 ? (
      <ResourceTable>
        <thead>
          <tr>
            <th>Name</th>
            <th>Household</th>
            <th class="num">Charged</th>
            <th>Recorded by</th>
            <th>At</th>
            <th><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          {signedIn.map((line) => (
            <tr data-href={line.memberId ? `/admin/members/${line.memberId}` : undefined}>
              <td class="cell-primary">
                {line.memberId ? (
                  <a href={`/admin/members/${line.memberId}`} class="row-link">{line.name}</a>
                ) : (
                  <span class="font-semibold">{line.name}</span>
                )}
                {line.isGuest && <span class="ml-2"><Pill tone="amber">Guest</Pill></span>}
              </td>
              <td class="mobile-only cell-secondary">
                {[line.household, line.recordedBy && `by ${line.recordedBy}`, line.at].filter(Boolean).join(' · ')}
              </td>
              <td class="text-gray-600">{line.household ?? '—'}</td>
              <td class="num cell-trailing text-sm">
                {line.isGuest
                  ? line.paidPence
                    ? `${formatPounds(line.paidPence)} cash`
                    : '—'
                  : line.chargedPence
                    ? `${formatPounds(line.chargedPence)} credit`
                    : 'not charged'}
              </td>
              <td class="text-gray-600">{line.recordedBy}</td>
              <td class="text-gray-500 text-xs whitespace-nowrap">{line.at}</td>
              <td class:list={[line.memberId && 'row-chevron']} aria-hidden="true"></td>
            </tr>
          ))}
        </tbody>
      </ResourceTable>
    ) : (
      <p class="text-gray-500 text-sm">Nobody has been signed in to this session yet.</p>
    )}
  </Section>

  <Section
    title="Cash taken"
    count={money.length}
    description="Cash households paid in, or were handed back, at this session. A guest's cash is on their row in Who was here."
  >
    {money.length > 0 ? (
      <ResourceTable>
        <thead>
          <tr>
            <th>Household</th>
            <th class="num">Amount</th>
            <th>Recorded by</th>
            <th>At</th>
            <th><span class="sr-only">Direction</span></th>
          </tr>
        </thead>
        <tbody>
          {money.map((line) => (
            <tr>
              <td class="cell-primary">
                <span class="font-semibold">{line.household}</span>
                {line.notes && <p class="text-xs text-gray-500">{line.notes}</p>}
              </td>
              <td class="mobile-only cell-secondary">
                {line.amountPence > 0 ? 'Taken in' : 'Handed back'} · by {line.recordedBy} · {line.at}
              </td>
              <td class="num cell-trailing font-medium">{formatBalance(line.amountPence)}</td>
              <td class="text-gray-600">{line.recordedBy}</td>
              <td class="text-gray-500 text-xs whitespace-nowrap">{line.at}</td>
              <td class="text-right">
                {line.amountPence > 0 ? <Pill tone="green">Taken in</Pill> : <Pill tone="gray">Handed back</Pill>}
              </td>
            </tr>
          ))}
        </tbody>
      </ResourceTable>
    ) : (
      <p class="text-gray-500 text-sm">No cash was recorded at this session.</p>
    )}
    <p class="text-xs text-gray-400 mt-3">
      Sessions paid for from a household's training credit aren't counted in Money collected, because no cash changes
      hands for them.
    </p>
  </Section>

  {!session.isCancelled && (
    <DangerZone>
      <DangerAction
        title="Cancel this session"
        description="It comes off the registrar app's list. Nothing already recorded against it is removed, and it can be put back on."
      >
        <form method="POST">
          <input type="hidden" name="action" value="cancel" />
          <button
            type="submit"
            class="btn btn-danger"
            onclick="return confirm('Cancel this session? Nothing already recorded against it is removed.')"
          >Cancel session</button>
        </form>
      </DangerAction>
    </DangerZone>
  )}

  <FormDialog id="edit-session" title="Edit session" submitLabel="Save" error={error} reopen={failedAction === 'edit'}>
    <input type="hidden" name="action" value="edit" />
    <div>
      <label class="field-label" for="edit-note">Note <span class="text-gray-400 font-normal">(optional)</span></label>
      <input
        id="edit-note"
        type="text"
        name="note"
        value={session.note ?? ''}
        placeholder="Meet at the top car park"
        class="field"
      />
    </div>
    <div>
      <label class="field-label" for="edit-price">Price</label>
      <input
        id="edit-price"
        type="text"
        name="price"
        inputmode="decimal"
        value={formatPounds(session.pricePence)}
        disabled={hasAttendance}
        class="field sm:w-32"
      />
      {hasAttendance && <p class="text-xs text-gray-500 mt-1">Settled once runners have signed in.</p>}
    </div>
  </FormDialog>
</AdminLayout>
