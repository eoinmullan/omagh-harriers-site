---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { nudgeTheRegistrarApp } from '../../lib/training/admin-nudge';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { redirectAfterPost, takeFlash } from '../../lib/http/after-post';
import { everyRow } from '../../lib/supabase/every-row';
import { orThrow } from '../../lib/supabase/or-throw';
import { membersInNoSquad, planNewGroup, summariseSquads, type ExistingGroup } from '../../lib/training/groups';
import { formatClubDate } from '../../lib/training/club-time';
import PageHeader from '../../components/admin/PageHeader.astro';
import Flash from '../../components/admin/Flash.astro';
import StatTiles from '../../components/admin/StatTiles.astro';
import StatTile from '../../components/admin/StatTile.astro';
import SegmentedNav from '../../components/admin/SegmentedNav.astro';
import ResourceTable from '../../components/admin/ResourceTable.astro';
import FormDialog from '../../components/admin/FormDialog.astro';
import Pill from '../../components/admin/Pill.astro';

// The middleware has already checked who this is; see lib/auth/signed-in.ts.

const adminClient = createSupabaseAdminClientFromLocals(Astro.locals);

async function loadGroups(): Promise<ExistingGroup[]> {
  const data = orThrow(await adminClient
    .from('groups')
    .select('id, name, is_active')
    .order('name'));

  return (data ?? []).map((row) => ({
    id: row.id,
    name: row.name,
    isActive: row.is_active,
  }));
}

let error: string | null = null;
let success: string | null = null;
let newSquadId: string | undefined;
// What was typed, so a refused name comes back in the dialog to be corrected.
let draftName = '';

// Only a new squad is made here. Renaming, retiring and who's in it are done
// on the squad's own page, the way every other list in the admin area works.
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const name = ((formData.get('name') as string) ?? '').toString();
  draftName = name;
  const plan = planNewGroup({ name, existing: await loadGroups() });

  if ('problem' in plan) {
    error = plan.problem;
  } else {
    const { data, error: insertError } = await adminClient.from('groups').insert(plan.insert).select('id').single();
    if (insertError) error = insertError.message;
    else {
      success = `${plan.insert.name} added. Add its members below.`;
      newSquadId = data.id;
    }
  }
}

// Succeeded: on to the new squad's page, as a GET, so a reload can't submit
// the form again. A failure reopens the dialog with what was typed.
if (success) {
  // Whatever an admin changed here, the registrar app shows it.
  await nudgeTheRegistrarApp(adminClient);
  return redirectAfterPost(Astro, success, newSquadId ? `/admin/squads/${newSquadId}` : undefined);
}
success = takeFlash(Astro.cookies);

const groups = await loadGroups();

// Counted from every row: both reads grow past PostgREST's 1000-row limit as
// the club does, and a cut-off read undercounts without saying so.
const [membershipRows, sessionRows, activeMembers] = await Promise.all([
  everyRow((from, to) =>
    adminClient.from('member_groups').select('member_id, group_id').order('member_id').order('group_id').range(from, to),
  ),
  everyRow((from, to) =>
    adminClient.from('training_sessions').select('id, group_id, starts_at, is_cancelled').order('id').range(from, to),
  ),
  everyRow((from, to) => adminClient.from('members').select('id').eq('is_active', true).order('id').range(from, to)),
]);

const memberships = membershipRows.map((row) => ({ memberId: row.member_id, groupId: row.group_id }));
const activeMemberIds = new Set(activeMembers.map((row) => row.id));

const squads = summariseSquads({
  groups,
  memberships,
  activeMemberIds,
  sessions: sessionRows.map((row) => ({ groupId: row.group_id, startsAt: row.starts_at, isCancelled: row.is_cancelled })),
  now: new Date(),
});

const running = squads.filter((squad) => squad.isActive);
const retired = squads.filter((squad) => !squad.isActive);
const showRetired = Astro.url.searchParams.get('show') === 'retired' && retired.length > 0;
const shown = showRetired ? retired : running;

const runningIds = new Set(running.map((squad) => squad.id));
const inASquad = new Set(memberships.filter((m) => runningIds.has(m.groupId) && activeMemberIds.has(m.memberId)).map((m) => m.memberId));
const inNoSquad = membersInNoSquad({ activeMemberIds, memberships, runningGroupIds: runningIds });
---

<AdminLayout section="squads" title="Squads">
  <PageHeader
    title="Squads"
    subtitle="The squads the club trains in. Every session belongs to one."
    primary={{ label: 'New squad', dialog: 'new-squad' }}
  />

  <Flash success={success} />

  <StatTiles columns={3}>
    <StatTile label="Active squads" value={running.length} />
    <StatTile label="Members in a squad" value={inASquad.size} hint="active members" />
    <StatTile
      label="In no squad"
      value={inNoSquad.size}
      hint="active members, shown in Members"
      href="/admin/members?filter=no-squad"
    />
  </StatTiles>

  {retired.length > 0 && (
    <SegmentedNav
      label="Which squads"
      items={[
        { label: 'Active', href: '/admin/squads', current: !showRetired, count: running.length },
        { label: 'Retired', href: '/admin/squads?show=retired', current: showRetired, count: retired.length },
      ]}
    />
  )}

  {shown.length > 0 ? (
    <ResourceTable>
      <thead>
        <tr>
          <th>Squad</th>
          <th class="num">Members</th>
          <th class="num">Sessions run</th>
          <th>Last session</th>
          <th>Next session</th>
          <th>Status</th>
          <th><span class="sr-only">Open</span></th>
        </tr>
      </thead>
      <tbody>
        {shown.map((squad) => (
          <tr data-href={`/admin/squads/${squad.id}`}>
            <td class="cell-primary"><a href={`/admin/squads/${squad.id}`} class="row-link">{squad.name}</a></td>
            <td class="mobile-only cell-secondary">
              {squad.lastRunAt ? `Last ${formatClubDate(squad.lastRunAt)}` : 'Not run yet'} · {squad.sessionsRun} run
              {squad.nextAt && ` · next ${formatClubDate(squad.nextAt)}`}
            </td>
            <td class="mobile-only cell-trailing text-sm">
              <span class="font-medium tabular-nums">{squad.members}</span> <span class="text-gray-500">members</span>
              {!squad.isActive && <div><Pill tone="gray">Retired</Pill></div>}
            </td>
            <td class="num">{squad.members}</td>
            <td class="num">{squad.sessionsRun}</td>
            <td class="text-gray-600 whitespace-nowrap">{squad.lastRunAt ? formatClubDate(squad.lastRunAt) : '—'}</td>
            <td class="text-gray-600 whitespace-nowrap">{squad.nextAt ? formatClubDate(squad.nextAt) : '—'}</td>
            <td>{squad.isActive ? <Pill tone="green">Active</Pill> : <Pill tone="gray">Retired</Pill>}</td>
            <td class="row-chevron" aria-hidden="true"></td>
          </tr>
        ))}
      </tbody>
    </ResourceTable>
  ) : (
    <div class="border border-dashed border-gray-300 rounded-lg px-6 py-10 text-center">
      <p class="font-medium">No squads yet</p>
      <p class="text-sm text-gray-500 mt-1">
        A session cannot be created until there is one, so start with the squads that train this week.
      </p>
      <button type="button" data-open-dialog="new-squad" class="btn btn-primary mt-4">New squad</button>
    </div>
  )}

  <p class="text-xs text-gray-400 mt-4">
    Retiring a squad never deletes it. Its sessions and the attendance against them stay exactly as they were.
  </p>

  <FormDialog id="new-squad" title="New squad" submitLabel="Add squad" error={error} reopen>
    <div>
      <label class="field-label" for="new-group-name">Name</label>
      <input id="new-group-name" type="text" name="name" value={draftName} placeholder="Middle Distance" required class="field" />
    </div>
  </FormDialog>
</AdminLayout>
