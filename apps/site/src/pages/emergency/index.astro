---
import '../../styles/global.css';
import { EmergencyApp } from '../../components/emergency/EmergencyApp';

// The club app's Emergency contacts section. Prerendered for the reasons the
// registrar app is (see src/pages/registrar/index.astro): it opens at a track
// with no signal, from its own worker, and holds no data of its own. Every read
// is gated by RLS on the `emergency_contacts` token claim, and the copy kept
// for offline lives in IndexedDB, written by the island.
export const prerender = true;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="Emergency contacts for Omagh Harriers members." />
    <meta name="robots" content="noindex" />

    <!-- The club app's manifest, as every section links it. -->
    <link rel="manifest" href="/app/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/registrar/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/registrar/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/registrar/favicon-16.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Harriers" />

    <title>Harriers</title>
  </head>
  <body class="bg-black text-white antialiased">
    <EmergencyApp client:only="react" />
    <noscript>
      <main class="mx-auto max-w-xl px-5 py-10">
        <h1 class="text-2xl font-bold">Emergency contacts</h1>
        <p class="mt-3 text-lg text-neutral-300">This needs JavaScript switched on.</p>
      </main>
    </noscript>
  </body>
</html>

<style is:global>
  /* Structural only, and belongs to this page alone — it is inlined into this
     page's HTML and never reaches the public site's shared bundle. The accent
     is the club's amber from global.css; everything else is Tailwind's own
     neutrals, matching the prototype. */
  :root {
    color-scheme: dark;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
      env(safe-area-inset-left);
    -webkit-text-size-adjust: 100%;
  }

  /* A mis-tap is the failure this screen exists to avoid, so nothing is a drag
     target and nothing double-tap zooms. */
  button,
  a,
  input {
    touch-action: manipulation;
  }
</style>
