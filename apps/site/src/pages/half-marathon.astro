---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout
  title="SPAR Omagh Half Marathon & 5K | Omagh Harriers AC"
  description="A look back at the 2026 SPAR Omagh Half Marathon & 5K, plus updates for the next event from Omagh Harriers AC."
>
  <!-- Hero: bottom-anchored -->
  <section class="relative h-[280px] sm:h-[400px] md:h-[600px] flex items-end">
    <img
      src="/aerial-shot.jpg"
      alt="Aerial view of Omagh Half Marathon route"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/10"></div>

    <div class="relative z-10 w-full px-4 sm:px-6 lg:px-8 pb-8 sm:pb-12 max-w-7xl mx-auto">
      <span class="inline-block text-amber text-xs sm:text-sm font-semibold tracking-widest uppercase mb-3">
        36th edition · 29 March 2026
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-3 leading-tight">
        SPAR Omagh Half Marathon & 5K
      </h1>
      <p class="hidden sm:block text-lg sm:text-xl text-gray-200 mb-6 max-w-2xl">
        Despite the downpours, the energy never dipped. Thank you to everyone who made race day what it was.
      </p>
      <a
        href="https://www.myrunresults.com/events/spar_omagh_half_marathon__5k/6195/results"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-amber text-black px-6 py-3 rounded-lg font-bold text-base sm:text-lg hover:bg-yellow-400 transition-colors"
      >
        View 2026 Results →
      </a>
    </div>
  </section>

  <!-- At a Glance -->
  <section class="py-10 sm:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">At a Glance</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        <div class="text-center p-4 sm:p-6 bg-gray-50 rounded-lg">
          <p class="text-3xl sm:text-4xl font-bold">4,323</p>
          <p class="text-gray-500 text-sm sm:text-base mt-1">Total runners</p>
        </div>
        <div class="text-center p-4 sm:p-6 bg-gray-50 rounded-lg">
          <p class="text-3xl sm:text-4xl font-bold">284</p>
          <p class="text-gray-500 text-sm sm:text-base mt-1">Clubs represented</p>
        </div>
        <div class="text-center p-4 sm:p-6 bg-gray-50 rounded-lg">
          <p class="text-3xl sm:text-4xl font-bold">322</p>
          <p class="text-gray-500 text-sm sm:text-base mt-1">Teams</p>
        </div>
        <div class="text-center p-4 sm:p-6 bg-gray-50 rounded-lg">
          <p class="text-xl sm:text-2xl font-bold leading-tight mt-1">HM · Walk · 5K</p>
          <p class="text-gray-500 text-sm sm:text-base mt-1">Distances</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Winners -->
  <section class="py-10 sm:py-14 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">2026 Winners</h2>
      <div class="space-y-3">

        <!-- Overall Winners -->
        <details class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-bold text-base sm:text-lg select-none list-none">
            Overall Winners
            <svg class="w-5 h-5 text-gray-400 details-chevron flex-shrink-0 ml-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-4 sm:px-5 pb-6">
            <h3 class="font-semibold text-xs uppercase tracking-wider text-gray-500 mt-5 mb-3">Male Open</h3>
            <div class="overflow-x-auto -mx-4 sm:mx-0">
              <table class="w-full text-sm min-w-[320px] px-4 sm:px-0">
                <thead>
                  <tr class="border-b border-gray-200">
                    <th class="text-left py-2 pr-3 pl-4 sm:pl-0 font-semibold w-10">Pos</th>
                    <th class="text-left py-2 pr-3 font-semibold">Name</th>
                    <th class="text-left py-2 pr-3 font-semibold">Club</th>
                    <th class="text-right py-2 pr-4 sm:pr-0 font-semibold">Time</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-gray-100"><td class="py-2 pr-3 pl-4 sm:pl-0">1st</td><td class="py-2 pr-3">Stephen McAuley</td><td class="py-2 pr-3 text-gray-600">Letterkenny AC</td><td class="py-2 pr-4 sm:pr-0 text-right tabular-nums">1:06:56</td></tr>
                  <tr class="border-b border-gray-100"><td class="py-2 pr-3 pl-4 sm:pl-0">2nd</td><td class="py-2 pr-3">Michael Fox</td><td class="py-2 pr-3 text-gray-600">Letterkenny AC</td><td class="py-2 pr-4 sm:pr-0 text-right tabular-nums">1:08:48</td></tr>
                  <tr class="border-b border-gray-100"><td class="py-2 pr-3 pl-4 sm:pl-0">3rd</td><td class="py-2 pr-3">James Speight</td><td class="py-2 pr-3 text-gray-600">Dromore Runners</td><td class="py-2 pr-4 sm:pr-0 text-right tabular-nums">1:10:16</td></tr>
