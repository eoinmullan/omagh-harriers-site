---
import Layout from '../layouts/Layout.astro';
import JuniorTrainingTimes from '../components/JuniorTrainingTimes.astro';
import TrainingTimesNote from '../components/TrainingTimesNote.astro';
import { trainingSchedule } from '../data/training-schedule';
import { resolveToday, selectTraining } from '../lib/training/schedule';

Astro.response.headers.set('Cache-Control', 'public, max-age=300');

const active = selectTraining(trainingSchedule, resolveToday(Astro.url, import.meta.env.DEV));
---

<Layout
  title="Juniors | Omagh Harriers AC"
  description="Junior Academy at Omagh Harriers AC — training times, seasonal programme and how to get involved for young athletes in Omagh."
>
  <!-- Hero: bottom-anchored -->
  <section class="relative h-[280px] sm:h-[400px] md:h-[600px] flex items-end">
    <img
      src="/aerial-shot.jpg"
      alt="Omagh Harriers junior athletes in action"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/10"></div>

    <div class="relative z-10 w-full px-4 sm:px-6 lg:px-8 pb-8 sm:pb-12 max-w-7xl mx-auto">
      <span class="inline-block text-amber text-xs sm:text-sm font-semibold tracking-widest uppercase mb-3">
        Junior Academy · Omagh Harriers AC
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-3 leading-tight">
        Junior Academy
      </h1>
      <div class="min-h-[48px] sm:min-h-[132px]">
        <p class="hidden sm:block text-lg sm:text-xl text-gray-200 max-w-2xl">
          Developing young athletes in a fun, supportive environment — from first strides to club competition.
        </p>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-10 sm:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-5">Junior Academy</h2>
      <p class="text-gray-700 text-base sm:text-lg leading-relaxed mb-4">
        Omagh Harriers AC is committed to developing young athletes and fostering a love of running, track &amp; field from an early age. Our Junior Academy provides coaching and training opportunities for young runners, helping them build their skills and confidence in a welcoming club environment.
      </p>
      <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
        We cater for a range of age groups and abilities. Whether your child is taking their first steps in athletics or looking to compete at Ulster and national level, there is a place for them at Omagh Harriers.
      </p>
    </div>
  </section>

  <!-- Training Times -->
  <section class="py-10 sm:py-14 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">Training Times</h2>

      <JuniorTrainingTimes active={active} />
      <TrainingTimesNote active={active} class="mt-6" />
    </div>
  </section>

  <!-- What We Offer -->
  <section class="py-10 sm:py-14 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">What We Offer</h2>
      <ul class="grid md:grid-cols-2 gap-x-12 gap-y-4">
        <li class="flex items-start">
          <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700 text-base sm:text-lg">Qualified coaches experienced in youth athletics</span>
        </li>
        <li class="flex items-start">
          <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700 text-base sm:text-lg">Age-appropriate training programmes</span>
        </li>
        <li class="flex items-start">
          <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700 text-base sm:text-lg">Track and field, cross country and road running</span>
        </li>
        <li class="flex items-start">
          <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700 text-base sm:text-lg">Safe, inclusive environment</span>
        </li>
        <li class="flex items-start">
          <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700 text-base sm:text-lg">Opportunities to compete locally, provincially and nationally</span>
        </li>
        <li class="flex items-start">
          <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700 text-base sm:text-lg">ANI-affiliated club with structured underage pathways</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- The Club Season -->
  <section class="py-10 sm:py-14 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">The Club Season</h2>
      <div class="space-y-3">

        <details class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-bold text-base sm:text-lg select-none list-none">
            Indoors — Winter into Spring
            <svg class="w-5 h-5 text-gray-400 details-chevron flex-shrink-0 ml-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-6 text-gray-700 text-sm sm:text-base leading-relaxed">
            Indoor athletics takes place over the winter and into early spring. Athletes compete on indoor tracks, focusing on sprints, middle distance, hurdles and field events such as long jump, high jump and shot put. Indoor competitions are held across Ireland and provide a great introduction to competitive athletics for younger athletes.
          </div>
        </details>

        <details class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-bold text-base sm:text-lg select-none list-none">
            Outdoor Track &amp; Field — Spring and Summer
            <svg class="w-5 h-5 text-gray-400 details-chevron flex-shrink-0 ml-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-6 text-gray-700 text-sm sm:text-base leading-relaxed">
            As the season moves outdoors, training and competition shifts to the outdoor track. Athletes develop across all track distances and field disciplines. The summer season includes NI &amp; Ulster and All-Ireland underage championships, giving athletes the opportunity to compete at regional and national level.
          </div>
        </details>

        <details class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-bold text-base sm:text-lg select-none list-none">
            Cross Country — Autumn &amp; Winter
            <svg class="w-5 h-5 text-gray-400 details-chevron flex-shrink-0 ml-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-6 text-gray-700 text-sm sm:text-base leading-relaxed">
            Cross country is a core part of the junior calendar from autumn through winter. Athletes race over grass, mud and terrain courses at local, provincial and national level. The NI &amp; Ulster Cross Country and National Cross Country Championships are key targets for club athletes.
          </div>
        </details>

      </div>
    </div>
  </section>

  <!-- Safeguarding -->
  <section class="py-10 sm:py-14 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-lg p-6 sm:p-8 border-l-4 border-amber shadow-sm">
        <h3 class="text-xl sm:text-2xl font-bold mb-4">Child Safety &amp; Safeguarding</h3>
        <p class="text-gray-700 text-base sm:text-lg leading-relaxed mb-4">
          Omagh Harriers AC is fully committed to safeguarding the welfare of all young athletes. We follow strict safeguarding policies in line with Athletics NI guidelines. All coaches working with juniors hold up-to-date Access NI clearance.
        </p>
        <a
          href="/policies"
          class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
        >
          View Our Safeguarding Policy
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-12 sm:py-16 bg-black text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-amber font-semibold uppercase tracking-widest text-xs sm:text-sm mb-3">Interested in the Junior Academy?</p>
      <h2 class="text-2xl sm:text-3xl font-bold mb-2">Get In Touch</h2>
      <p class="text-gray-400 mb-8 text-sm sm:text-base max-w-xl mx-auto">
        For more information about our Junior Academy, training times, and how to get your child involved, please get in touch with the club.
      </p>
      <a
        href="mailto:info@omaghharriers.com"
        class="inline-block bg-amber text-black px-8 py-4 rounded-lg font-bold text-base sm:text-lg hover:bg-yellow-400 transition-colors"
      >
        Contact Us →
      </a>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('details').forEach((el) => {
    const chevron = el.querySelector<HTMLElement>('.details-chevron');
    if (!chevron) return;
    el.addEventListener('toggle', () => {
      chevron.style.transform = el.open ? 'rotate(180deg)' : '';
    });
  });
</script>
