---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { describeEntry, isCredit } from '../../lib/credits/transactions';
import { formatBalance } from '@omagh/training';
import type { CreditTransactionType } from '@omagh/supabase';

// Middleware guarantees auth + active principal + terms accepted before we get here.
// Defensive fallback only.
const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (!user) return Astro.redirect('/signin');

const { data: principal } = await Astro.locals.supabase
  .from('principals')
  .select('id')
  .eq('auth_user_id', user.id)
  .maybeSingle();

if (!principal) return Astro.redirect('/signin');

const { data: balance } = await Astro.locals.supabase
  .from('principal_balances')
  .select('balance_pence')
  .eq('principal_id', principal.id)
  .maybeSingle();

// The ledger is read with the service-role client because a line needs the name
// of the admin who recorded it, and RLS rightly hides every principal row but
// the member's own. Scoped to this household's principal_id, server-side only.
const { data: rows } = await createSupabaseAdminClientFromLocals(Astro.locals)
  .from('credit_transactions')
  .select('id, type, amount_pence, notes, created_at, recorder:created_by(display_name), member:member_id(first_name, surname)')
  .eq('principal_id', principal.id)
  .order('created_at', { ascending: false });

type LedgerRow = {
  id: string;
  type: CreditTransactionType;
  amount_pence: number;
  notes: string | null;
  created_at: string;
  recorder: { display_name: string } | null;
  member: { first_name: string; surname: string } | null;
};

const history = ((rows ?? []) as unknown as LedgerRow[]).map((row) => {
  const entry = {
    type: row.type,
    amountPence: row.amount_pence,
    notes: row.notes,
    recordedBy: row.recorder?.display_name ?? null,
    memberName: row.member ? `${row.member.first_name} ${row.member.surname}` : null,
  };
  return {
    id: row.id,
    description: describeEntry(entry),
    isCredit: isCredit(entry),
    on: new Date(row.created_at).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }),
  };
});

const balancePence = balance?.balance_pence ?? 0;
---

<Layout title="Training credit — Omagh Harriers AC">
  <PageContainer>
    <p class="text-sm text-gray-500 mb-6">
      <a href="/members" class="hover:underline">Members' area</a> / Training credit
    </p>

    <h1 class="text-3xl font-bold mb-2">Training credit</h1>
    <p class="text-gray-600 mb-8">
      One balance covers everyone in your household. Any of your members can use
      it at training.
    </p>

    <div class="bg-gray-50 border border-gray-200 rounded-lg px-6 py-5 mb-10">
      <p class="text-sm text-gray-500">Current balance</p>
      <p
        class:list={[
          'text-4xl font-bold mt-1',
          balancePence < 0 ? 'text-red-600' : 'text-gray-900',
        ]}
      >
        {formatBalance(balancePence)}
      </p>
      {
        balancePence < 0 && (
          <p class="text-sm text-red-600 mt-2">
            Your account is overdrawn. Please settle up at training.
          </p>
        )
      }
    </div>

    <section>
      <h2 class="text-xl font-semibold mb-4">History</h2>

      {
        history.length > 0 ? (
          <ul class="divide-y divide-gray-200 border-t border-b border-gray-200">
            {history.map((line) => (
              <li class="py-4 flex items-baseline justify-between gap-4">
                <div>
                  <p class="font-medium">{line.description}</p>
                  <p class="text-sm text-gray-500 mt-0.5">{line.on}</p>
                </div>
                <span
                  class:list={[
                    'text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap',
                    line.isCredit ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600',
                  ]}
                >
                  {line.isCredit ? 'Credit' : 'Debit'}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-500 text-sm">
            Nothing here yet. Top-ups and training sessions will appear as soon as
            they are recorded.
          </p>
        )
      }
    </section>
  </PageContainer>
</Layout>
