---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { formatBalance } from '../../lib/credits/money';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { orThrow } from '../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../lib/auth/signed-in';
import { adminLine, registrationLine } from '../../lib/app/home-cards';
import { sectionsFor } from '../../lib/app/sections';
import { clubDayWindow } from '../../lib/training/tonight';

// Middleware guarantees auth + active principal + terms accepted before we get here.
// Defensive fallback only.
const { user, principal } = whoIsSignedIn(Astro.locals);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (formData.get('action') === 'signout') {
    await Astro.locals.supabase.auth.signOut();
    return Astro.redirect('/');
  }
}


function formatDob(dob: string): string {
  return new Date(dob).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const balance = orThrow(await Astro.locals.supabase
  .from('principal_balances')
  .select('balance_pence')
  .eq('principal_id', principal.id)
  .maybeSingle());

const balancePence = balance?.balance_pence ?? 0;

// Read with the service role because a login can no longer see a date of birth
// or a gender (migration 0018 limits it to the columns the registrar app
// needs). Scoped to this household's principal, found through the member's own
// session above. The same pattern /members/credits uses for the ledger.
const members = orThrow(await createSupabaseAdminClientFromLocals(Astro.locals)
  .from('members')
  .select('id, first_name, surname, date_of_birth, status, gender')
  .eq('principal_id', principal.id)
  .eq('is_active', true)
  .order('first_name'));

// Each tool's card carries a line worth reading. Registrars read sessions
// through RLS; the overdrawn count is the admin pages' own read.
const held = sectionsFor(principal.role).map((section) => section.key);
const holdsRegistration = held.includes('registration');
const holdsAdmin = held.includes('admin');

let registrationSummary = '';
if (holdsRegistration) {
  const today = clubDayWindow();
  const sessions = orThrow(await Astro.locals.supabase
    .from('training_sessions')
    .select('starts_at, is_cancelled, group:group_id(name)')
    .gte('starts_at', today.from)
    .lt('starts_at', today.until));
  registrationSummary = registrationLine(
    (sessions ?? []).map((session) => ({ groupName: session.group?.name ?? 'A session', startsAt: session.starts_at, isCancelled: session.is_cancelled })),
  );
}

let adminSummary = '';
if (holdsAdmin) {
  const overdrawn = await createSupabaseAdminClientFromLocals(Astro.locals)
    .from('principal_balances')
    .select('principal_id', { count: 'exact', head: true })
    .lt('balance_pence', 0);
  orThrow(overdrawn);
  adminSummary = adminLine(overdrawn.count ?? 0);
}
---

<Layout title="Members' Area — Omagh Harriers AC">
  <PageContainer>
    <div class="flex items-start justify-between gap-4 mb-5 sm:mb-8">
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-bold">Members' area</h1>
        <p class="text-gray-500 mt-1">Welcome back, {principal.display_name}</p>
        <p class="text-gray-400 text-sm mt-0.5 [overflow-wrap:anywhere]">Signed in as {user.email}</p>
      </div>
      <form method="POST" class="hidden sm:block">
        <input type="hidden" name="action" value="signout" />
        <button type="submit" class="text-sm text-gray-500 hover:text-gray-800 underline transition-colors">Sign out</button>
      </form>
    </div>

    {/* The balance is what most people come here for, so it leads, and the
        whole card is the way to the statement. A Top up button joins it with
        card payments (Phase 4). */}
    <a
      href="/members/credits"
      class="block bg-white border border-gray-200 rounded-lg px-5 py-4 mb-8 sm:mb-10 shadow-[inset_0_4px_0_var(--color-amber)] hover:border-gray-400 active:bg-gray-50 transition-colors"
    >
      <p class="text-sm text-gray-500">Training credit</p>
      <div class="flex items-end justify-between gap-4">
        <p class:list={['text-4xl font-bold mt-0.5 tabular-nums', balancePence < 0 ? 'text-red-600' : 'text-gray-900']}>
          {formatBalance(balancePence)}
        </p>
        <span class="inline-flex items-center gap-1 text-sm font-medium min-h-11">
          Sessions and payments <span aria-hidden="true" class="text-xl text-gray-400">›</span>
        </span>
      </div>
      {balancePence < 0 && (
        <p class="text-sm text-red-700 bg-red-50 rounded-md px-3 py-2 mt-2">Your balance is below zero. Please top up at the next session.</p>
      )}
    </a>

    <section>
      <h2 class="text-lg sm:text-xl font-semibold mb-3">
        {members && members.length > 0 ? 'Your household' : 'No members found'}
      </h2>

      {members && members.length > 0 ? (
        <ul class="-mx-4 sm:mx-0 border-y border-gray-200 sm:border sm:rounded-lg divide-y divide-gray-200 bg-white">
          {members.map((member) => (
            <li class="flex items-center justify-between gap-4 px-4 py-3 min-h-15">
              <div class="min-w-0">
                <p class="font-medium">{member.first_name} {member.surname}</p>
                <p class="text-sm text-gray-500">
                  {formatDob(member.date_of_birth)}
                  {member.gender ? ` · ${member.gender}` : ''}
                </p>
              </div>
              <span
                class={`shrink-0 text-xs font-medium px-2 py-0.5 rounded-full ${
                  member.status === 'paid' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600'
                }`}
              >
                {member.status === 'paid' ? 'Active' : 'Lapsed'}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-gray-500 text-sm">
          No active members are linked to your account. Please contact the committee if you believe this is incorrect.
        </p>
      )}
    </section>

    <section data-install-guide hidden class="mt-8 sm:mt-10 bg-white border border-gray-200 rounded-lg px-5 py-4">
      <h2 class="font-semibold">Add Harriers to your home screen</h2>
      <p data-install-share-sheet hidden class="text-gray-600 mt-1">
        Tap the Share button, then <strong>Add to Home Screen</strong>. It opens straight to your account, already signed in.
      </p>
      <p data-install-prompt hidden class="text-gray-600 mt-1">Your balance, and the club's tools you help with, a tap away.</p>
      <div class="flex flex-wrap gap-3 mt-3">
        <button type="button" data-install-button hidden class="btn btn-primary">Add to home screen</button>
        <button type="button" data-install-dismiss class="min-h-11 text-gray-500 underline">Don't show this again</button>
      </div>
    </section>

    {/* In the app the section switcher already lists the tools, so these cards
        are for the browser only. */}
    {(holdsRegistration || holdsAdmin) && (
      <section class="browser-only mt-8 sm:mt-10">
        <h2 class="text-lg font-semibold mb-3">Helping out</h2>
        <ul class="-mx-4 sm:mx-0 border-y border-gray-200 sm:border sm:rounded-lg divide-y divide-gray-200 bg-white">
          {holdsRegistration && (
            <li>
              <a href="/registrar/" class="flex items-center justify-between gap-4 px-4 py-3 min-h-15 hover:bg-gray-50 active:bg-gray-100">
                <span>
                  <span class="block font-semibold">Registration</span>
                  <span class="block text-sm text-gray-500">{registrationSummary}</span>
                </span>
                <span aria-hidden="true" class="text-2xl text-gray-300">›</span>
              </a>
            </li>
          )}
          {holdsAdmin && (
            <li>
              <a href="/admin/sessions" class="flex items-center justify-between gap-4 px-4 py-3 min-h-15 hover:bg-gray-50 active:bg-gray-100">
                <span>
                  <span class="block font-semibold">Admin</span>
                  <span class="block text-sm text-gray-500">{adminSummary}</span>
                </span>
                <span aria-hidden="true" class="text-2xl text-gray-300">›</span>
              </a>
            </li>
          )}
        </ul>
      </section>
    )}

    <form method="POST" class="sm:hidden mt-10">
      <input type="hidden" name="action" value="signout" />
      <button type="submit" class="btn btn-secondary w-full">Sign out</button>
    </form>
  </PageContainer>
</Layout>

<script>
  import { INSTALL_GUIDE_DISMISSED_KEY, installGuide } from '../../lib/app/install';
  import { phoneStore } from '../../lib/app/launch';
  import { isApple, isStandalone } from '../../components/registrar/platform';

  interface InstallPrompt extends Event {
    prompt: () => Promise<void>;
  }

  const guide = document.querySelector<HTMLElement>('[data-install-guide]')!;
  const shareSheet = guide.querySelector<HTMLElement>('[data-install-share-sheet]')!;
  const promptText = guide.querySelector<HTMLElement>('[data-install-prompt]')!;
  const button = guide.querySelector<HTMLButtonElement>('[data-install-button]')!;
  let prompt: InstallPrompt | undefined;

  function dismissed(): boolean {
    try {
      return phoneStore.getItem(INSTALL_GUIDE_DISMISSED_KEY) === 'true';
    } catch {
      return false;
    }
  }

  function show() {
    const how = installGuide({
      inApp: isStandalone(),
      dismissed: dismissed(),
      isApple: isApple(),
      hasTouch: window.matchMedia('(pointer: coarse)').matches,
      canPrompt: prompt !== undefined,
    });
    guide.hidden = how === 'none';
    shareSheet.hidden = how !== 'share-sheet';
    promptText.hidden = how !== 'prompt';
    button.hidden = how !== 'prompt';
  }

  function dismiss() {
    try {
      phoneStore.setItem(INSTALL_GUIDE_DISMISSED_KEY, 'true');
    } catch {
      // Refused storage only means the guide comes back next time.
    }
    show();
  }

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    prompt = event as InstallPrompt;
    show();
  });
  button.addEventListener('click', () => {
    void prompt?.prompt();
    dismiss();
  });
  guide.querySelector('[data-install-dismiss]')!.addEventListener('click', dismiss);
  show();
</script>
