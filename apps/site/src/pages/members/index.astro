---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { formatBalance } from '../../lib/credits/money';
import { mayRunASession } from '../../lib/training/registrar';
import { createSupabaseAdminClientFromLocals } from '../../lib/supabase/admin';
import { orThrow } from '../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../lib/auth/signed-in';

// Middleware guarantees auth + active principal + terms accepted before we get here.
// Defensive fallback only.
const { user, principal } = whoIsSignedIn(Astro.locals);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (formData.get('action') === 'signout') {
    await Astro.locals.supabase.auth.signOut();
    return Astro.redirect('/');
  }
}


function formatDob(dob: string): string {
  return new Date(dob).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const balance = orThrow(await Astro.locals.supabase
  .from('principal_balances')
  .select('balance_pence')
  .eq('principal_id', principal.id)
  .maybeSingle());

const balancePence = balance?.balance_pence ?? 0;

// Read with the service role because a login can no longer see a date of birth
// or a gender (migration 0018 limits it to the columns the registrar app
// needs). Scoped to this household's principal, found through the member's own
// session above. The same pattern /members/credits uses for the ledger.
const members = orThrow(await createSupabaseAdminClientFromLocals(Astro.locals)
  .from('members')
  .select('id, first_name, surname, date_of_birth, status, gender')
  .eq('principal_id', principal.id)
  .eq('is_active', true)
  .order('first_name'));
---

<Layout title="Members' Area — Omagh Harriers AC">
  <PageContainer>
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold">Members' area</h1>
        <p class="text-gray-500 mt-1">Welcome back, {principal.display_name}</p>
        <p class="text-gray-400 text-sm mt-1">Signed in as {user.email}</p>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="signout" />
        <button
          type="submit"
          class="text-sm text-gray-500 hover:text-gray-800 underline transition-colors"
        >
          Sign out
        </button>
      </form>
    </div>

    <a
      href="/members/credits"
      class="block bg-gray-50 border border-gray-200 rounded-lg px-5 py-4 mb-10 hover:border-gray-400 transition-colors"
    >
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500">Training credit</p>
          <p
            class:list={[
              'text-2xl font-bold mt-0.5',
              balancePence < 0 ? 'text-red-600' : 'text-gray-900',
            ]}
          >
            {formatBalance(balancePence)}
          </p>
        </div>
        <span class="text-sm underline">View history &rarr;</span>
      </div>
    </a>

    <section>
      <h2 class="text-xl font-semibold mb-4">
        {members && members.length > 0 ? 'Your household' : 'No members found'}
      </h2>

      {
        members && members.length > 0 ? (
          <ul class="space-y-3">
            {members.map((member) => (
              <li class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4 flex items-center justify-between">
                <div>
                  <p class="font-medium">
                    {member.first_name} {member.surname}
                  </p>
                  <p class="text-sm text-gray-500">
                    {formatDob(member.date_of_birth)}
                    {member.gender ? ` · ${member.gender}` : ''}
                  </p>
                </div>
                <span
                  class={`text-xs font-medium px-2.5 py-1 rounded-full ${
                    member.status === 'paid'
                      ? 'bg-green-100 text-green-700'
                      : 'bg-gray-100 text-gray-500'
                  }`}
                >
                  {member.status === 'paid' ? 'Active' : 'Lapsed'}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-500 text-sm">
            No active members are linked to your account. Please contact the
            committee if you believe this is incorrect.
          </p>
        )
      }
    </section>

    {
      mayRunASession(principal.role) && (
        <section class="mt-10 pt-8 border-t border-gray-200">
          <h2 class="text-lg font-semibold mb-3">Taking sign-ins</h2>
          <a
            href="/registrar/"
            class="block bg-gray-900 text-white rounded-lg px-5 py-4 hover:bg-gray-800 transition-colors"
          >
            <span class="block font-semibold">Sign runners in &rarr;</span>
            <span class="block text-sm text-gray-300 mt-0.5">
              Tonight's session, on your phone. Add it to your home screen from there and
              it opens already signed in.
            </span>
          </a>
        </section>
      )
    }

    {
      (principal.role === 'admin' || principal.role === 'superuser') && (
        <section class="mt-10 pt-8 border-t border-gray-200">
          <h2 class="text-lg font-semibold mb-3">Running the club</h2>
          <a
            href="/admin/sessions"
            class="block border border-gray-300 rounded-lg px-5 py-4 hover:bg-gray-50 transition-colors"
          >
            <span class="block font-semibold">Club admin &rarr;</span>
            <span class="block text-sm text-gray-500 mt-0.5">
              Sessions, squads, households, members and training credit.
            </span>
          </a>
        </section>
      )
    }
  </PageContainer>
</Layout>
