---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { formatPounds } from '../../lib/credits/money';
import { formatClubDateTime } from '../../lib/training/club-time';
import { householdHistory } from '../../lib/training/history';
import { everyRow } from '../../lib/supabase/every-row';
import { orThrow } from '../../lib/supabase/or-throw';
import { whoIsSignedIn } from '../../lib/auth/signed-in';

// Middleware guarantees auth + active principal + terms accepted before we get here.
const { principal } = whoIsSignedIn(Astro.locals);

// Read on the member's own session: RLS lets a household read its own
// attendance, the sessions it attended and every squad's name. A registrar or
// admin can read the whole club's attendance, so the household's members are
// named explicitly rather than left to RLS.
const members = orThrow(await Astro.locals.supabase
  .from('members')
  .select('id')
  .eq('principal_id', principal.id));

const memberIds = (members ?? []).map((member) => member.id);

const rows = memberIds.length === 0 ? [] : await everyRow((from, to) =>
  Astro.locals.supabase
    .from('attendance')
    .select('id, member:member_id(id, first_name, surname), session:session_id(id, starts_at, price_pence, group:group_id(name))')
    .in('member_id', memberIds)
    .order('id')
    .range(from, to),
);

type AttendanceRow = {
  id: string;
  member: { id: string; first_name: string; surname: string } | null;
  session: { id: string; starts_at: string; price_pence: number; group: { name: string } | null } | null;
};

const history = householdHistory(
  (rows satisfies AttendanceRow[]).flatMap(({ member, session }) =>
    member && session
      ? [{
          memberId: member.id,
          firstName: member.first_name,
          surname: member.surname,
          session: {
            sessionId: session.id,
            startsAt: session.starts_at,
            squad: session.group?.name ?? 'Session',
            pricePence: session.price_pence,
          },
        }]
      : [],
  ),
);
---

<Layout title="Training history — Omagh Harriers AC">
  <PageContainer>
    <p class="text-sm text-gray-500 mb-6">
      <a href="/members" class="hover:underline">Members' area</a> / Training history
    </p>

    <h1 class="text-3xl font-bold mb-2">Training history</h1>
    <p class="text-gray-600 mb-8">
      The sessions each member of your household was signed in at. What they cost
      comes out of your <a href="/members/credits" class="underline">training credit</a>.
    </p>

    {
      history.length === 0 ? (
        <p class="text-gray-500 text-sm">
          Nobody in your household has been signed in at a session yet. Sessions will
          appear here once a registrar signs them in.
        </p>
      ) : (
        history.map((member) => (
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-1">{member.name}</h2>
            <p class="text-sm text-gray-500 mb-3">
              {member.total === 1 ? '1 session' : `${member.total} sessions`}
              {member.total > member.shown.length && `, the ${member.shown.length} most recent shown`}
            </p>
            <ul class="divide-y divide-gray-200 border-t border-b border-gray-200">
              {member.shown.map((session) => (
                <li class="py-3 flex items-baseline justify-between gap-4">
                  <div>
                    <p class="font-medium">{session.squad}</p>
                    <p class="text-sm text-gray-500 mt-0.5">{formatClubDateTime(session.startsAt)}</p>
                  </div>
                  <span class="text-sm text-gray-600 tabular-nums whitespace-nowrap">
                    {session.pricePence === 0 ? 'Free' : formatPounds(session.pricePence)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </PageContainer>
</Layout>
