---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout
  title="Club Policies - Omagh Harriers AC"
  description="Club policies, constitution, codes of conduct, and governance documents for Omagh Harriers AC"
>
  <section class="relative h-[280px] sm:h-[400px] md:h-[600px] flex items-end">
    <img
      src="/aerial-shot.jpg"
      alt="Aerial view of Omagh Harriers running community"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/10"></div>

    <div class="relative z-10 w-full px-4 sm:px-6 lg:px-8 pb-8 sm:pb-12 max-w-7xl mx-auto">
      <span class="inline-block text-amber text-xs sm:text-sm font-semibold tracking-widest uppercase mb-3">
        Omagh Harriers AC
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-3 leading-tight">
        Club Policies
      </h1>
      <div class="min-h-[48px] sm:min-h-[132px]">
        <p class="hidden sm:block text-lg sm:text-xl text-gray-200 max-w-2xl">
          Our governance documents and codes of conduct
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <p class="text-gray-700 mb-12">
          Omagh Harriers AC is committed to providing a safe, inclusive, and supportive environment for all members.
          Our policies and procedures ensure we maintain the highest standards of governance and member welfare.
        </p>

        <div class="grid gap-8">
          <!-- Committee & Coaches -->
          <a href="/policies/committee-coaches" class="block bg-gray-50 rounded-lg p-6 border-l-4 border-amber hover:bg-gray-100 transition-colors cursor-pointer">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Committee & Coaches</h2>
            <p class="text-gray-700 mb-4">
              Information about our club committee members and qualified coaches who lead training sessions
              and support club activities. Elected November 26, 2025.
            </p>
            <span class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors">
              View Committee & Coaches
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>

          <!-- Club Constitution -->
          <a href="/policies/club-constitution" class="block bg-gray-50 rounded-lg p-6 border-l-4 border-amber hover:bg-gray-100 transition-colors cursor-pointer">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Club Constitution</h2>
            <p class="text-gray-700 mb-4">
              Our constitution sets out the rules and regulations that govern how Omagh Harriers AC operates,
              including membership, committee structure, and club objectives. Adopted March 13, 2025.
            </p>
            <span class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors">
              Read Constitution
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>

          <!-- Communication & Respect -->
          <a href="/policies/communication-respect" class="block bg-gray-50 rounded-lg p-6 border-l-4 border-amber hover:bg-gray-100 transition-colors cursor-pointer">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Communication & Respect</h2>
            <p class="text-gray-700 mb-4">
              Our policy on respectful communication within the club, covering interactions between members,
              coaches, and committee. December 2024.
            </p>
            <span class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors">
              Read Policy
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>

          <!-- Annual AGM Process -->
          <a href="/policies/annual-agm-process" class="block bg-gray-50 rounded-lg p-6 border-l-4 border-amber hover:bg-gray-100 transition-colors cursor-pointer">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Annual AGM Process</h2>
            <p class="text-gray-700 mb-4">
              Information about our Annual General Meeting, including procedures, member participation, and governance. December 2024.
            </p>
            <span class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors">
              View AGM Process
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>

          <!-- Committee Code of Conduct -->
          <a href="/policies/committee-code-of-conduct" class="block bg-gray-50 rounded-lg p-6 border-l-4 border-amber hover:bg-gray-100 transition-colors cursor-pointer">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Committee Code of Conduct</h2>
            <p class="text-gray-700 mb-4">
              Ethical guidelines and standards of behavior expected of all committee members in their roles. December 2024.
            </p>
            <span class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors">
              Read Code of Conduct
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>

          <!-- Safeguarding & Digital Media -->
          <a href="/policies/safeguarding-digital-media" class="block bg-gray-50 rounded-lg p-6 border-l-4 border-amber hover:bg-gray-100 transition-colors cursor-pointer">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Safeguarding & Digital Media</h2>
            <p class="text-gray-700 mb-4">
              Our safeguarding policies and guidelines for the appropriate use of photos, videos, and digital media
              involving club members. Ratified November 18, 2024.
            </p>
            <span class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors">
              Read Safeguarding Policy
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>

          <!-- Other Policies & Documents -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-4 text-gray-900">Other Policies & Documents</h2>
            <p class="text-gray-700 mb-4">
              Additional club policies and documents available to members:
            </p>
            <ul class="space-y-3 text-gray-700">
              <li><a href="/policies/membership-athletics-ni" class="text-black hover:text-amber transition-colors font-semibold">1. Membership: Club & Athletics NI Number</a></li>
              <li><a href="/policies/raising-concern" class="text-black hover:text-amber transition-colors font-semibold">2. Raising a Concern Within the Club</a></li>
              <li><a href="https://athleticsni.org/Safeguarding" rel="noopener noreferrer" class="text-black hover:text-amber transition-colors font-semibold">3. Adult & Child Protection Policies</a> - as per Athletics NI Guidelines</li>
              <li><a href="/policies/purchasing-equipment" class="text-black hover:text-amber transition-colors font-semibold">4. Purchasing of Items & Equipment</a></li>
              <li><a href="/policies/junior-senior-representation" class="text-black hover:text-amber transition-colors font-semibold">5. Junior & Senior Representation</a></li>
              <li><a href="/policies/london-marathon-draw" class="text-black hover:text-amber transition-colors font-semibold">6. London Marathon Entry Draw</a></li>
              <li><a href="/policies/coaching-courses-funding" class="text-black hover:text-amber transition-colors font-semibold">7. Coaching Courses & Funding</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Athletics NI Affiliation -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold mb-4">Fully Registered & Affiliated</h2>
      <p class="text-gray-700 mb-6">
        Omagh Harriers AC is fully registered and affiliated with Athletics NI.
      </p>
      <a
        href="https://athleticsni.org/Clubs"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-black text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors"
      >
        Visit Athletics NI
      </a>
    </div>
  </section>
</Layout>
