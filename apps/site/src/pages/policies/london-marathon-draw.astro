---
import Layout from '../../layouts/Layout.astro';
---

<Layout
    title="London Marathon Entry Draw - Omagh Harriers AC"
    description="Annual London Marathon Entry Draw Process"
>
  <section class="relative h-[280px] sm:h-[400px] md:h-[600px] flex items-center justify-center">
    <img
      src="/aerial-shot.jpg"
      alt="Aerial view of Omagh Harriers running community"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/10"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">London Marathon Entry Draw</h1>
      <p class="text-xl md:text-2xl text-amber mb-8">
        Fair allocation process for the club's London Marathon place
      </p>
    </div>
  </section>

  <section class="pt-16 pb-0 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <!-- Purpose -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-4 text-gray-900">Purpose</h3>
          <p class="text-gray-700 mb-6">To ensure a fair and transparent process for allocating the club&rsquo;s London Marathon entry place(s).</p>
        </div>

        <!-- Eligibility Criteria -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-4 text-gray-900">Eligibility Criteria</h3>
          <ol class="list-decimal pl-6 space-y-4 text-gray-700">
            <li><strong>Membership Duration</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Only senior members who have been fully paid-up members of Omagh Harriers A.C. for at least one full
                  year before the draw date are eligible.
                </li>
              </ul>
            </li>
            <li><strong>Previous Allocation</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Members who have previously been selected for and used the club&rsquo;s London Marathon place are not
                  eligible.
                </li>
              </ul>
            </li>
            <li><strong>Club Involvement</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Members must actively participate in club activities such as training, events, or volunteering.</li>
              </ul>
            </li>
          </ol>
        </div>

        <!-- Draw Process -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-4 text-gray-900">Draw Process</h3>
          <ol class="list-decimal pl-6 space-y-4 text-gray-700">
            <li><strong>Notification</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Members will be informed of the draw in advance through club communication channels.</li>
              </ul>
            </li>
            <li><strong>Applications</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Interested members must submit their application by the specified deadline.</li>
              </ul>
            </li>
            <li><strong>Verification</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>The committee will confirm applicants meet all eligibility criteria.</li>
              </ul>
            </li>
            <li><strong>Conducting the Draw</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>The draw will be held at a club event, with members present for transparency.</li>
                <li>An impartial person or committee member will oversee the draw.</li>
              </ul>
            </li>
            <li><strong>Reserve Selection</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Reserve names will be drawn to replace the winner if they cannot take up the place.</li>
              </ul>
            </li>
          </ol>
        </div>

        <!-- Post-Draw Process -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-4 text-gray-900">Post-Draw Process</h3>
          <ol class="list-decimal pl-6 space-y-4 text-gray-700">
            <li><strong>Confirmation</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>The winner must confirm their intention to use the entry and meet London Marathon deadlines.</li>
              </ul>
            </li>
            <li><strong>Withdrawal</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>If the winner withdraws, the place will be offered to the reserve in order of selection.</li>
              </ul>
            </li>
          </ol>
        </div>

        <!-- General Rules -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-4 text-gray-900">General Rules</h3>
          <ul class="list-disc pl-6 space-y-2 text-gray-700">
            <li>The club&rsquo;s decisions on eligibility and results are final.</li>
            <li>The draw is held annually, subject to the club being allocated a London Marathon entry.</li>
            <li>Any disputes will be resolved by the committee in line with the club&rsquo;s constitution.</li>
          </ul>
          <p class="text-gray-700 mt-6 mb-6"><strong>Approved by</strong>: Omagh Harriers A.C. Committee<br/><strong>Date</strong>: December 2024</p>
        </div>

        <!-- Logo -->
        <div class="mt-12 text-center">
          <img src="/omagh-harriers_black.png" alt="Omagh Harriers AC Logo" width="408" height="160" class="mx-auto" />
        </div>
        <div class="mt-12 pt-8 border-t border-gray-200">
          <a
            href="/policies"
            class="inline-flex items-center text-black hover:text-amber transition-colors font-semibold"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Policies
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
