---
import '../../styles/global.css';
import { RegistrarApp } from '../../components/registrar/RegistrarApp';

// Prerendered on purpose, and this is the decision the whole route turns on.
//
// A registrar opens this at a track, in the rain, sometimes with no signal. A
// server-rendered page is a round trip every time the icon is tapped, so offline
// it is a blank screen. A static shell can be cached and opened with no network
// at all, and the data arrives from the browser's own Supabase client.
//
// It also removes a whole class of bug: there is no server-rendered HTML here
// that could be cached with one registrar's data in it and handed to the next.
//
// Nothing is gated here, and nothing can be — middleware does not run for a
// static asset. That is correct rather than a gap. What this file serves is an
// empty shell; every read and write inside it is gated by RLS, and the role on
// the token decides only what gets drawn. Adding a middleware rule for
// `/registrar` would buy nothing and would break opening the app offline.
export const prerender = true;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1120" />
    <meta name="description" content="Sign runners in at Omagh Harriers training." />
    <meta name="robots" content="noindex" />

    <!-- Only this route links a manifest, so Add to Home Screen from anywhere
         else on the site bookmarks an ordinary page instead of installing this.
         The scope keeps the installed window on /registrar: tapping through to
         the rest of the site opens the browser rather than turning the app into
         a browser. -->
    <link rel="manifest" href="/registrar/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/registrar/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Harriers Sign-in" />

    <title>Harriers Sign-in</title>
  </head>
  <body class="bg-black text-white antialiased">
    <RegistrarApp client:only="react" />
    <noscript>
      <main class="mx-auto max-w-xl px-5 py-10">
        <h1 class="text-2xl font-bold">Sign runners in</h1>
        <p class="mt-3 text-lg text-neutral-300">This needs JavaScript switched on.</p>
      </main>
    </noscript>
  </body>
</html>

<style is:global>
  /* Structural only, and belongs to this page alone — it is inlined into this
     page's HTML and never reaches the public site's shared bundle. The accent
     is the club's amber from global.css; everything else is Tailwind's own
     neutrals, matching the prototype. */
  :root {
    color-scheme: dark;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
      env(safe-area-inset-left);
    -webkit-text-size-adjust: 100%;
  }

  /* A mis-tap is the failure this screen exists to avoid, so nothing is a drag
     target and nothing double-tap zooms. */
  button,
  a,
  input {
    touch-action: manipulation;
  }
</style>
