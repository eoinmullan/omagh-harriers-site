---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
import { providerForEmail, type OAuthProvider } from '../lib/auth/oauth-providers';
import { whereToAfterSignIn } from '../lib/auth/after-sign-in';
import { checkSignInCode, codeRefusedSentence, SIGN_IN_CODE_LENGTH } from '../lib/auth/sign-in-code';
import { emailTheMember, sendSignInEmail, tidyEmail, whyNotThisMember } from '../lib/auth/sign-in-email';
import { signInEmailSteps } from '../lib/auth/sign-in-email-steps';

const INTENDED_EMAIL_COOKIE = 'oauth_intended_email';

let codeEntryFor: string | undefined;
let codeProblem: string | undefined;
let enteredEmail = '';
let errorMessage: string | undefined;
let providerChoice: { email: string; provider: OAuthProvider } | undefined;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = tidyEmail(formData.get('email')?.toString() ?? '');
  const turnstileToken = formData.get('cf-turnstile-response')?.toString() ?? '';
  const steps = signInEmailSteps(Astro);
  enteredEmail = email;

  if (formData.has('code')) {
    codeEntryFor = email;
    const check = checkSignInCode(formData.get('code')?.toString() ?? '');
    if ('problem' in check) {
      codeProblem = check.problem;
    } else {
      const { data, error } = await Astro.locals.supabase.auth.verifyOtp({
        email,
        token: check.code,
        type: 'email',
      });
      if (error) console.error('[signin] verifyOtp failed:', error.status, error.code);
      if (!error && data.user) return Astro.redirect(await whereToAfterSignIn(Astro.locals.supabase, data.user.id));
      codeProblem = codeRefusedSentence({ status: error?.status, code: error?.code });
    }
  } else if (formData.get('email_link') === 'true') {
    const outcome = await sendSignInEmail(steps, email, turnstileToken);
    if (outcome.sent) codeEntryFor = outcome.email;
    else errorMessage = outcome.problem;
  } else {
    errorMessage = await whyNotThisMember(steps, email, turnstileToken);
    const provider = errorMessage ? undefined : providerForEmail(email, new Date());

    if (provider) {
      providerChoice = { email, provider };
    } else if (!errorMessage) {
      const outcome = await emailTheMember(steps, email);
      if (outcome.sent) codeEntryFor = outcome.email;
      else errorMessage = outcome.problem;
    }
  }
}

if (providerChoice) {
  Astro.cookies.set(INTENDED_EMAIL_COOKIE, providerChoice.email, {
    httpOnly: true,
    secure: !import.meta.env.DEV,
    sameSite: 'lax',
    path: '/',
    maxAge: 600,
  });
} else {
  Astro.cookies.delete(INTENDED_EMAIL_COOKIE, { path: '/' });
}

const notRegisteredMessage =
  "That account isn't registered for members' access. Sign in with the email address used for your Klubfunder registration, or contact the committee if you think this is an error.";

const urlErrorMessages: Record<string, string> = {
  invalid_link: 'That sign-in link is invalid or has expired. Please request a new one.',
  access_denied: notRegisteredMessage,
  not_registered: notRegisteredMessage,
  wrong_account:
    "Your account signed in under a different email address than the one you entered, so we couldn't match it to your membership. Ask us for a sign-in link by email instead, or check which address that account uses.",
};

const urlErrorMessage = urlErrorMessages[Astro.url.searchParams.get('error') ?? ''];

const siteKey = import.meta.env.DEV ? undefined : import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Sign in — Omagh Harriers AC">
  <PageContainer width="form">
    <h1 class="text-3xl font-bold mb-2">Members sign in</h1>
    <p class="text-gray-600 mb-8">
      {
        providerChoice
          ? 'Choose how you’d like to sign in.'
          : 'Sign in with the email address on your Omagh Harriers membership.'
      }
    </p>

    {
      codeEntryFor ? (
        <>
          <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
            <h2 class="font-semibold text-green-800 mb-1">Check your email</h2>
            <p class="text-green-700 text-sm break-words">
              We've sent an email to <strong>{codeEntryFor}</strong>. Click the link in it, or
              type the {SIGN_IN_CODE_LENGTH}-digit code from it here.
            </p>
          </div>

          {codeProblem && (
            <div role="alert" class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700 text-sm mb-6">
              {codeProblem}
            </div>
          )}

          <form method="POST" class="space-y-4" data-busy-button="code">
            <input type="hidden" name="email" value={codeEntryFor} />
            <div>
              <label for="code" class="block text-sm font-medium text-gray-700 mb-1">
                Sign-in code
              </label>
              <input
                id="code"
                name="code"
                type="text"
                required
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength={SIGN_IN_CODE_LENGTH + 3}
                autofocus
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-2xl tracking-[0.3em] font-mono focus:outline-none focus:ring-2 focus:ring-amber-400"
              />
            </div>

            <button
              id="code-btn"
              type="submit"
              data-idle-label="Sign in"
              data-busy-label="Checking…"
              class="w-full min-h-11 bg-black text-yellow font-semibold py-2 px-4 rounded-md hover:bg-gray-900 transition-colors flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <svg id="code-spinner" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span id="code-btn-label">Sign in</span>
            </button>
          </form>

          <form method="POST" class="mt-6 space-y-3" data-busy-button="resend">
            <input type="hidden" name="email" value={codeEntryFor} />
            <input type="hidden" name="email_link" value="true" />

            {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" />}

            <button
              id="resend-btn"
              type="submit"
              data-idle-label="Send another"
              data-busy-label="Sending…"
              class="w-full min-h-11 border border-gray-300 bg-white text-gray-700 font-medium py-2 px-4 rounded-md hover:bg-gray-50 transition-colors flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <svg id="resend-spinner" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span id="resend-btn-label">Send another</span>
            </button>
            <p class="text-sm text-gray-500">
              Wrong address? <a href="/signin" class="underline hover:text-gray-800">Start again</a>.
            </p>
          </form>
        </>
      ) : (
        <>
          {(errorMessage || urlErrorMessage) && (
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700 text-sm mb-6">
              {errorMessage ?? urlErrorMessage}
            </div>
          )}

          {providerChoice ? (
            <>
              <div class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 mb-6 flex items-center justify-between gap-3">
                <p class="text-sm text-gray-700 truncate">{providerChoice.email}</p>
                <a href="/signin" class="text-sm text-gray-500 underline hover:text-gray-800 shrink-0">
                  Change
                </a>
              </div>

              <button
                id="provider-btn"
                type="button"
                data-provider={providerChoice.provider.supabaseProvider}
                data-email={providerChoice.email}
                data-idle-label={`Continue with ${providerChoice.provider.name}`}
                data-busy-label={`Taking you to ${providerChoice.provider.name}…`}
                class="w-full border border-gray-300 bg-white text-gray-700 font-medium py-2 px-4 rounded-md hover:bg-gray-50 transition-colors flex items-center justify-center gap-3 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <svg id="provider-spinner" class="hidden animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>

                {providerChoice.provider.supabaseProvider === 'google' ? (
                  <svg id="provider-icon" class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                  </svg>
                ) : (
                  <svg id="provider-icon" class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.4 2H2v9.4h9.4V2z" fill="#F25022"/>
                    <path d="M22 2h-9.4v9.4H22V2z" fill="#7FBA00"/>
                    <path d="M11.4 12.6H2V22h9.4v-9.4z" fill="#00A4EF"/>
                    <path d="M22 12.6h-9.4V22H22v-9.4z" fill="#FFB900"/>
                  </svg>
                )}
                <span id="provider-btn-label">Continue with {providerChoice.provider.name}</span>
              </button>

              <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-gray-200" />
                </div>
                <div class="relative flex justify-center text-sm">
                  <span class="bg-white px-3 text-gray-400">or</span>
                </div>
              </div>

              <form method="POST" class="space-y-4" data-busy-button="signin">
                <input type="hidden" name="email" value={providerChoice.email} />
                <input type="hidden" name="email_link" value="true" />

                {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" />}

                <button
                  id="signin-btn"
                  type="submit"
                  data-idle-label="Email me a sign-in link"
                  data-busy-label="Sending…"
                  class="w-full bg-black text-yellow font-semibold py-2 px-4 rounded-md hover:bg-gray-900 transition-colors flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <svg id="signin-spinner" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                  </svg>
                  <span id="signin-btn-label">Email me a sign-in link</span>
                </button>
              </form>
            </>
          ) : (
            <form method="POST" class="space-y-4" data-busy-button="signin">
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                  Membership email address
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  autofocus
                  value={enteredEmail}
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-400"
                  placeholder="you@example.com"
                />
              </div>

              {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" />}

              <button
                id="signin-btn"
                type="submit"
                data-idle-label="Continue"
                data-busy-label="Just a moment…"
                class="w-full bg-black text-yellow font-semibold py-2 px-4 rounded-md hover:bg-gray-900 transition-colors flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <svg id="signin-spinner" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span id="signin-btn-label">Continue</span>
              </button>
            </form>
          )}
        </>
      )
    }

    <p class="mt-6 text-sm text-gray-500">
      Not a member yet? Find out more about{' '}
      <a href="/juniors" class="underline hover:text-gray-700">junior</a> and{' '}
      <a href="/about" class="underline hover:text-gray-700">senior</a> membership.
    </p>
  </PageContainer>

  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <script>
    import { createSupabaseBrowserClient } from '../lib/supabase/browser';

    function setButtonBusy(name: string, busy: boolean) {
      const button = document.getElementById(`${name}-btn`) as HTMLButtonElement | null;
      if (!button) return;

      button.disabled = busy;
      document.getElementById(`${name}-icon`)?.classList.toggle('hidden', busy);
      document.getElementById(`${name}-spinner`)?.classList.toggle('hidden', !busy);

      const label = document.getElementById(`${name}-btn-label`);
      const text = busy ? button.dataset.busyLabel : button.dataset.idleLabel;
      if (label && text) label.textContent = text;
    }

    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-busy-button]')) {
      form.addEventListener('submit', () => setButtonBusy(form.dataset.busyButton!, true));
    }

    const providerButton = document.getElementById('provider-btn') as HTMLButtonElement | null;

    providerButton?.addEventListener('click', async () => {
      setButtonBusy('provider', true);
      const supabase = createSupabaseBrowserClient();
      // login_hint spares the member typing the address they just gave us.
      const loginHint = providerButton.dataset.email;
      const { error } = await supabase.auth.signInWithOAuth({
        provider: providerButton.dataset.provider as 'google' | 'azure',
        options: {
          redirectTo: `${window.location.origin}/signin/callback`,
          scopes: 'email',
          queryParams: loginHint ? { login_hint: loginHint } : undefined,
        },
      });
      if (error) {
        setButtonBusy('provider', false);
        window.location.href = '/signin?error=invalid_link';
      }
    });

    // Coming back from the provider restores the page from the back/forward
    // cache mid-redirect, spinner and all, so settle the buttons on arrival.
    window.addEventListener('pageshow', () => {
      for (const name of ['signin', 'code', 'resend', 'provider']) setButtonBusy(name, false);
    });
  </script>
</Layout>
