---
import Layout from '../layouts/Layout.astro';
import { createSupabaseAdminClientFromLocals } from '../lib/supabase/admin';

let sent = false;
let errorMessage: string | undefined;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email')?.toString().trim().toLowerCase() ?? '';
  const turnstileToken = formData.get('cf-turnstile-response')?.toString() ?? '';

  const captchaOk = await verifyCaptcha(turnstileToken);
  if (!captchaOk) {
    errorMessage = 'Please complete the security check and try again.';
  } else {
    const admin = createSupabaseAdminClientFromLocals(Astro.locals);

    const { data: principal, error: principalError } = await admin
      .from('principals')
      .select('id, is_active')
      .eq('email', email)
      .maybeSingle();

    if (principalError) console.error('[signin] principals lookup failed:', principalError);

    if (!principal || !principal.is_active) {
      // Artificial delay so timing doesn't reveal whether the email exists.
      await new Promise((resolve) => setTimeout(resolve, 2000));
      errorMessage = !principal
        ? "This email isn't on our member list — please contact the committee."
        : 'Your membership is no longer active — please contact the committee.';
    } else {
      const callbackUrl = new URL('/signin/callback', Astro.url).href;
      const { error } = await Astro.locals.supabase.auth.signInWithOtp({
        email,
        options: {
          shouldCreateUser: false,
          emailRedirectTo: callbackUrl,
        },
      });
      if (error) {
        console.error('[signin] signInWithOtp failed:', error);
        errorMessage =
          error.status === 429
            ? 'Too many sign-in attempts — please wait a few minutes and try again.'
            : 'Something went wrong sending the sign-in link. Please try again.';
      } else {
        sent = true;
      }
    }
  }
}

async function verifyCaptcha(token: string): Promise<boolean> {
  if (import.meta.env.DEV) return true;
  if (!import.meta.env.TURNSTILE_SECRET_KEY) return true;

  const res = await fetch(
    'https://challenges.cloudflare.com/turnstile/v0/siteverify',
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        secret: import.meta.env.TURNSTILE_SECRET_KEY,
        response: token,
      }),
    },
  );
  const { success } = (await res.json()) as { success: boolean };
  return success;
}

const urlError = Astro.url.searchParams.get('error');
const invalidLinkMessage =
  urlError === 'invalid_link'
    ? 'That sign-in link is invalid or has expired. Please request a new one.'
    : urlError === 'access_denied'
      ? "This email isn't registered for members' access — please contact the committee if you think this is an error."
      : undefined;

const siteKey = import.meta.env.DEV ? undefined : import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Sign in — Omagh Harriers AC">
  <div class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-2">Members sign in</h1>
    <p class="text-gray-600 mb-8">
      Enter the email address used with your Klubfunder registration and we'll send you a sign-in link.
    </p>

    {
      sent ? (
        <div class="bg-green-50 border border-green-200 rounded-lg p-6">
          <h2 class="font-semibold text-green-800 mb-1">Check your email</h2>
          <p class="text-green-700 text-sm">
            We've sent a sign-in link to your email address. Click the link in
            the email to continue.
          </p>
        </div>
      ) : (
        <form method="POST" class="space-y-4">
          {(errorMessage || invalidLinkMessage) && (
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700 text-sm">
              {errorMessage ?? invalidLinkMessage}
            </div>
          )}

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
              Email address
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-400"
              placeholder="you@example.com"
            />
          </div>

          {siteKey && (
            <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" />
          )}

          <button
            id="signin-btn"
            type="submit"
            class="w-full bg-black text-yellow font-semibold py-2 px-4 rounded-md hover:bg-gray-900 transition-colors flex items-center justify-center gap-2"
          >
            <svg id="signin-spinner" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span id="signin-btn-label">Send sign-in link</span>
          </button>
        </form>

        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-200" />
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="bg-white px-3 text-gray-400">or sign in with</span>
          </div>
        </div>

        <div class="space-y-3">
          <button
            id="google-btn"
            type="button"
            class="w-full border border-gray-300 bg-white text-gray-700 font-medium py-2 px-4 rounded-md hover:bg-gray-50 transition-colors flex items-center justify-center gap-3"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Sign in with Google
          </button>

          <button
            id="microsoft-btn"
            type="button"
            class="w-full border border-gray-300 bg-white text-gray-700 font-medium py-2 px-4 rounded-md hover:bg-gray-50 transition-colors flex items-center justify-center gap-3"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M11.4 2H2v9.4h9.4V2z" fill="#F25022"/>
              <path d="M22 2h-9.4v9.4H22V2z" fill="#7FBA00"/>
              <path d="M11.4 12.6H2V22h9.4v-9.4z" fill="#00A4EF"/>
              <path d="M22 12.6h-9.4V22H22v-9.4z" fill="#FFB900"/>
            </svg>
            Sign in with Microsoft
          </button>
        </div>
      )
    }

    <p class="mt-6 text-sm text-gray-500">
      Not a member yet? Find out more about{' '}
      <a href="/juniors" class="underline hover:text-gray-700">junior</a> and{' '}
      <a href="/about" class="underline hover:text-gray-700">senior</a> membership.
    </p>
  </div>

  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <script>
    import { createSupabaseBrowserClient } from '../lib/supabase/browser';

    document.querySelector('form')?.addEventListener('submit', () => {
      const btn = document.getElementById('signin-btn') as HTMLButtonElement;
      const spinner = document.getElementById('signin-spinner');
      const label = document.getElementById('signin-btn-label');
      btn.disabled = true;
      spinner?.classList.remove('hidden');
      if (label) label.textContent = 'Sending…';
    });

    const supabase = createSupabaseBrowserClient();
    const callbackUrl = `${window.location.origin}/signin/callback`;

    async function signInWithProvider(provider: 'google' | 'azure') {
      const btn = document.getElementById(`${provider === 'google' ? 'google' : 'microsoft'}-btn`) as HTMLButtonElement;
      btn.disabled = true;
      await supabase.auth.signInWithOAuth({
        provider,
        options: { redirectTo: callbackUrl },
      });
    }

    document.getElementById('google-btn')?.addEventListener('click', () => signInWithProvider('google'));
    document.getElementById('microsoft-btn')?.addEventListener('click', () => signInWithProvider('azure'));
  </script>
</Layout>
