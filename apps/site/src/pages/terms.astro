---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms & Conditions — Omagh Harriers AC">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-2">Terms & Conditions</h1>
    <p class="text-sm text-gray-500 mb-8">Last updated: May 2026</p>

    <div class="prose prose-sm max-w-none text-gray-700 space-y-6">
      <p>
        These terms govern your use of the Omagh Harriers AC members' area. By
        accessing the members' area you agree to these terms.
      </p>

      <h2 class="text-lg font-semibold text-gray-900">Access</h2>
      <p>
        Access is restricted to current paid members of Omagh Harriers AC. Your
        account is personal and your sign-in link should not be shared with
        anyone else.
      </p>

      <h2 class="text-lg font-semibold text-gray-900">Your data</h2>
      <p>
        The members' area displays information held about your household. If any
        information is incorrect please contact the club committee. See our{' '}
        <a href="/privacy" class="underline hover:text-gray-900">privacy notice</a>{' '}
        for details of how we handle your data.
      </p>

      <h2 class="text-lg font-semibold text-gray-900">Acceptable use</h2>
      <p>
        You must not attempt to access another member's account or data, or use
        the members' area for any purpose other than managing your household's
        membership and training account.
      </p>

      <h2 class="text-lg font-semibold text-gray-900">Changes</h2>
      <p>
        These terms may be updated from time to time. Continued use of the
        members' area after a change constitutes acceptance of the revised terms.
      </p>

      <p class="text-sm text-gray-400 italic">
        Final wording to be approved by the club committee.
      </p>
    </div>
  </div>
</Layout>
