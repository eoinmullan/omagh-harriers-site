      src="/aerial-shot.jpg"
      alt="Aerial view of Omagh on race day"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/5 md:from-black/10 md:to-black/10"></div>
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-6 sm:pb-10 md:pb-16">
      <div class="inline-block bg-amber text-black text-xs sm:text-sm font-bold px-3 py-1 rounded mb-2 sm:mb-4 uppercase tracking-wide">
        36th edition · 29 March 2026
      </div>
      <h1 class="text-2xl sm:text-5xl md:text-6xl font-bold text-white mb-2 sm:mb-3 leading-tight">
        SPAR Omagh Half Marathon & 5K
      </h1>
      <p class="hidden sm:block text-base sm:text-xl text-gray-200 mb-6 max-w-2xl">
        Despite the downpours, the energy never dipped. Thank you to everyone who made race day what it was.
      </p>
      <div class="flex flex-wrap gap-3">
