---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Omagh Half Marathon - March 29, 2026"
  description="Join us for the Omagh Half Marathon & 5K on Sunday, March 29, 2026. A premier Irish half marathon."
>
  <!-- Hero Section -->
  <section class="relative h-[280px] sm:h-[400px] md:h-[600px] flex items-center justify-center">
    <img
      src="/aerial-shot.jpg"
      alt="Aerial view of Omagh Harriers running community"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-4">
        Omagh Half Marathon
      </h1>
      <p class="text-2xl md:text-3xl text-amber mb-6 font-bold">
        Sunday, March 29, 2026
      </p>
      <p class="text-xl text-gray-200 mb-8">
        Omagh Leisure Complex
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center hidden sm:block">
        <a
            href="https://omaghhalfmarathon.run/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-amber text-black px-8 py-3 rounded-lg font-bold text-lg hover:bg-yellow-400 transition-colors"
        >
          Visit Official Race Site
        </a>
      </div>
    </div>
  </section>

  <!-- Registration Status -->
  <section class="py-12 bg-amber/10 border-y border-amber">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Half marathon button for mobile -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center block sm:hidden">
          <a
              href="https://omaghhalfmarathon.run/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-amber text-black px-8 py-3 rounded-lg font-bold text-lg hover:bg-yellow-400 transition-colors text-center max-w-xs mx-auto"
          >
            Visit Official Race Site
          </a>
        </div>
        <div class="text-center p-6">
          <h3 class="text-2xl font-bold mb-2">Half Marathon</h3>
          <p class="text-red-600 font-bold text-lg mb-2">SOLD OUT</p>
          <p class="text-gray-600">All places for the 2026 half marathon have been filled</p>
        </div>
        <div class="text-center p-6">
          <h3 class="text-2xl font-bold mb-2">5K Run</h3>
          <p class="text-green-600 font-bold text-lg mb-2">PLACES AVAILABLE</p>
          <p class="text-gray-600">Registration still open for the 5K event</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Event Information -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12">Event Information</h2>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div class="text-center p-6 bg-gray-50 rounded-lg">
          <div class="w-16 h-16 bg-amber rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-xl mb-2">Race Date</h3>
          <p class="text-gray-700">Sunday, March 29, 2026</p>
        </div>

        <div class="text-center p-6 bg-gray-50 rounded-lg">
          <div class="w-16 h-16 bg-amber rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-xl mb-2">Location</h3>
          <p class="text-gray-700">Omagh Leisure Complex</p>
        </div>

        <div class="text-center p-6 bg-gray-50 rounded-lg">
          <div class="w-16 h-16 bg-amber rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-xl mb-2">Participants</h3>
          <p class="text-gray-700">Over 2,500 runners annually</p>
        </div>
      </div>

      <!-- About the Race -->
      <div class="prose prose-lg max-w-none">
        <div class="bg-gray-50 rounded-lg p-8 mb-8">
          <h3 class="text-3xl font-bold mb-4">About the Race</h3>
          <p class="text-gray-700 mb-4">
            The Omagh Half Marathon is one of Ireland's premier road racing events, attracting over 2,500
            participants each year. Organized by Omagh Harriers AC, this event showcases the best of Omagh and
            provides a fantastic challenge for runners of all abilities.
          </p>
          <p class="text-gray-700">
            The event is made possible by a dedicated committee of 10 people and approximately 200 volunteers
            on race day, ensuring a well-organized and memorable experience for all participants.
          </p>
        </div>

        <!-- Race Categories -->
        <div class="mb-8">
          <h3 class="text-3xl font-bold mb-6">Race Categories</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="border-l-4 border-amber pl-6 py-4">
              <h4 class="text-2xl font-bold mb-2">Half Marathon</h4>
              <p class="text-gray-700 mb-3">
                13.1 miles of challenging road racing through Omagh and surrounding areas.
              </p>
              <p class="text-sm text-gray-600 italic">
                Note: Course underwent minor modifications in 2022 to accommodate the Sunday race day schedule.
              </p>
            </div>
            <div class="border-l-4 border-amber pl-6 py-4">
              <h4 class="text-2xl font-bold mb-2">5K Run</h4>
              <p class="text-gray-700">
                A shorter distance option perfect for those new to racing or looking for a faster-paced event.
              </p>
            </div>
          </div>
        </div>

        <!-- Team Prizes -->
        <div class="bg-amber/10 border border-amber rounded-lg p-6 mb-8">
          <h4 class="text-2xl font-bold mb-3">Team Competitions</h4>
          <p class="text-gray-700 mb-3">
            <strong>New:</strong> Non-athletic sports club team prizes are now available in both junior and senior categories.
          </p>
          <ul class="list-disc list-inside space-y-2 text-gray-700">
            <li>Under-19s team category</li>
            <li>Adult team category</li>
          </ul>
        </div>

        <!-- Registration -->
        <div class="mb-8">
          <h3 class="text-3xl font-bold mb-6">Registration</h3>
          <p class="text-gray-700 mb-4">
            <strong>Entry Opening Date:</strong> October 3rd (for following year's race)
          </p>
          <p class="text-gray-700 mb-6">
            Registration is managed through SI Entries. The half marathon typically sells out well in advance,
            so early registration is strongly recommended.
          </p>
          <a
            href="https://omaghhalfmarathon.run/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-black text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors"
          >
            Register on Official Site
          </a>
        </div>

        <!-- Parking & Logistics -->
        <div class="bg-gray-50 rounded-lg p-6 mb-8">
          <h4 class="text-2xl font-bold mb-3">Parking & Start/Finish</h4>
          <p class="text-gray-700 mb-3">
            Both the start and finish line are located at Omagh Leisure Complex.
          </p>
          <p class="text-gray-700">
            Parking options include both free and paid facilities. Please verify parking details on the official
            race website closer to race day.
          </p>
        </div>

        <!-- Past Results -->
        <div class="mb-8">
          <h3 class="text-3xl font-bold mb-6">Results</h3>
          <p class="text-gray-700 mb-4">
            Complete race results from 2017-2025 are available online.
          </p>
          <a
            href="https://myrunresults.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
          >
            View Past Results
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsors Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-4">Our Sponsors</h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        The Omagh Half Marathon is made possible by the generous support of our sponsors and partners.
      </p>
      <div class="text-center">
        <p class="text-gray-700 mb-4"><strong>Major Sponsors Include:</strong></p>
        <div class="flex flex-wrap justify-center gap-4 text-lg text-gray-700">
          <span class="px-4 py-2 bg-white rounded-lg font-semibold">SPAR NI</span>
          <span class="px-4 py-2 bg-white rounded-lg font-semibold">Silverbirch Hotel</span>
          <span class="px-4 py-2 bg-white rounded-lg font-semibold">Bradley's Pharmacy</span>
          <span class="px-4 py-2 bg-white rounded-lg font-semibold">& Many Local Businesses</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Charity Partner -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Charity Partner</h2>
      <p class="text-gray-700 text-lg">
        <strong>2025 Official Charity Partner:</strong> Care for Cancer
      </p>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-black to-gray-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to Take on the Challenge?
      </h2>
      <p class="text-xl text-gray-300 mb-8">
        Visit the official race website for complete information, registration, and race day details.
      </p>
      <a
        href="https://omaghhalfmarathon.run/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-amber text-black px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-400 transition-colors"
      >
        Visit Omagh Half Marathon Website
      </a>
    </div>
  </section>
</Layout>
