---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Juniors - Omagh Harriers AC"
  description="Information about junior athletics at Omagh Harriers AC"
>
  <!-- Hero Section -->
  <section class="relative h-[280px] sm:h-[400px] md:h-[600px] flex items-center justify-center">
    <img
      src="/aerial-shot.jpg"
      alt="Aerial view of Omagh Harriers running community"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/10"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <div class="mb-8">
        <svg class="w-24 h-24 mx-auto text-amber opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
      </div>
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">
        Juniors Section
      </h1>
      <p class="text-2xl md:text-3xl text-amber mb-8 font-semibold">
        Coming Soon!
      </p>
      <div class="bg-white/95 backdrop-blur rounded-lg p-8 max-w-2xl mx-auto hidden md:block">
        <p class="text-lg text-gray-800 mb-6">
          We're currently building a dedicated section for our junior athletes. This page will feature
          information about junior training sessions, events, and opportunities for young runners.
        </p>
        <p class="text-gray-700">
          Check back soon for updates, or contact the club directly for information about junior athletics.
        </p>
      </div>
    </div>
  </section>

  <!-- Coming Soon Notice for Desktop -->
  <section class="py-12 bg-amber/10 border-y border-amber block md:hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white/95 backdrop-blur rounded-lg p-8 max-w-2xl mx-auto">
        <p class="text-lg text-gray-800 mb-6">
          We're currently building a dedicated section for our junior athletes. This page will feature
          information about junior training sessions, events, and opportunities for young runners.
        </p>
        <p class="text-gray-700">
          Check back soon for updates, or contact the club directly for information about junior athletics.
        </p>
      </div>
    </div>
  </section>

  <!-- Junior Info Section -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold mb-6">Junior Athletics</h2>
          <p class="text-gray-700 mb-4">
            Omagh Harriers AC is committed to developing young athletes and fostering a love of running
            from an early age.
          </p>
          <p class="text-gray-700 mb-6">
            Our junior section provides coaching and training opportunities for young runners, helping them
            develop their skills in a fun, supportive environment.
          </p>
          <div class="bg-amber/10 border border-amber rounded-lg p-6">
            <h3 class="font-bold text-lg mb-2">Training Information</h3>
            <p class="text-gray-700 mb-3">
              <strong>Days:</strong> Monday & Thursday
            </p>
            <p class="text-gray-700 mb-3">
              <strong>Location:</strong> Omagh Leisure Complex
            </p>
            <p class="text-sm text-gray-600">
              Contact the club for specific times and age group details.
            </p>
          </div>
        </div>

        <div class="bg-gradient-to-br from-black to-gray-800 rounded-lg p-8 text-white">
          <h3 class="text-2xl font-bold mb-6 text-amber">What We Offer</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Qualified coaches experienced in youth athletics</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Age-appropriate training programs</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Track and field activities</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Safe, inclusive environment</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Opportunities to compete locally & nationally</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Safeguarding Notice -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-lg p-8 border-l-4 border-amber">
        <h3 class="text-2xl font-bold mb-4">Child Safety & Safeguarding</h3>
        <p class="text-gray-700 mb-4">
          Omagh Harriers AC is fully committed to safeguarding the welfare of all young athletes.
          We follow strict safeguarding policies in line with Athletics NI guidelines.
        </p>
        <a
          href="/policies"
          class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
        >
          View Our Safeguarding Policy
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-6">Interested in Junior Athletics?</h2>
      <p class="text-gray-700 text-lg mb-8 max-w-2xl mx-auto">
        For more information about our junior section, training times, and how to get involved,
        please get in touch with the club.
      </p>
      <a
        href="mailto:info@omaghharriers.com"
        class="inline-block bg-black text-white px-8 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors"
      >
        Contact Us
      </a>
    </div>
  </section>
</Layout>
