---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Club Policies - Omagh Harriers AC"
  description="Club policies, constitution, codes of conduct, and governance documents for Omagh Harriers AC"
>
  <div class="bg-gradient-to-r from-black to-gray-900 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Club Policies</h1>
      <p class="text-xl text-gray-300">
        Our governance documents and codes of conduct
      </p>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <p class="text-gray-700 mb-12">
          Omagh Harriers AC is committed to providing a safe, inclusive, and supportive environment for all members.
          Our policies and procedures ensure we maintain the highest standards of governance and member welfare.
        </p>

        <div class="grid gap-8">
          <!-- Club Constitution -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Club Constitution</h2>
            <p class="text-gray-700 mb-4">
              Our constitution sets out the rules and regulations that govern how Omagh Harriers AC operates,
              including membership, committee structure, and club objectives.
            </p>
            <a
              href="https://omaghharriers.wordpress.com/club-constitution/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
            >
              Read Constitution
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Committee & Coaches -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Committee & Coaches</h2>
            <p class="text-gray-700 mb-4">
              Information about our club committee members and qualified coaches who lead training sessions
              and support club activities.
            </p>
            <a
              href="https://omaghharriers.wordpress.com/committee-coaches/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
            >
              View Committee & Coaches
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Communication & Respect -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Communication & Respect</h2>
            <p class="text-gray-700 mb-4">
              Our policy on respectful communication within the club, covering interactions between members,
              coaches, and committee.
            </p>
            <a
              href="https://omaghharriers.wordpress.com/communication-respect/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
            >
              Read Policy
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Committee Code of Conduct -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Committee Code of Conduct</h2>
            <p class="text-gray-700 mb-4">
              Ethical guidelines and standards of behavior expected of all committee members in their roles.
            </p>
            <a
              href="https://omaghharriers.wordpress.com/committee-code-of-conduct/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
            >
              Read Code of Conduct
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Safeguarding & Digital Media -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Safeguarding & Digital Media</h2>
            <p class="text-gray-700 mb-4">
              Our safeguarding policies and guidelines for the appropriate use of photos, videos, and digital media
              involving club members.
            </p>
            <a
              href="https://omaghharriers.wordpress.com/safeguarding-photo-video-use/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
            >
              Read Safeguarding Policy
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Annual AGM Process -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Annual AGM Process</h2>
            <p class="text-gray-700 mb-4">
              Information about our Annual General Meeting, including procedures, member participation, and governance.
            </p>
            <a
              href="https://omaghharriers.wordpress.com/annual-agm-process/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
            >
              View AGM Process
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Other Policies & Documents -->
          <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-amber">
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Other Policies & Documents</h2>
            <p class="text-gray-700 mb-4">
              Additional club policies, forms, and documents relevant to members.
            </p>
            <a
              href="https://omaghharriers.wordpress.com/other-documents-policies/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-black font-semibold hover:text-amber transition-colors"
            >
              View Other Documents
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Athletics NI Affiliation -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold mb-4">Fully Registered & Affiliated</h2>
      <p class="text-gray-700 mb-6">
        Omagh Harriers AC is fully registered and affiliated with Athletics Northern Ireland.
      </p>
      <a
        href="https://athleticsni.org/Clubs"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-black text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors"
      >
        Visit Athletics NI
      </a>
    </div>
  </section>
</Layout>
