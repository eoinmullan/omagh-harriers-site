---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Coaching Courses & Funding - Omagh Harriers AC"
  description="Funding for Coaching Courses"
>
  <div class="bg-gradient-to-r from-black to-gray-900 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a
          href="/policies"
          class="inline-flex items-center text-amber hover:text-yellow-400 transition-colors mb-4"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Policies
        </a>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Coaching Courses & Funding</h1>
      <p class="text-xl text-gray-300">
        Funding for Coaching Courses
      </p>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <!-- Purpose -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900">Purpose</h3>
          <p class="text-gray-700 mb-6">To support club members in pursuing coaching qualifications that enhance the development of Omagh Harriers A.C., while ensuring accountability and commitment to the club.</p>
        </div>

        <!-- Eligibility Criteria -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900">Eligibility Criteria</h3>
          <ol class="list-decimal pl-6 space-y-4 text-gray-700">
            <li><strong>Membership Requirement</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Applicants must be current, fully paid-up members of Omagh Harriers A.C. at the time of application.</li>
              </ul>
            </li>
            <li><strong>Commitment to Club</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Members must demonstrate ongoing contribution to the club, such as coaching or volunteering, following course completion.</li>
                <li>As a prerequisite to the club paying for a member to avail of a coaching qualification, the said member is required to contribute to club coaching as reasonably requested for at least a period of twelve months following completion of the course.</li>
              </ul>
            </li>
          </ol>
        </div>

        <!-- Application and Approval Process -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900">Application and Approval Process</h3>
          <ol class="list-decimal pl-6 space-y-4 text-gray-700">
            <li><strong>Application Submission</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>Members must submit a written application to the committee detailing the course name, date, cost, and how the qualification will benefit the club.</li>
                <li>Applications should be sent at least four weeks before the course start date.</li>
              </ul>
            </li>
            <li><strong>Committee Approval</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>The committee will review the application and notify the applicant of the decision within two weeks of submission. Approval will be based on:
                  <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                    <li>Relevance of the course to the club&rsquo;s needs.</li>
                    <li>Availability of club funds.</li>
                    <li>Applicant&rsquo;s contribution to the club.</li>
                    <li>The discretion of the Committee in all respects whose decision shall be final.</li>
                  </ul>
                </li>
              </ul>
            </li>
            <li><strong>Registration and Payment</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li>The applicant is responsible for registering and paying the full course fee.</li>
              </ul>
            </li>
            <li><strong>Reimbursement Procedure</strong>:
              <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                <li><strong>First Reimbursement</strong>:
                  <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                    <li>50% of the course fee will be reimbursed upon successful completion of the course.</li>
                    <li>Proof of course completion (e.g. certificate) must be submitted to the committee.</li>
                  </ul>
                </li>
                <li><strong>Second Reimbursement</strong>:
                  <ul class="list-disc pl-6 space-y-2 text-gray-700 mt-2">
                    <li>The remaining 50% will be reimbursed following a period of six months.</li>
                  </ul>
                </li>
              </ul>
            </li>
          </ol>
        </div>

        <!-- General Rules -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900">General Rules</h3>
          <ol class="list-decimal pl-6 space-y-2 text-gray-700">
            <li>Reimbursement is conditional on the member using their qualification to benefit Omagh Harriers A.C. (e.g. coaching club sessions).</li>
            <li>Members who do not renew their membership or fail to actively contribute may forfeit their second reimbursement.</li>
            <li>Funding is limited and subject to the club&rsquo;s annual budget. Approval is not guaranteed for all applications.</li>
            <li>From time to time it may be in the interests of the club to prioritise funding to meet an immediate need and in this case, this policy shall not apply and shall be at the discretion of the committee.</li>
            <li>Any disputes regarding this policy will be addressed by the club committee, whose decision is final.</li>
          </ol>
          <p class="text-gray-700 mt-6 mb-6"><strong>Approved by</strong>: Omagh Harriers A.C. Committee<br /><strong>Date</strong>: December 2024</p>
        </div>

        <!-- Logo -->
        <div class="mt-12 text-center">
          <figure><img
              src="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-11.png?w=408"
              sizes="(max-width: 408px) 100vw, 408px"
              srcset="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-11.png 408w, https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-11.png?w=150 150w, https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-11.png?w=300 300w"
              alt="" width="408" height="160"
          /></figure>
        </div>
      </div>
    </div>
  </section>
</Layout>
