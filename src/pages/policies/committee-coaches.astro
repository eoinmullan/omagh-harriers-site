---
import Layout from '../../layouts/Layout.astro';
---

<Layout
    title="Committee & Coaches - Omagh Harriers AC"
    description="Committee Members 2026 (as elected at the AGM on 26th November 2025)"
>
  <div class="bg-gradient-to-r from-black to-gray-900 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a
            href="/policies"
            class="inline-flex items-center text-amber hover:text-yellow-400 transition-colors mb-4"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Policies
        </a>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Committee & Coaches</h1>
      <p class="text-xl text-gray-300">
        Committee Members 2026 (as elected at the AGM on 26th November 2025)
      </p>
    </div>
  </div>

  <section class="py-8 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <!-- Logo -->
        <div class="py-8 text-center">
          <img src="/omagh-harriers_black.png" alt="Omagh Harriers AC Logo" width="408" height="160" class="mx-auto" />
        </div>

        <!-- Article 1 -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Chairperson</strong></h3>
          <p class="text-gray-700 mb-3">Richard Duffy</p>
        </div>

        <!-- Committee Members 2026 -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Vice Chairperson</strong></h3>
          <p class="text-gray-700 mb-3">Martin McIvor</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Secretary</strong></h3>
          <p class="text-gray-700 mb-3">Patricia Campbell</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Treasurer</strong></h3>
          <p class="text-gray-700 mb-3">Bernie Liggett</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Public Relations Officer</strong></h3>
          <p class="text-gray-700 mb-3">Peter Gormley</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Safeguarding Officer (Female)</strong></h3>
          <p class="text-gray-700 mb-3">Roisin McCullagh</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Safeguarding Officer (Male)</strong></h3>
          <p class="text-gray-700 mb-3">Martin McIvor</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Club Captain (Male)</strong></h3>
          <p class="text-gray-700 mb-3">Darrell Brogan</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Club Captain (Female)</strong></h3>
          <p class="text-gray-700 mb-3">Elaine Kerlin</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Events Coordinator</strong></h3>
          <p class="text-gray-700 mb-3"><em><strong>tba</strong> by the 2026 Committee</em></p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Junior Development Officer</strong></h3>
          <p class="text-gray-700 mb-3">Andrew Ferguson</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Half Marathon Committee Rep (Honorary Member)</strong></h3>
          <p class="text-gray-700 mb-3">Michael Ward</p>
        </div>

        <!-- Committee Members -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Committee Members</strong></h3>
          <p class="text-gray-700 mb-3">Andy Funnell, Martin McLaughlin, Niall Heaney, Ryan Devlin, Eoin Mullan, Una Corrigan (<em>Junior Representative</em>)</p>
        </div>

        <!-- Coaches -->
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Head Coach</strong></h3>
          <p class="text-gray-700 mb-3">Sean Donnelly</p>
        </div>

        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-3 text-gray-900"><strong>Junior Coaches</strong></h3>
          <p class="text-gray-700 mb-3">Stephen Duncan, Ryan Pritchard, Mark McConnell, Rob Gilchrist, Tanya Kelly, Ciara Woods, Aidan Borchers, Paul Barbour</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
