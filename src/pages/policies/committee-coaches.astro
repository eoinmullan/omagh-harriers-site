---
import Layout from '../../layouts/Layout.astro';
---

<Layout
    title="Committee & Coaches - Omagh Harriers AC"
    description="Meet the committee members and coaching staff of Omagh Harriers Athletic Club"
>
  <div class="bg-gradient-to-r from-black to-gray-900 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a
            href="/policies"
            class="inline-flex items-center text-amber hover:text-yellow-400 transition-colors mb-4"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Policies
        </a>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Committee & Coaches</h1>
      <p class="text-xl text-gray-300">
        Our dedicated team leading Omagh Harriers AC
      </p>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <!-- Committee Members 2026 -->
        <div class="mb-12">
          <p class="text-gray-700 mb-6"><strong>Committee Members 2026</strong> <em>(as elected at the AGM on 26th
            November 2025)</em></p>
          <figure>
            <table class="min-w-full divide-y divide-gray-200 border border-gray-200">
              <tbody class="bg-white divide-y divide-gray-200">
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Chairperson :</strong>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Richard Duffy</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Vice Chairperson
                  :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Martin McIvor</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Secretary :</strong>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Patricia Campbell</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Treasurer :</strong>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Bernie Liggett</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Public Relations
                  Officer :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Peter Gormley</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Safeguarding Officer
                  (Female) :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Roisin McCullagh</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Safeguarding Officer
                  (Male) :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Martin McIvor</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Club Captain (Male)
                  :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Darrell Brogan</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Club Captain (Female)
                  :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Elaine Kerlin</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Events Coordinator
                  :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><em><strong>tba</strong> by the 2026
                  Committee</em></td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Junior Development
                  Officer :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Andrew Ferguson</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><strong>Half Marathon
                  Committee Rep (Honorary Member) :</strong></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">Michael Ward</td>
              </tr>
              </tbody>
            </table>
          </figure>
        </div>

        <!-- Committee Members -->
        <div class="mb-12">
          <p class="text-gray-700 mb-2"><strong>Committee Members :</strong></p>
          <p class="text-gray-700 mb-6">Andy Funnell, Martin McLaughlin, Niall Heaney, Ryan Devlin, Eoin Mullan, Una Corrigan
            (<em>Junior Representative</em>)</p>
        </div>

        <!-- Coaches -->
        <div class="mb-12">
          <p class="text-gray-700 mb-2"><strong>Coaches :</strong></p>
          <p class="text-gray-700 mb-2">Head Coach : Sean Donnelly</p>
          <p class="text-gray-700 mb-6">Junior Coaches : Stephen Duncan, Ryan Pritchard, Mark McConnell, Rob Gilchrist, Tanya
            Kelly, Ciara Woods, Aidan Borchers, Paul Barbour</p>
        </div>

        <!-- Logo -->
        <div class="mt-12 text-center">
          <figure><img
              src="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=408"
              sizes="(max-width: 408px) 100vw, 408px"
              srcset="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png 408w, https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=150 150w, https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=300 300w"
              alt="" width="408" height="160" data-attachment-id="89"
              data-permalink="https://omaghharriers.wordpress.com/committee-coaches/omagh-harriers_black-11/"
              data-orig-file="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png"
              data-orig-size="408,160" data-comments-opened="0"
              data-image-meta="{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}"
              data-image-title="Omagh Harriers_black" data-image-description="" data-image-caption=""
              data-medium-file="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=300"
              data-large-file="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=408"/>
          </figure>
        </div>
      </div>
    </div>
  </section>
</Layout>
