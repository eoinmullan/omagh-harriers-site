---
import Layout from '../../layouts/Layout.astro';
---

<Layout
    title="Committee & Coaches - Omagh Harriers AC"
    description="Committee Members 2026 (as elected at the AGM on 26th November 2025)"
>
  <div class="bg-gradient-to-r from-black to-gray-900 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a
            href="/policies"
            class="inline-flex items-center text-amber hover:text-yellow-400 transition-colors mb-4"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Policies
        </a>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Committee & Coaches</h1>
      <p class="text-xl text-gray-300">
        Committee Members 2026 (as elected at the AGM on 26th November 2025)
      </p>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <!-- Committee Members 2026 -->
        <div class="mb-12">
          <p class="text-gray-700 mb-3"><strong>Chairperson :</strong> Richard Duffy</p>
          <p class="text-gray-700 mb-3"><strong>Vice Chairperson :</strong> Martin McIvor</p>
          <p class="text-gray-700 mb-3"><strong>Secretary :</strong> Patricia Campbell</p>
          <p class="text-gray-700 mb-3"><strong>Treasurer :</strong> Bernie Liggett</p>
          <p class="text-gray-700 mb-3"><strong>Public Relations Officer :</strong> Peter Gormley</p>
          <p class="text-gray-700 mb-3"><strong>Safeguarding Officer (Female) :</strong> Roisin McCullagh</p>
          <p class="text-gray-700 mb-3"><strong>Safeguarding Officer (Male) :</strong> Martin McIvor</p>
          <p class="text-gray-700 mb-3"><strong>Club Captain (Male) :</strong> Darrell Brogan</p>
          <p class="text-gray-700 mb-3"><strong>Club Captain (Female) :</strong> Elaine Kerlin</p>
          <p class="text-gray-700 mb-3"><strong>Events Coordinator :</strong> <em><strong>tba</strong> by the 2026
            Committee</em></p>
          <p class="text-gray-700 mb-3"><strong>Junior Development Officer :</strong> Andrew Ferguson</p>
          <p class="text-gray-700 mb-3"><strong>Half Marathon Committee Rep (Honorary Member) :</strong> Michael Ward
          </p>

          <!-- Committee Members -->
          <p class="text-gray-700 mb-3"><strong>Committee Members :</strong> Andy Funnell, Martin McLaughlin, Niall
            Heaney, Ryan Devlin, Eoin Mullan, Una Corrigan
            (<em>Junior Representative</em>)</p>

          <!-- Coaches -->
          <p class="text-gray-700 mb-3"><strong>Head Coach :</strong> Sean Donnelly</p>
          <p class="text-gray-700 mb-3"><strong>Junior Coaches :</strong> Stephen Duncan, Ryan Pritchard, Mark
            McConnell, Rob Gilchrist, Tanya
            Kelly, Ciara Woods, Aidan Borchers, Paul Barbour</p>
        </div>

        <!-- Logo -->
        <div class="mt-12 text-center">
          <figure><img
              src="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=408"
              sizes="(max-width: 408px) 100vw, 408px"
              srcset="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png 408w, https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=150 150w, https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=300 300w"
              alt="" width="408" height="160" data-attachment-id="89"
              data-permalink="https://omaghharriers.wordpress.com/committee-coaches/omagh-harriers_black-11/"
              data-orig-file="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png"
              data-orig-size="408,160" data-comments-opened="0"
              data-image-meta="{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}"
              data-image-title="Omagh Harriers_black" data-image-description="" data-image-caption=""
              data-medium-file="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=300"
              data-large-file="https://omaghharriers.wordpress.com/wp-content/uploads/2024/12/omagh-harriers_black-1.png?w=408"/>
          </figure>
        </div>
      </div>
    </div>
  </section>
</Layout>
